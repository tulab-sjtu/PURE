<!-- BEGIN_EMBEDDED_FILE path="runtime/bootstrap_environment.py" sha256="f1eca5c3442cadf310cc701511621b5257f9bacbb7327a19dc8a32cd39c779ce" -->
~~~~python
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
from pathlib import Path

ENV_NAME = "scPURE_agent"


def run(command: list[str], log_path: Path, *, check: bool = True) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(command, capture_output=True, text=True)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log_path.write_text(
        f"$ {' '.join(command)}\n\nSTDOUT\n{proc.stdout}\n\nSTDERR\n{proc.stderr}\n",
        encoding="utf-8",
    )
    if check and proc.returncode != 0:
        raise RuntimeError(f"Command failed: {' '.join(command)}\n{proc.stderr[-4000:]}")
    return proc


def env_exists(manager: str, name: str) -> bool:
    proc = subprocess.run([manager, "env", "list", "--json"], capture_output=True, text=True)
    if proc.returncode != 0:
        return False
    data = json.loads(proc.stdout)
    return any(Path(path).name == name for path in data.get("envs", []))


def write_json(path: Path, payload: dict[str, object]) -> None:
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def configure_optional_pyclusterprofiler(manager: str, runtime: Path, skip: bool) -> None:
    status_path = runtime / "pyclusterprofiler_status.json"
    status: dict[str, object] = {
        "environment": ENV_NAME,
        "requested": not skip,
        "required_for_core_workflow": False,
        "fallback": "embedded_local_GO_BP_ORA_plus_Wang",
    }
    if skip:
        status.update({"available": False, "status": "skipped_by_user"})
        write_json(status_path, status)
        return

    requirements = runtime / "requirements-pyclusterprofiler-optional.txt"
    if not requirements.is_file():
        status.update({"available": False, "status": "fallback", "reason": f"Missing {requirements.name}"})
        write_json(status_path, status)
        return

    install = run(
        [manager, "run", "-n", ENV_NAME, "python", "-m", "pip", "install", "--no-deps", "--require-hashes", "-r", str(requirements)],
        runtime / "bootstrap_pyclusterprofiler_install.log",
        check=False,
    )
    if install.returncode != 0:
        status.update({"available": False, "status": "fallback", "reason": "hash-verified package installation failed"})
        write_json(status_path, status)
        return

    smoke_code = (
        "import importlib.metadata as m; "
        "import sharepathway; import pyclusterprofiler; "
        "assert m.version('pyclusterprofiler') == '0.1.dev14'; "
        "print('pyclusterprofiler 0.1.dev14 and sharepathway import OK')"
    )
    smoke = run(
        [manager, "run", "-n", ENV_NAME, "python", "-c", smoke_code],
        runtime / "bootstrap_pyclusterprofiler_smoke.log",
        check=False,
    )
    if smoke.returncode == 0:
        status.update({"available": True, "status": "ready", "version": "0.1.dev14"})
    else:
        # pyclusterprofiler imports sharepathway at module import time. The historic
        # sharepathway dependency is not allowed to force a second environment or
        # downgrade the pinned scientific stack. Remove the unusable package and
        # retain the deterministic embedded GO implementation.
        run(
            [manager, "run", "-n", ENV_NAME, "python", "-m", "pip", "uninstall", "-y", "pyclusterprofiler"],
            runtime / "bootstrap_pyclusterprofiler_cleanup.log",
            check=False,
        )
        reason = (smoke.stderr or smoke.stdout).strip()[-2000:]
        status.update({"available": False, "status": "fallback", "reason": reason or "dependency import smoke test failed"})
    write_json(status_path, status)


def main() -> None:
    parser = argparse.ArgumentParser(description="Materialized scPURE single-environment bootstrapper")
    parser.add_argument("--runtime-dir", required=True)
    parser.add_argument("--rebuild", action="store_true")
    parser.add_argument("--skip-pyclusterprofiler", action="store_true")
    args = parser.parse_args()
    runtime = Path(args.runtime_dir).expanduser().resolve()
    manager = next((name for name in ["micromamba", "mamba", "conda"] if shutil.which(name)), None)
    if manager is None:
        raise RuntimeError("micromamba, mamba, or conda is required. micromamba is preferred.")

    environment_file = runtime / "environment-main.yml"
    if not environment_file.is_file():
        raise FileNotFoundError(environment_file)
    exists = env_exists(manager, ENV_NAME)
    if exists and args.rebuild:
        run([manager, "env", "remove", "-y", "-n", ENV_NAME], runtime / "bootstrap_remove_scPURE_agent.log")
        exists = False
    if not exists:
        run([manager, "env", "create", "-y", "-f", str(environment_file)], runtime / "bootstrap_create_scPURE_agent.log")

    run(
        [manager, "run", "-n", ENV_NAME, "python", "-m", "py_compile", str(runtime / "scpure_runtime.py"), str(runtime / "pyclusterprofiler_runner.py"), str(runtime / "bootstrap_environment.py")],
        runtime / "bootstrap_python_compile.log",
    )
    run(
        [manager, "run", "-n", ENV_NAME, "python", "-m", "unittest", "discover", "-s", str(runtime / "tests"), "-v"],
        runtime / "bootstrap_unit_tests.log",
    )
    run(
        [manager, "run", "-n", ENV_NAME, "python", str(runtime / "scpure_runtime.py"), "--help"],
        runtime / "bootstrap_main_smoke.log",
    )

    r_code = (
        'stopifnot(as.character(getRversion())=="4.4.3"); '
        'stopifnot(as.character(packageVersion("Seurat"))=="5.2.1"); '
        'stopifnot(as.character(packageVersion("DESeq2"))=="1.46.0"); '
        f'parse(file="{runtime / "extract_seurat.R"}"); '
        f'parse(file="{runtime / "run_r_deseq2.R"}"); '
        'cat("R, Seurat, and DESeq2 are available inside scPURE_agent\n")'
    )
    run([manager, "run", "-n", ENV_NAME, "Rscript", "-e", r_code], runtime / "bootstrap_r_smoke.log")

    configure_optional_pyclusterprofiler(manager, runtime, args.skip_pyclusterprofiler)

    lock_dir = runtime / "environment_lock"
    lock_dir.mkdir(parents=True, exist_ok=True)
    proc = run([manager, "list", "-n", ENV_NAME, "--explicit"], runtime / "bootstrap_lock_scPURE_agent.log")
    (lock_dir / "scPURE_agent.explicit.txt").write_text(proc.stdout, encoding="utf-8")
    print("The single scPURE_agent environment is ready; explicit package lock and GO backend status were written.")


if __name__ == "__main__":
    main()
~~~~
<!-- END_EMBEDDED_FILE path="runtime/bootstrap_environment.py" -->
<!-- BEGIN_EMBEDDED_FILE path="runtime/extract_seurat.R" sha256="63a90dd062787295ce723a611557240f343b2ccac189d74165a2c2b844c5c1d0" -->
~~~~r
suppressPackageStartupMessages({
  library(Seurat)
  library(Matrix)
  library(data.table)
  library(jsonlite)
})

args <- commandArgs(trailingOnly = TRUE)
if (length(args) != 4) {
  stop("Usage: Rscript extract_seurat.R <input.rds> <assay> <layer> <output_dir>")
}
input_rds <- normalizePath(args[[1]], mustWork = TRUE)
assay_name <- args[[2]]
layer_name <- args[[3]]
out_dir <- args[[4]]
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
obj <- readRDS(input_rds)
if (!inherits(obj, "Seurat")) {
  stop(sprintf("RDS object must inherit from Seurat; detected classes: %s", paste(class(obj), collapse = ", ")))
}
if (!(assay_name %in% Assays(obj))) {
  stop(sprintf("Assay '%s' not found. Available assays: %s", assay_name, paste(Assays(obj), collapse = ", ")))
}
DefaultAssay(obj) <- assay_name
assay_obj <- obj[[assay_name]]
available_layers <- tryCatch(Layers(assay_obj), error = function(e) character())
if (length(available_layers) > 0 && !(layer_name %in% available_layers)) {
  stop(sprintf("Layer '%s' not found in assay '%s'. Available layers: %s", layer_name, assay_name, paste(available_layers, collapse = ", ")))
}
counts <- tryCatch(
  GetAssayData(obj, assay = assay_name, layer = layer_name),
  error = function(e) GetAssayData(obj, assay = assay_name, slot = layer_name)
)
if (!inherits(counts, "sparseMatrix")) counts <- as(counts, "dgCMatrix")
if (any(counts@x < 0)) stop("Raw counts contain negative values")
if (any(abs(counts@x - round(counts@x)) > 1e-8)) stop("Selected layer is not integer-like raw counts")
metadata <- obj[[]]
if (!identical(colnames(counts), rownames(metadata))) {
  metadata <- metadata[colnames(counts), , drop = FALSE]
}
Matrix::writeMM(counts, file.path(out_dir, "counts.mtx"))
fwrite(data.table(gene_id = rownames(counts)), file.path(out_dir, "genes.tsv"), sep = "\t")
fwrite(data.table(cell_id = colnames(counts)), file.path(out_dir, "cells.tsv"), sep = "\t")
metadata_out <- as.data.table(metadata, keep.rownames = "cell_id")
fwrite(metadata_out, file.path(out_dir, "metadata.tsv"), sep = "\t", quote = TRUE)
summary <- list(
  input_rds = input_rds,
  object_class = class(obj),
  assay = assay_name,
  layer = layer_name,
  available_assays = Assays(obj),
  available_layers = available_layers,
  n_genes = nrow(counts),
  n_cells = ncol(counts),
  seurat_version = as.character(packageVersion("Seurat")),
  seuratobject_version = as.character(packageVersion("SeuratObject")),
  matrix_version = as.character(packageVersion("Matrix"))
)
write_json(summary, file.path(out_dir, "seurat_export_summary.json"), pretty = TRUE, auto_unbox = TRUE)
~~~~
<!-- END_EMBEDDED_FILE path="runtime/extract_seurat.R" -->
<!-- BEGIN_EMBEDDED_FILE path="runtime/run_r_deseq2.R" sha256="2e03f3d7bc158d6f6cc603520e7f9ea8dfbfda0d1a66bfc3d09bd24447088605" -->
~~~~r
suppressPackageStartupMessages({
  library(DESeq2)
  library(data.table)
  library(jsonlite)
})

args <- commandArgs(trailingOnly = TRUE)
if (!(length(args) %in% c(7, 8))) {
  stop("Usage: Rscript run_r_deseq2.R <counts.csv> <metadata.csv> <design> <condition_col> <focal> <reference> <out.csv> [threads]")
}
counts_path <- normalizePath(args[[1]], mustWork = TRUE)
meta_path <- normalizePath(args[[2]], mustWork = TRUE)
design_string <- args[[3]]
condition_col <- args[[4]]
focal <- args[[5]]
reference <- args[[6]]
out_path <- args[[7]]
threads <- if (length(args) == 8) as.integer(args[[8]]) else 1L
if (is.na(threads) || threads < 1L) stop("threads must be a positive integer")
Sys.setenv(OMP_NUM_THREADS = threads, OPENBLAS_NUM_THREADS = threads, MKL_NUM_THREADS = threads, NUMEXPR_NUM_THREADS = threads)
counts_dt <- fread(counts_path)
if (!("sample_id" %in% names(counts_dt))) stop("counts.csv must contain sample_id")
sample_ids <- counts_dt$sample_id
counts_dt[, sample_id := NULL]
counts_mat <- as.matrix(counts_dt)
rownames(counts_mat) <- sample_ids
storage.mode(counts_mat) <- "numeric"
if (any(!is.finite(counts_mat))) stop("Counts contain non-finite values")
if (any(counts_mat < 0)) stop("Counts contain negative values")
if (any(abs(counts_mat - round(counts_mat)) > 1e-8)) stop("Counts are not integer-like")
storage.mode(counts_mat) <- "integer"
meta <- as.data.frame(fread(meta_path))
if (!("sample_id" %in% colnames(meta))) stop("metadata.csv must contain sample_id")
rownames(meta) <- meta$sample_id
meta <- meta[sample_ids, , drop = FALSE]
if (!(condition_col %in% colnames(meta))) stop(sprintf("Condition column '%s' not found", condition_col))
meta[[condition_col]] <- factor(meta[[condition_col]])
if (!(reference %in% levels(meta[[condition_col]]))) stop("Reference level absent")
if (!(focal %in% levels(meta[[condition_col]]))) stop("Focal level absent")
meta[[condition_col]] <- relevel(meta[[condition_col]], ref = reference)
design_formula <- as.formula(design_string)
dds <- DESeqDataSetFromMatrix(countData = t(counts_mat), colData = meta, design = design_formula)
if (threads > 1L) {
  bp <- BiocParallel::SnowParam(workers = threads, type = "SOCK", progressbar = FALSE)
  dds <- DESeq(dds, quiet = TRUE, parallel = TRUE, BPPARAM = bp)
} else {
  dds <- DESeq(dds, quiet = TRUE)
}
res <- results(dds, contrast = c(condition_col, focal, reference), independentFiltering = TRUE)
res_df <- as.data.frame(res)
res_df$gene_id <- rownames(res_df)
res_df <- res_df[, c("gene_id", setdiff(colnames(res_df), "gene_id"))]
fwrite(res_df, out_path)
meta_out <- list(
  backend = "R_DESeq2",
  R_version = R.version.string,
  DESeq2_version = as.character(packageVersion("DESeq2")),
  design = design_string,
  condition_col = condition_col,
  focal = focal,
  reference = reference,
  threads = threads
)
write_json(meta_out, paste0(out_path, ".metadata.json"), pretty = TRUE, auto_unbox = TRUE)
~~~~
<!-- END_EMBEDDED_FILE path="runtime/run_r_deseq2.R" -->
<!-- BEGIN_EMBEDDED_FILE path="runtime/pyclusterprofiler_runner.py" sha256="81675c7cde14603726c367dcd6fb06437e7f189ccd7134d89cff29daaadeff36" -->
~~~~python
from __future__ import annotations

import argparse
import importlib.metadata
from pathlib import Path

import pandas as pd


def main() -> None:
    parser = argparse.ArgumentParser(description="Optional pyclusterprofiler GO-BP supplement")
    parser.add_argument("--input", required=True)
    parser.add_argument("--taxid", required=True, type=int)
    parser.add_argument("--output", required=True)
    args = parser.parse_args()

    import pyclusterprofiler

    if importlib.metadata.version("pyclusterprofiler") != "0.1.dev14":
        raise RuntimeError("pyclusterprofiler 0.1.dev14 is required")
    frame = pd.read_csv(args.input)
    required = {"gene_id", "cluster"}
    if not required.issubset(frame.columns):
        raise ValueError(f"Input must contain {sorted(required)}")
    result = pyclusterprofiler.compare_clusters(
        frame[["gene_id", "cluster"]].copy(),
        "cluster",
        organism=args.taxid,
        database="GO",
        exclude=["MF", "CC"],
        correction="fdr_bh",
        verbose=True,
    )
    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    result.to_csv(output, index=False)


if __name__ == "__main__":
    main()
~~~~
