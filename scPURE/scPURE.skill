_ACTIVE_GENE_SYMBOLS: dict[str, str] = {}
_ACTIVE_SYMBOL_COUNTS: dict[str, int] = {}


def set_active_annotation(annotation: pd.DataFrame | None) -> None:
    """Set the run-wide ID-to-symbol mapping used by human-facing outputs.

    Canonical IDs are never removed from CSVs. A unique non-empty symbol is the
    primary display label. Duplicate symbols are disambiguated as
    ``symbol_geneID``; missing symbols fall back to the canonical gene ID.
    """
    global _ACTIVE_GENE_SYMBOLS, _ACTIVE_SYMBOL_COUNTS
    _ACTIVE_GENE_SYMBOLS = {}
    _ACTIVE_SYMBOL_COUNTS = {}
    if annotation is None or annotation.empty or "gene_id" not in annotation.columns:
        return
    frame = annotation.copy()
    if "symbol" not in frame.columns:
        frame["symbol"] = ""
    frame["gene_id"] = frame["gene_id"].fillna("").astype(str).str.strip()
    frame["symbol"] = frame["symbol"].fillna("").astype(str).str.strip()
    frame = frame[(frame["gene_id"] != "") & (~frame["gene_id"].str.lower().eq("nan"))]
    for row in frame.itertuples(index=False):
        gene_id = str(row.gene_id).strip()
        symbol = str(row.symbol).strip()
        if symbol and symbol.lower() != "nan":
            _ACTIVE_GENE_SYMBOLS[gene_id] = symbol
    for symbol in _ACTIVE_GENE_SYMBOLS.values():
        _ACTIVE_SYMBOL_COUNTS[symbol] = _ACTIVE_SYMBOL_COUNTS.get(symbol, 0) + 1


def symbol_for_gene(gene_id: Any, annotation_map: Mapping[str, str] | None = None) -> str:
    gene = "" if pd.isna(gene_id) else str(gene_id).strip()
    source = annotation_map if annotation_map is not None else _ACTIVE_GENE_SYMBOLS
    symbol = str(source.get(gene, "")).strip() if source else ""
    return "" if not symbol or symbol.lower() == "nan" else symbol


def display_gene_label(gene_id: Any, annotation_map: Mapping[str, str] | None = None) -> str:
    """Return symbol first, disambiguated only when required."""
    gene = "" if pd.isna(gene_id) else str(gene_id).strip()
    symbol = symbol_for_gene(gene, annotation_map)
    if not symbol:
        return gene
    if annotation_map is None:
        count = _ACTIVE_SYMBOL_COUNTS.get(symbol, 1)
    else:
        count = sum(1 for value in annotation_map.values() if str(value).strip() == symbol)
    return f"{symbol}_{gene}" if count > 1 else symbol


def decorate_gene_columns(df: pd.DataFrame) -> pd.DataFrame:
    """Add symbol and display-label columns without replacing canonical IDs."""
    if df is None or df.empty or not _ACTIVE_GENE_SYMBOLS:
        return df.copy() if isinstance(df, pd.DataFrame) else df
    out = df.copy()
    specs = [
        ("gene_id", "gene_symbol", "gene_label"),
        ("target_gene_id", "target_gene_symbol", "target_gene_label"),
        ("target", "target_symbol", "target_label"),
        ("TF", "TF_symbol", "TF_label"),
        ("tf_gene_id", "tf_symbol", "tf_label"),
        ("validated_tf_gene_id", "validated_tf_symbol", "validated_tf_label"),
        ("query_gene_id", "query_gene_symbol", "query_gene_label"),
        ("subject_gene_id", "subject_gene_symbol", "subject_gene_label"),
    ]
    for id_col, symbol_col, label_col in specs:
        if id_col not in out.columns:
            continue
        symbols = out[id_col].map(symbol_for_gene)
        labels = out[id_col].map(display_gene_label)
        if symbol_col in out.columns:
            existing = out[symbol_col].fillna("").astype(str).str.strip()
            out[symbol_col] = existing.where(existing.ne("") & existing.str.lower().ne("nan"), symbols)
        else:
            out[symbol_col] = symbols
        if label_col in out.columns:
            existing = out[label_col].fillna("").astype(str).str.strip()
            out[label_col] = existing.where(existing.ne("") & existing.str.lower().ne("nan"), labels)
        else:
            out[label_col] = labels
    return out


class ScPUREError(RuntimeError):
    pass


class InputBlocker(ScPUREError):
    pass


@dataclass(frozen=True)
class SoftwareStatus:
    name: str
    required: bool
    found: bool
    version: str | None
    path: str | None
    expected: str | None
    status: str
    remediation: str | None


@dataclass(frozen=True)
class HomologHit:
    query_gene_id: str
    subject_gene_id: str
    subject_protein_id: str
    pident: float
    query_coverage: float
    subject_coverage: float
    evalue: float
    bitscore: float
    rank: int


@dataclass(frozen=True)
class TranscriptRecord:
    gene_id: str
    transcript_id: str
    chrom: str
    strand: str
    start_1based: int
    end_1based: int
    exon_length: int
    cds_length: int
    transcript_span: int


@dataclass(frozen=True)
class PromoterRecord:
