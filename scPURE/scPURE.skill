~~~~python
from __future__ import annotations

import json
import tempfile
import unittest
from pathlib import Path
import sys

import numpy as np
import pandas as pd
from scipy import sparse

RUNTIME = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(RUNTIME))

from scpure_runtime import (  # noqa: E402
    InputBlocker,
    construct_balanced_pseudobulk,
    evaluate_filter,
    expand_peak_manifest,
    generate_promoters,
    parse_obo_bp,
    select_longest_transcripts,
    load_mapman_annotation,
    mapman_ora,
    resolve_thread_count,
    wang_similarity,
    write_input_hash_inventory,
)


class FilterAndContrastTests(unittest.TestCase):
    def test_betl_vs_all_other_excludes_betl(self) -> None:
        meta = pd.DataFrame({"cell_type": ["BETL", "ESR", "BETL", "PC"]})
        focal = evaluate_filter(meta, "cell_type == 'BETL'")
        reference = evaluate_filter(meta, "cell_type != 'BETL'")
        self.assertEqual(int((focal & reference).sum()), 0)
        self.assertEqual(int(focal.sum()), 2)
        self.assertEqual(int(reference.sum()), 2)

    def test_balancing_is_equal_within_each_paired_sample(self) -> None:
        meta = pd.DataFrame(
            {
                "sample": ["s1"] * 9 + ["s2"] * 10,
                "cell_type": ["BETL"] * 5 + ["OTHER"] * 4 + ["BETL"] * 3 + ["OTHER"] * 7,
            }
        )
        matrix = sparse.csr_matrix(np.arange(len(meta) * 3).reshape(len(meta), 3) % 5)
        contrast = {
            "id": "betl_vs_other",
            "kind": "celltype_vs_rest",
            "focal_filter": "cell_type == 'BETL'",
            "reference_filter": "cell_type != 'BETL'",
            "focal_label": "BETL",
            "reference_label": "other",
        }
        counts, pb_meta, qc = construct_balanced_pseudobulk(matrix, meta, contrast, "sample", 2, 42)
        self.assertEqual(counts.shape[0], 4)
        for _, group in qc.dropna(subset=["cells_after"]).groupby("sample_id"):
            self.assertEqual(group["cells_after"].nunique(), 1)
        self.assertTrue(pb_meta["paired_design"].all())
        included = qc[qc["status"] == "included"]
        self.assertTrue(included["selected_cell_ids_sha256"].str.fullmatch(r"[0-9a-f]{64}").all())

    def test_overlapping_arms_are_blocked(self) -> None:
        meta = pd.DataFrame({"sample": ["s1"] * 4, "group": ["A", "A", "B", "B"]})
        matrix = sparse.csr_matrix(np.ones((4, 2), dtype=int))
        contrast = {
            "id": "bad",
            "focal_filter": "group in ['A','B']",
            "reference_filter": "group == 'A'",
            "focal_label": "focal",
            "reference_label": "reference",
        }
        with self.assertRaises(InputBlocker):
            construct_balanced_pseudobulk(matrix, meta, contrast, "sample", 1, 1)


class GOTests(unittest.TestCase):
    def test_local_wang_similarity(self) -> None:
        with tempfile.TemporaryDirectory() as td:
            obo = Path(td) / "go.obo"
            obo.write_text(
                """format-version: 1.2

[Term]
id: GO:0001
name: root
namespace: biological_process

[Term]
id: GO:0002
name: child_a
namespace: biological_process
is_a: GO:0001 ! root

[Term]
id: GO:0003
name: child_b
namespace: biological_process
is_a: GO:0001 ! root

[Term]
id: GO:0004
name: grandchild
namespace: biological_process
is_a: GO:0002 ! child_a
""",
                encoding="utf-8",
            )
            _, parents, _ = parse_obo_bp(obo)
            self.assertAlmostEqual(wang_similarity("GO:0002", "GO:0002", parents), 1.0)
            self.assertGreater(wang_similarity("GO:0002", "GO:0004", parents), wang_similarity("GO:0003", "GO:0004", parents))
            self.assertGreater(wang_similarity("GO:0003", "GO:0004", parents), 0.0)


class MapManTests(unittest.TestCase):
    def test_quoted_mapman_is_aggregated_to_default_bin3(self) -> None:
        with tempfile.TemporaryDirectory() as td:
            path = Path(td) / "maize.mapman.txt"
            path.write_text(
                "BINCODE\tNAME\tIDENTIFIER\tDESCRIPTION\tTYPE\n"
                "'1'\t'Photosynthesis'\t''\t''\t''\n"
                "'1.1'\t'Photosynthesis.photophosphorylation'\t''\t''\t''\n"
                "'1.1.1'\t'Photosynthesis.photophosphorylation.photosystem II'\t''\t''\t''\n"
                "'1.1.1.1.1'\t'Photosynthesis.photophosphorylation.photosystem II.LHC-II complex.component'\t'zm1'\t'desc'\tT\n"
                "'1.1.1.2.1'\t'Photosynthesis.photophosphorylation.photosystem II.other'\t'zm2'\t'desc'\tT\n",
                encoding="utf-8",
            )
            mapping, qc = load_mapman_annotation(path, {"enrichment_level": 3})
            self.assertEqual(set(mapping["BINCODE"]), {"1.1.1"})
            self.assertEqual(set(mapping["gene_id"]), {"zm1", "zm2"})
            self.assertEqual(mapping.iloc[0]["NAME"], "Photosynthesis.photophosphorylation.photosystem II")
            self.assertEqual(int(qc.iloc[0]["requested_BIN_level"]), 3)

    def test_mapman_ora_uses_modeled_annotated_background(self) -> None:
        mapping = pd.DataFrame({
            "gene_id": ["g1", "g2", "g3", "g4", "g5"],
            "BINCODE": ["1.1.1", "1.1.1", "1.1.1", "2.1.1", "2.1.1"],
            "NAME": ["A", "A", "A", "B", "B"],
        })
        all_df, significant = mapman_ora({"g1", "g2"}, {"g1", "g2", "g3", "g4", "g5", "outside"}, mapping, {"min_bin_size": 1, "max_bin_size": 10, "min_overlap": 1, "qvalue_threshold": 1.0, "enrichment_level": 3})
        self.assertEqual(set(all_df["BINCODE"]), {"1.1.1"})
        self.assertEqual(int(all_df.iloc[0]["universe_size"]), 5)
        self.assertEqual(int(all_df.iloc[0]["target_size"]), 2)
        self.assertFalse(significant.empty)

    def test_mapman_ids_match_case_and_isoform_suffix(self) -> None:
        mapping = pd.DataFrame({
            "gene_id": ["zm00001eb000010", "zm00001eb000020_p001", "ZM00001EB000030.t1"],
            "BINCODE": ["1.1.1", "1.1.1", "1.1.1"],
            "NAME": ["A", "A", "A"],
        })
        universe = {"Zm00001eb000010", "Zm00001eb000020", "Zm00001eb000030", "Zm00001eb000040"}
        all_df, _ = mapman_ora({"Zm00001eb000010", "Zm00001eb000020"}, universe, mapping, {"min_bin_size": 1, "max_bin_size": 10, "min_overlap": 1, "qvalue_threshold": 1.0, "enrichment_level": 3})
        self.assertEqual(int(all_df.iloc[0]["universe_size"]), 3)
        self.assertEqual(int(all_df.iloc[0]["gene_count"]), 2)
        self.assertEqual(all_df.iloc[0]["genes"], "Zm00001eb000010;Zm00001eb000020")


class ThreadPolicyTests(unittest.TestCase):
    def test_default_is_half_of_currently_idle_available_threads(self) -> None:
        import scpure_runtime as runtime
        original = runtime.detect_available_cpu_ids
        runtime.detect_available_cpu_ids = lambda: ([0, 1, 2, 3, 4, 5, 6, 7], {"available_cpu_count": 8})
        try:
            resolved, details = resolve_thread_count(None, {"idle_cpu_threshold_percent": 20, "thread_sample_seconds": .5}, [0, 5, 10, 15, 80, 90, 100, 50])
        finally:
            runtime.detect_available_cpu_ids = original
        self.assertEqual(details["estimated_idle_cpu_count"], 4)
        self.assertEqual(resolved, 2)

    def test_explicit_threads_override_auto_and_are_capped(self) -> None:
        import scpure_runtime as runtime
        original = runtime.detect_available_cpu_ids
        runtime.detect_available_cpu_ids = lambda: ([0, 1, 2, 3], {"available_cpu_count": 4})
        try:
            resolved, details = resolve_thread_count(12, {})
        finally:
            runtime.detect_available_cpu_ids = original
        self.assertEqual(resolved, 4)
        self.assertTrue(details["was_capped"])


class GenomeValidationTests(unittest.TestCase):
    def test_longest_transcript_and_strand_aware_promoter(self) -> None:
        with tempfile.TemporaryDirectory() as td:
            root = Path(td)
            gff = root / "test.gff3"
            gff.write_text(
                """##gff-version 3
chr1\ttest\tgene\t101\t1000\t.\t+\t.\tID=g1
chr1\ttest\tmRNA\t101\t500\t.\t+\t.\tID=t1;Parent=g1
chr1\ttest\texon\t101\t200\t.\t+\t.\tParent=t1
chr1\ttest\tmRNA\t101\t900\t.\t+\t.\tID=t2;Parent=g1
chr1\ttest\texon\t101\t300\t.\t+\t.\tParent=t2
chr1\ttest\texon\t501\t700\t.\t+\t.\tParent=t2
chr2\ttest\tgene\t2001\t3000\t.\t-\t.\tID=g2
chr2\ttest\tmRNA\t2101\t2900\t.\t-\t.\tID=t3;Parent=g2
chr2\ttest\texon\t2101\t2400\t.\t-\t.\tParent=t3
chr2\ttest\texon\t2701\t2900\t.\t-\t.\tParent=t3
""",
                encoding="utf-8",
            )
            _, selected = select_longest_transcripts(gff)
            self.assertEqual(selected["g1"].transcript_id, "t2")
            _, promoters = generate_promoters(gff, 2000, 500, root / "out")
            self.assertEqual(promoters["g1"].tss_1based, 101)
            self.assertEqual(promoters["g1"].start_0based, 0)
            self.assertEqual(promoters["g1"].end_0based, 600)
            self.assertEqual(promoters["g2"].tss_1based, 2900)
            self.assertEqual(promoters["g2"].start_0based, 2399)
            self.assertEqual(promoters["g2"].end_0based, 4899)

    def test_peak_manifest_requires_mapping_and_expands_replicates(self) -> None:
        with tempfile.TemporaryDirectory() as td:
            root = Path(td)
            p1, p2 = root / "a.bed", root / "b.bed"
            b1, b2 = root / "a.bw", root / "b.bw"
            p1.write_text("chr1\t1\t2\n", encoding="utf-8")
            p2.write_text("chr1\t3\t4\n", encoding="utf-8")
            b1.write_bytes(b"x")
            b2.write_bytes(b"x")
            manifest = root / "peaks.csv"
            pd.DataFrame(
                [
                    {
                        "geneID": "TF1",
                        "TF symbol": "MYB1",
                        "peak path": f"{p1};{p2}",
                        "bigwig path": f"{b1};{b2}",
                    }
                ]
            ).to_csv(manifest, index=False)
            expanded = expand_peak_manifest(manifest)
            self.assertEqual(len(expanded), 2)
            self.assertEqual(set(expanded["tf_gene_id"]), {"TF1"})
            bad = root / "bad.csv"
            pd.DataFrame([{"peak_path": str(p1)}]).to_csv(bad, index=False)
            with self.assertRaises(InputBlocker):
                expand_peak_manifest(bad)



class RegressionTests(unittest.TestCase):
    def test_annotation_uses_template_path_key(self) -> None:
        from scpure_runtime import load_annotation
        with tempfile.TemporaryDirectory() as td:
            path = Path(td) / "annotation.tsv"
            pd.DataFrame([
                {"gid": "g1", "sym": "S1", "go": "GO:1"},
                {"gid": "g1", "sym": "S1", "go": "GO:2"},
            ]).to_csv(path, sep="\t", index=False)
            result = load_annotation({"path": str(path), "gene_id_column": "gid", "symbol_column": "sym", "go_column": "go", "go_separator": ";"})
            self.assertEqual(result.loc[0, "gene_id"], "g1")
            self.assertEqual(result.loc[0, "symbol"], "S1")
            self.assertEqual(result.loc[0, "go_terms"], "GO:1;GO:2")

    def test_celltype_vs_rest_drops_unpaired_samples(self) -> None:
        meta = pd.DataFrame({
            "sample": ["s1"] * 6 + ["s2"] * 6 + ["s3"] * 3,
            "cell_type": ["BETL"] * 3 + ["OTHER"] * 3 + ["BETL"] * 2 + ["OTHER"] * 4 + ["BETL"] * 3,
        })
        matrix = sparse.csr_matrix(np.ones((len(meta), 2), dtype=int))
        contrast = {"id": "paired", "kind": "celltype_vs_rest", "focal_filter": "cell_type == 'BETL'", "reference_filter": "cell_type != 'BETL'", "focal_label": "BETL", "reference_label": "other"}
        counts, pb_meta, qc = construct_balanced_pseudobulk(matrix, meta, contrast, "sample", 2, 7)
        self.assertEqual(set(pb_meta["biological_sample"]), {"s1", "s2"})
        self.assertEqual(counts.shape[0], 4)
        self.assertTrue(((qc["sample_id"] == "s3") & (qc["status"] == "dropped")).any())

    def test_mixed_paired_unpaired_group_design_is_blocked(self) -> None:
        meta = pd.DataFrame({"sample": ["s1"] * 4 + ["s2"] * 2 + ["s3"] * 2, "group": ["A", "A", "B", "B", "A", "A", "B", "B"]})
        matrix = sparse.csr_matrix(np.ones((len(meta), 2), dtype=int))
        contrast = {"id": "mixed", "kind": "within_celltype_group", "focal_filter": "group == 'A'", "reference_filter": "group == 'B'", "focal_label": "A", "reference_label": "B"}
        with self.assertRaises(InputBlocker):
            construct_balanced_pseudobulk(matrix, meta, contrast, "sample", 2, 7)

    def test_go_ora_propagates_to_bp_ancestors(self) -> None:
        from scpure_runtime import go_ora
        with tempfile.TemporaryDirectory() as td:
            obo = Path(td) / "go.obo"
            obo.write_text("""format-version: 1.2

[Term]
id: GO:0001
name: root
namespace: biological_process

[Term]
id: GO:0002
name: parent
namespace: biological_process
is_a: GO:0001 ! root

[Term]
id: GO:0003
name: child
namespace: biological_process
is_a: GO:0002 ! parent
""", encoding="utf-8")
            annotation = pd.DataFrame({"gene_id": ["g1", "g2", "g3"], "symbol": ["", "", ""], "go_terms": ["GO:0003", "GO:0003", "GO:0002"]})
            all_go, simplified, _ = go_ora({"g1", "g2"}, {"g1", "g2", "g3"}, annotation, obo, {"min_term_size": 1, "max_term_size": 10, "min_overlap": 1, "qvalue_threshold": 1.1, "wang_similarity_threshold": .7})
            self.assertIn("GO:0001", set(all_go["GO_ID"]))
            self.assertTrue(all_go["annotation_propagated_to_ancestors"].all())
            self.assertFalse(simplified.empty)

    def test_binding_prioritizes_direct_tf_and_reports_homologs(self) -> None:
        import scpure_runtime as runtime
        from scpure_runtime import HomologHit, PromoterRecord, validate_binding
        with tempfile.TemporaryDirectory() as td:
            root = Path(td)
            direct_bed = root / "direct.bed"; homolog_bed = root / "homolog.bed"
            direct_bw = root / "direct.bw"; homolog_bw = root / "homolog.bw"
            direct_bed.write_text("chr1\t100\t120\n", encoding="utf-8")
            homolog_bed.write_text("chr1\t110\t130\n", encoding="utf-8")
            direct_bw.write_bytes(b"x"); homolog_bw.write_bytes(b"x")
            peaks = pd.DataFrame([
                {"tf_gene_id": "TF1", "tf_symbol": "T1", "peak_path": str(direct_bed), "bigwig_path": str(direct_bw), "assay": "DAP", "replicate": "d1", "genome_build": "v1"},
                {"tf_gene_id": "TFH", "tf_symbol": "TH", "peak_path": str(homolog_bed), "bigwig_path": str(homolog_bw), "assay": "DAP", "replicate": "h1", "genome_build": "v1"},
            ])
            edges = pd.DataFrame([{"TF": "TF1", "target_gene_id": "G", "target_tf_rank": 1, "abs_shap_value": 2.0, "shap_value": 2.0}])
            promoter = {"G": PromoterRecord("G", "tx", "chr1", 90, 150, "+", 101, 100, 90, "rule")}
            homologs = {"TF1": [HomologHit("TF1", "TFH", "p", 75.0, .8, .8, 1e-20, 100, 1)]}
            original = runtime.summarize_bigwig
            runtime.summarize_bigwig = lambda *args, **kwargs: (1.0, 2.0, 1.9)
            try:
                result = validate_binding(edges, promoter, peaks, homologs, pd.DataFrame(), root / "out")
            finally:
                runtime.summarize_bigwig = original
            row = result.iloc[0]
            self.assertEqual(row["validation_source"], "direct_same_tf")
            self.assertEqual(row["direct_supporting_tf_ids"], "TF1")
            self.assertEqual(row["homolog_supporting_tf_ids"], "TFH")
            self.assertEqual(int(row["homolog_support_count"]), 1)

    def test_tracks_disabled_is_recorded_without_external_command(self) -> None:
        from scpure_runtime import render_tracks
        with tempfile.TemporaryDirectory() as td:
            inventory = render_tracks(pd.DataFrame(), {}, {}, {"enabled": False}, Path(td))
            self.assertEqual(inventory.loc[0, "status"], "not_run")



