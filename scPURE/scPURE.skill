def now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def log(message: str) -> None:
    print(f"[{now_iso()}] {message}", flush=True)


def _positive_int(value: Any) -> int | None:
    try:
        parsed = int(value)
    except (TypeError, ValueError):
        return None
    return parsed if parsed > 0 else None


def _cgroup_cpu_limit() -> int | None:
    """Return the integer CPU capacity imposed by cgroups, when detectable."""
    candidates: list[int] = []
    v2 = Path("/sys/fs/cgroup/cpu.max")
    if v2.is_file():
        try:
            quota_text, period_text = v2.read_text(encoding="utf-8").strip().split()[:2]
            if quota_text != "max":
                quota, period = int(quota_text), int(period_text)
                if quota > 0 and period > 0:
                    candidates.append(max(1, math.floor(quota / period)))
        except Exception:
            pass
    for quota_path, period_path in [
        (Path("/sys/fs/cgroup/cpu/cpu.cfs_quota_us"), Path("/sys/fs/cgroup/cpu/cpu.cfs_period_us")),
        (Path("/sys/fs/cgroup/cpu.cfs_quota_us"), Path("/sys/fs/cgroup/cpu.cfs_period_us")),
    ]:
        if quota_path.is_file() and period_path.is_file():
            try:
                quota = int(quota_path.read_text(encoding="utf-8").strip())
                period = int(period_path.read_text(encoding="utf-8").strip())
                if quota > 0 and period > 0:
                    candidates.append(max(1, math.floor(quota / period)))
            except Exception:
                pass
    return min(candidates) if candidates else None


def detect_available_cpu_ids() -> tuple[list[int], dict[str, Any]]:
    """Resolve CPUs visible to this process, respecting affinity and common quotas."""
    logical = max(1, int(os.cpu_count() or 1))
    try:
        affinity_ids = sorted(int(x) for x in os.sched_getaffinity(0))
    except (AttributeError, OSError):
        affinity_ids = list(range(logical))
    if not affinity_ids:
        affinity_ids = list(range(logical))
    limits = [len(affinity_ids)]
    details: dict[str, Any] = {"logical_cpu_count": logical, "affinity_cpu_ids": affinity_ids}
    cgroup_limit = _cgroup_cpu_limit()
    if cgroup_limit:
        limits.append(cgroup_limit)
        details["cgroup_cpu_limit"] = cgroup_limit
    scheduler_limits: dict[str, int] = {}
    for key in ("SLURM_CPUS_PER_TASK", "SLURM_CPUS_ON_NODE", "NSLOTS", "PBS_NP", "LSB_DJOB_NUMPROC"):
        parsed = _positive_int(os.environ.get(key))
        if parsed:
            scheduler_limits[key] = parsed
            limits.append(parsed)
    if scheduler_limits:
        details["scheduler_cpu_limits"] = scheduler_limits
    available_count = max(1, min(limits))
    details["available_cpu_count"] = available_count
    return affinity_ids[:available_count], details


def resolve_thread_count(
    requested: int | None,
    resource_cfg: Mapping[str, Any] | None = None,
    cpu_percent_by_core: Sequence[float] | None = None,
) -> tuple[int, dict[str, Any]]:
    """Resolve one run-wide thread count.

    Precedence is an explicit ``--threads`` value, then ``resources.threads``.
    When neither is supplied, sample current per-CPU utilization once and use
    floor(one half of idle logical CPUs), with a minimum of one. The resolved
    value is reused by every multithread-capable stage and written to the run
    manifest for auditability.
    """
    cfg = dict(resource_cfg or {})
    available_ids, details = detect_available_cpu_ids()
    available = len(available_ids)
    manifest_value = cfg.get("threads")
    explicit: int | None = None
    source = "auto_half_idle"
    if requested is not None:
        explicit = _positive_int(requested)
        if explicit is None:
            raise InputBlocker("--threads must be a positive integer when specified")
        source = "command_line"
    elif manifest_value not in (None, "", "auto", "auto_half_idle"):
        explicit = _positive_int(manifest_value)
        if explicit is None:
            raise InputBlocker("resources.threads must be a positive integer, null, 'auto', or 'auto_half_idle'")
        source = "manifest"
    if explicit is not None:
        resolved = min(explicit, available)
        details.update({
            "policy": "explicit_capped_to_available",
            "source": source,
            "requested_threads": explicit,
            "resolved_threads": resolved,
            "was_capped": explicit > available,
        })
        return resolved, details

    threshold = float(cfg.get("idle_cpu_threshold_percent", 20.0))
    sample_seconds = float(cfg.get("thread_sample_seconds", 0.5))
    if not 0.0 <= threshold <= 100.0:
        raise InputBlocker("resources.idle_cpu_threshold_percent must be between 0 and 100")
    if not 0.1 <= sample_seconds <= 10.0:
        raise InputBlocker("resources.thread_sample_seconds must be between 0.1 and 10 seconds")
    sampled: list[float] = []
    method = "psutil_per_cpu_percent"
    try:
        if cpu_percent_by_core is None:
            import psutil
            usage = list(map(float, psutil.cpu_percent(interval=sample_seconds, percpu=True)))
        else:
            usage = list(map(float, cpu_percent_by_core))
            method = "provided_per_cpu_percent_for_test"
        sampled = [usage[i] for i in available_ids if 0 <= i < len(usage)]
        if not sampled:
            raise RuntimeError("No per-CPU samples correspond to available CPU IDs")
        idle_count = min(available, sum(value <= threshold for value in sampled))
    except Exception as exc:
        method = "load_average_fallback"
        try:
            load_1m = float(os.getloadavg()[0])
        except (AttributeError, OSError):
            load_1m = 0.0
        idle_count = max(1, available - int(math.ceil(load_1m)))
        details["sampling_fallback_reason"] = str(exc)
        details["load_average_1m"] = load_1m
    idle_count = max(1, min(available, idle_count))
    resolved = max(1, idle_count // 2)
    details.update({
        "policy": "half_of_currently_idle_logical_cpus",
        "source": source,
        "idle_cpu_threshold_percent": threshold,
        "thread_sample_seconds": sample_seconds,
        "sampling_method": method,
        "sampled_cpu_percent": sampled,
        "estimated_idle_cpu_count": idle_count,
        "resolved_threads": resolved,
    })
    return resolved, details


_THREADPOOL_LIMIT_CONTEXT: Any | None = None


def apply_thread_limits(threads: int) -> None:
    """Apply the resolved run-wide limit to common native thread pools."""
    global _THREADPOOL_LIMIT_CONTEXT
    value = str(max(1, int(threads)))
    for key in (
        "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
        "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
    ):
        os.environ[key] = value
    try:
        from threadpoolctl import threadpool_limits
        if _THREADPOOL_LIMIT_CONTEXT is not None:
            with contextlib.suppress(Exception):
                _THREADPOOL_LIMIT_CONTEXT.__exit__(None, None, None)
        _THREADPOOL_LIMIT_CONTEXT = threadpool_limits(limits=max(1, int(threads)))
        _THREADPOOL_LIMIT_CONTEXT.__enter__()
    except Exception as exc:
        warnings.warn(f"Could not apply threadpoolctl limit; explicit tool limits and environment variables remain active: {exc}")


def ensure_absolute(path: str | os.PathLike[str], label: str) -> Path:
    p = Path(path).expanduser()
    if not p.is_absolute():
        raise InputBlocker(f"{label} must be an absolute path: {path}")
    return p


def ensure_file(path: str | os.PathLike[str], label: str) -> Path:
    p = ensure_absolute(path, label)
    if not p.is_file():
        raise InputBlocker(f"{label} does not exist or is not a file: {p}")
    if not os.access(p, os.R_OK):
        raise InputBlocker(f"{label} is not readable: {p}")
    return p


def ensure_dir(path: str | os.PathLike[str], label: str, create: bool = False) -> Path:
    p = ensure_absolute(path, label)
    if create:
        p.mkdir(parents=True, exist_ok=True)
    if not p.is_dir():
        raise InputBlocker(f"{label} does not exist or is not a directory: {p}")
    return p


def sha256_file(path: Path, chunk_size: int = 1024 * 1024) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        while chunk := fh.read(chunk_size):
            h.update(chunk)
    return h.hexdigest()


def atomic_write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(path)


def atomic_write_json(path: Path, value: Any) -> None:
    atomic_write_text(path, json.dumps(value, indent=2, ensure_ascii=False, default=str) + "\n")


def atomic_write_csv(path: Path, df: pd.DataFrame, index: bool = False) -> None:
    """Write a CSV atomically and attach symbol/display columns when possible."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    frame = decorate_gene_columns(df) if isinstance(df, pd.DataFrame) else df
    frame.to_csv(tmp, index=index)
    if frame.shape[1] > 0:
        pd.read_csv(tmp, nrows=2)
    tmp.replace(path)


def read_table(path: Path) -> pd.DataFrame:
    suffix = path.suffix.lower()
    if suffix in {".tsv", ".txt", ".bed", ".gff", ".gff3", ".gtf"}:
        return pd.read_csv(path, sep="\t", comment="#", low_memory=False)
    return pd.read_csv(path, low_memory=False)


def load_manifest(path: str | os.PathLike[str]) -> dict[str, Any]:
    p = ensure_file(path, "manifest")
    with p.open("r", encoding="utf-8") as fh:
        if p.suffix.lower() == ".json":
            data = json.load(fh)
        else:
            data = yaml.safe_load(fh)
    if not isinstance(data, dict):
        raise InputBlocker("Manifest root must be a mapping")
    return data


def package_version(name: str) -> str | None:
    aliases = {
        "scikit-learn": "scikit-learn",
        "biopython": "biopython",
        "pyBigWig": "pyBigWig",
        "python-docx": "python-docx",
        "PyMuPDF": "PyMuPDF",
        "PyYAML": "PyYAML",
        "tables": "tables",
    }
    try:
        return importlib.metadata.version(aliases.get(name, name))
    except importlib.metadata.PackageNotFoundError:
        return None


def environment_manager() -> str | None:
    return next((name for name in ("micromamba", "mamba", "conda") if shutil.which(name)), None)


def environment_command(env_name: str, command: Sequence[str]) -> list[str]:
    manager = environment_manager()
    if manager:
        return [manager, "run", "-n", env_name, *map(str, command)]
    return list(map(str, command))


def executable_version(command: str, args: Sequence[str] = ("--version",)) -> tuple[str | None, str | None]:
    path = shutil.which(command)
    if not path:
        return None, None
    try:
        proc = subprocess.run([path, *args], check=False, capture_output=True, text=True, timeout=20)
        output = (proc.stdout or proc.stderr).strip().splitlines()
        return path, output[0] if output else "unknown"
    except Exception as exc:
        return path, f"version check failed: {exc}"


def doctor(strict: bool = True) -> pd.DataFrame:
    """Validate the single pinned environment before any scientific stage.

    A scientific run must execute from the ``scPURE_agent`` Python prefix and
    every required executable must resolve inside that same prefix. The runtime
    does not permit a completed analysis to be labeled reproducible after a
    version mismatch.
    """
    statuses: list[SoftwareStatus] = []
    prefix = Path(sys.prefix).resolve()
    active_name = os.environ.get("CONDA_DEFAULT_ENV") or os.environ.get("MAMBA_DEFAULT_ENV") or prefix.name
    active_ok = active_name == "scPURE_agent" or prefix.name == "scPURE_agent"
    statuses.append(SoftwareStatus(
        "active_environment",
        True,
        True,
        active_name,
        str(prefix),
        "scPURE_agent",
        "ok" if active_ok else "mismatch",
        "Activate the single pinned scPURE_agent environment" if not active_ok else None,
    ))
    py_actual = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
    py_ok = py_actual == "3.11.11"
    statuses.append(SoftwareStatus("python", True, True, py_actual, sys.executable, "3.11.11", "ok" if py_ok else "mismatch", "Activate the exact scPURE_agent environment" if not py_ok else None))
    for name, expected in EXPECTED_MAIN_VERSIONS.items():
        if name == "python":
            continue
        actual = package_version(name)
        ok = actual == expected
        statuses.append(SoftwareStatus(name, True, actual is not None, actual, None, expected, "ok" if ok else ("missing" if actual is None else "mismatch"), f"Install {name}=={expected}" if not ok else None))

    executable_expectations: dict[str, tuple[str, Sequence[str]]] = {
        "bedtools": ("2.31.1", ("--version",)),
        "makeblastdb": ("2.16.0", ("-version",)),
        "blastp": ("2.16.0", ("-version",)),
        "pyGenomeTracks": ("3.9", ("--version",)),
    }
    for command, (expected, args) in executable_expectations.items():
        path, version = executable_version(command, args)
        path_ok = False
        if path:
            with contextlib.suppress(Exception):
                Path(path).resolve().relative_to(prefix)
                path_ok = True
        ok = bool(path and version and expected in version and path_ok)
        status = "ok" if ok else ("missing" if not path else ("outside_environment" if not path_ok else "mismatch"))
        remediation = None if ok else f"Install the pinned {command} version inside scPURE_agent and run from that environment"
        statuses.append(SoftwareStatus(command, True, path is not None, version, path, expected, status, remediation))

    rscript_path = shutil.which("Rscript")
    rscript_inside = False
    if rscript_path:
        with contextlib.suppress(Exception):
            Path(rscript_path).resolve().relative_to(prefix)
            rscript_inside = True
    r_cmd = ["Rscript", "-e", 'cat(as.character(getRversion()),"|",as.character(packageVersion("Seurat")),"|",as.character(packageVersion("DESeq2")),"|",as.character(packageVersion("BiocParallel")))']
    try:
        proc = subprocess.run(r_cmd, check=False, capture_output=True, text=True, timeout=30)
        r_version = (proc.stdout or proc.stderr).strip().splitlines()[-1] if (proc.stdout or proc.stderr).strip() else None
        r_ok = (
            proc.returncode == 0
            and r_version is not None
            and "4.4.3" in r_version
            and "5.2.1" in r_version
            and "1.46.0" in r_version
            and rscript_inside
        )
    except Exception as exc:
        r_version, r_ok = str(exc), False
    statuses.append(SoftwareStatus(
        "R/Seurat/DESeq2/BiocParallel in scPURE_agent",
        True,
        bool(rscript_path),
        r_version,
        rscript_path,
        "R 4.4.3 | Seurat 5.2.1 | DESeq2 1.46.0 | BiocParallel in the same prefix",
        "ok" if r_ok else ("missing" if not rscript_path else ("outside_environment" if not rscript_inside else "missing_or_mismatch")),
        "Create or repair the unified scPURE_agent from environment-main.yml" if not r_ok else None,
    ))
    df = pd.DataFrame([asdict(x) for x in statuses])
    if strict and (df.loc[df["required"], "status"] != "ok").any():
        bad = df[(df["required"]) & (df["status"] != "ok")][["name", "status", "version", "path", "expected"]]
        raise InputBlocker("Environment validation failed before scientific execution:\n" + bad.to_string(index=False))
    return df


def run_checked(command: Sequence[str], *, cwd: Path | None = None, log_path: Path | None = None, env: Mapping[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    safe = [str(x) for x in command]
    log(f"RUN: {' '.join(safe)}")
    proc = subprocess.run(safe, cwd=cwd, env=dict(os.environ, **(dict(env) if env else {})), capture_output=True, text=True)
    if log_path:
        atomic_write_text(log_path, f"$ {' '.join(safe)}\n\nSTDOUT\n{proc.stdout}\n\nSTDERR\n{proc.stderr}\n")
    if proc.returncode != 0:
        raise ScPUREError(f"Command failed ({proc.returncode}): {' '.join(safe)}\n{proc.stderr[-4000:]}")
    return proc


def configure_plotting() -> None:
    """Publication theme: Arial (TrueType embedded), 0.6-pt axes, 6.5-8-pt text, no top/right spines."""
    import matplotlib as mpl
    mpl.use("Agg", force=True)
    mpl.rcParams.update({
        "figure.autolayout": False,
        "figure.dpi": 150,
        "savefig.bbox": "tight",
        "savefig.pad_inches": 0.03,
        "savefig.format": "pdf",
        "pdf.fonttype": 42,
        "ps.fonttype": 42,
        "svg.fonttype": "none",
        "font.family": "sans-serif",
        "font.sans-serif": ["Arial", "Liberation Sans", "DejaVu Sans"],
        "font.size": 7,
        "mathtext.default": "regular",
        "axes.linewidth": 0.6,
        "axes.edgecolor": COLORS["near_black"],
        "axes.labelcolor": COLORS["near_black"],
        "axes.spines.top": False,
        "axes.spines.right": False,
        "axes.titlelocation": "left",
        "axes.titlesize": 8,
        "axes.titleweight": "bold",
        "axes.titlepad": 4,
        "axes.labelsize": 7,
        "axes.labelpad": 2,
        "xtick.direction": "out",
        "ytick.direction": "out",
        "xtick.major.width": 0.6,
        "ytick.major.width": 0.6,
        "xtick.major.size": 2.5,
        "ytick.major.size": 2.5,
        "xtick.labelsize": 6.5,
        "ytick.labelsize": 6.5,
        "xtick.color": COLORS["near_black"],
        "ytick.color": COLORS["near_black"],
        "legend.frameon": False,
        "legend.fontsize": 6.5,
        "legend.handlelength": 1.2,
        "lines.linewidth": 1.0,
        "patch.linewidth": 0.5,
        "grid.linewidth": 0.4,
    })


def save_figure(fig: Any, pdf_path: Path, source_df: pd.DataFrame, source_path: Path | None = None) -> None:
    pdf_path.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(pdf_path, format="pdf", bbox_inches="tight")
    if source_path is None:
        source_path = pdf_path.with_name(pdf_path.stem + "_source.csv")
    atomic_write_csv(source_path, source_df)


def _decode_values(values: Iterable[Any]) -> list[str]:
    out: list[str] = []
    for value in values:
        if isinstance(value, bytes):
            out.append(value.decode("utf-8", errors="replace"))
        else:
            out.append(str(value))
    return out


def load_loom(path: Path, raw_layer: str | None = None, gene_id_field: str | None = None, cell_id_field: str | None = None) -> tuple[sparse.csr_matrix, list[str], pd.DataFrame, dict[str, Any]]:
    import loompy
    with loompy.connect(str(path), mode="r", validate=True) as ds:
        row_attrs = list(ds.ra.keys())
        col_attrs = list(ds.ca.keys())
        row_candidates = [gene_id_field, "GeneID", "Gene", "gene_id", "gene", "Accession"]
        col_candidates = [cell_id_field, "CellID", "cell_id", "Barcode", "barcodes"]
        row_key = next((x for x in row_candidates if x and x in row_attrs), None)
        col_key = next((x for x in col_candidates if x and x in col_attrs), None)
        if row_key is None:
            raise InputBlocker(f"Cannot identify loom gene IDs. Row attributes: {row_attrs}")
        if col_key is None:
            raise InputBlocker(f"Cannot identify loom cell IDs. Column attributes: {col_attrs}")
        genes = _decode_values(ds.ra[row_key])
        cells = _decode_values(ds.ca[col_key])
        if raw_layer and raw_layer not in ds.layers:
            raise InputBlocker(f"Requested loom raw layer '{raw_layer}' absent. Available layers: {list(ds.layers.keys())}")
        matrix_obj = ds.layers[raw_layer] if raw_layer else ds
        matrix = sparse.csr_matrix(matrix_obj[:, :]).transpose().tocsr()  # cells x genes
        metadata = pd.DataFrame({key: _decode_values(ds.ca[key]) for key in col_attrs}, index=cells)
        metadata.index.name = "cell_id"
        summary = {"format": "loom", "n_cells": matrix.shape[0], "n_genes": matrix.shape[1], "row_id_field": row_key, "cell_id_field": col_key, "raw_layer": raw_layer or "main_matrix", "row_attributes": row_attrs, "column_attributes": col_attrs}
    return matrix, genes, metadata, summary


def load_seurat_rds(path: Path, assay: str, layer: str, runtime_dir: Path, work_dir: Path, r_env: str = "scPURE_agent") -> tuple[sparse.csr_matrix, list[str], pd.DataFrame, dict[str, Any]]:
    export_dir = work_dir / "seurat_export"
    export_dir.mkdir(parents=True, exist_ok=True)
    script = runtime_dir / "extract_seurat.R"
    command = environment_command(r_env, ["Rscript", str(script), str(path), assay, layer, str(export_dir)])
    run_checked(command, log_path=work_dir / "seurat_export.log")
    matrix_gene_by_cell = mmread(export_dir / "counts.mtx").tocsr()
    matrix = matrix_gene_by_cell.transpose().tocsr()
    genes = pd.read_csv(export_dir / "genes.tsv", sep="\t")["gene_id"].astype(str).tolist()
    cells = pd.read_csv(export_dir / "cells.tsv", sep="\t")["cell_id"].astype(str).tolist()
    metadata = pd.read_csv(export_dir / "metadata.tsv", sep="\t", low_memory=False).set_index("cell_id")
    metadata = metadata.reindex(cells)
    summary = json.loads((export_dir / "seurat_export_summary.json").read_text(encoding="utf-8"))
    summary["format"] = "rds_seurat"
    return matrix, genes, metadata, summary


def validate_raw_counts(matrix: sparse.spmatrix) -> dict[str, Any]:
    data = matrix.data
    if data.size == 0:
        raise InputBlocker("Count matrix has no nonzero values")
    if not np.isfinite(data).all():
        raise InputBlocker("Count matrix contains non-finite values")
    if (data < 0).any():
        raise InputBlocker("Count matrix contains negative values")
    max_fractional = float(np.max(np.abs(data - np.round(data))))
    if max_fractional > 1e-8:
        raise InputBlocker(f"Count matrix is not integer-like; maximum fractional deviation={max_fractional}")
    return {"shape": list(matrix.shape), "nnz": int(matrix.nnz), "min_nonzero": float(data.min()), "max": float(data.max()), "max_fractional_deviation": max_fractional, "integer_like": True}


def load_single_cell(manifest: Mapping[str, Any], runtime_dir: Path, stage_dir: Path) -> tuple[sparse.csr_matrix, list[str], pd.DataFrame, dict[str, Any]]:
    cfg = manifest["single_cell"]
    path = ensure_file(cfg["path"], "single-cell file")
    suffix = path.suffix.lower()
    if suffix == ".loom":
        result = load_loom(path, cfg.get("raw_count_layer"), cfg.get("gene_id_field"), cfg.get("cell_id_field"))
    elif suffix == ".rds":
        result = load_seurat_rds(path, cfg.get("raw_count_assay", "RNA"), cfg.get("raw_count_layer", "counts"), runtime_dir, stage_dir, cfg.get("r_environment", "scPURE_agent"))
    else:
        raise InputBlocker("Only .loom and .rds files are supported; .rds must contain a Seurat object")
    matrix, genes, metadata, summary = result
    if len(set(genes)) != len(genes):
        duplicates = pd.Series(genes).value_counts()
        duplicates = duplicates[duplicates > 1]
        raise InputBlocker(f"Duplicate gene IDs are not allowed before an explicit aggregation rule. Examples: {duplicates.head().to_dict()}")
    validate = validate_raw_counts(matrix)
    summary.update(validate)
    atomic_write_json(stage_dir / "single_cell_summary.json", summary)
    levels: list[dict[str, Any]] = []
    for col in metadata.columns:
        if metadata[col].nunique(dropna=False) <= 200:
            for value, count in metadata[col].astype(str).value_counts(dropna=False).items():
                levels.append({"field": col, "value": value, "cell_count": int(count)})
    atomic_write_csv(stage_dir / "metadata_levels.csv", pd.DataFrame(levels))
    lib = np.asarray(matrix.sum(axis=1)).ravel()
    detected = np.asarray((matrix > 0).sum(axis=1)).ravel()
    atomic_write_csv(stage_dir / "cell_qc.csv", pd.DataFrame({"cell_id": metadata.index, "library_size": lib, "genes_detected": detected}))
    return matrix, genes, metadata, summary


_SIMPLE_CLAUSE = re.compile(r"^\s*([A-Za-z_][A-Za-z0-9_.-]*)\s*(==|!=|in|not in)\s*(.+?)\s*$")


def _parse_literal(value: str) -> Any:
    value = value.strip()
    if (value.startswith("'") and value.endswith("'")) or (value.startswith('"') and value.endswith('"')):
        return value[1:-1]
    if value.startswith("[") and value.endswith("]"):
        inner = value[1:-1].strip()
        if not inner:
            return []
        return [_parse_literal(x) for x in re.split(r"\s*,\s*", inner)]
    if value.lower() in {"true", "false"}:
        return value.lower() == "true"
    with contextlib.suppress(ValueError):
        return int(value)
    with contextlib.suppress(ValueError):
        return float(value)
    return value


def evaluate_filter(metadata: pd.DataFrame, expression: str | None) -> pd.Series:
    if expression is None or str(expression).strip().lower() in {"", "all", "all cells", "true"}:
        return pd.Series(True, index=metadata.index)
    text = str(expression).strip()
    # Supports conjunction/disjunction of simple clauses without executing arbitrary Python.
    or_parts = re.split(r"\s*(?:\bor\b|\|)\s*", text)
    final = pd.Series(False, index=metadata.index)
    for or_part in or_parts:
        and_mask = pd.Series(True, index=metadata.index)
        for clause in re.split(r"\s*(?:\band\b|&)\s*", or_part):
            m = _SIMPLE_CLAUSE.match(clause)
            if not m:
                raise InputBlocker(f"Unsupported filter syntax: {clause}. Use simple ==, !=, in, not in clauses joined by and/or.")
            col, op, raw = m.groups()
            if col not in metadata.columns:
                raise InputBlocker(f"Filter column '{col}' not found. Available columns: {list(metadata.columns)}")
            value = _parse_literal(raw)
            series = metadata[col]
            if op == "==":
                mask = series.astype(str) == str(value)
            elif op == "!=":
                mask = series.astype(str) != str(value)
            elif op == "in":
                if not isinstance(value, list):
                    raise InputBlocker("The 'in' operator requires a list")
                mask = series.astype(str).isin([str(x) for x in value])
            else:
                if not isinstance(value, list):
                    raise InputBlocker("The 'not in' operator requires a list")
                mask = ~series.astype(str).isin([str(x) for x in value])
            and_mask &= mask.fillna(False)
        final |= and_mask
    return final


def derive_seed(global_seed: int, *tokens: str) -> int:
    payload = "|".join([str(global_seed), *tokens]).encode()
    return int(hashlib.sha256(payload).hexdigest()[:8], 16)


def _sample_indices(indices: np.ndarray, n: int, seed: int) -> np.ndarray:
    if n > len(indices):
        raise ValueError("Cannot sample more cells than available")
    rng = np.random.default_rng(seed)
    selected = rng.choice(indices, size=n, replace=False)
    return np.sort(selected)


def construct_balanced_pseudobulk(
    matrix: sparse.csr_matrix,
    metadata: pd.DataFrame,
    contrast: Mapping[str, Any],
    sample_field: str,
    min_cells: int,
    seed: int,
) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    """Create mandatory equal-cell pseudobulks with explicit pairing rules.

    celltype_vs_rest is always a within-biological-sample comparison: only
    samples containing both the focal cell type and all *other* cells are used.
    within_celltype_group may be fully paired or fully independent; a mixed
    design is blocked because silently combining paired and unpaired samples
    makes the DE model ambiguous.
    """
    subset_mask = evaluate_filter(metadata, contrast.get("subset"))
    focal_mask = subset_mask & evaluate_filter(metadata, contrast["focal_filter"])
    ref_mask = subset_mask & evaluate_filter(metadata, contrast["reference_filter"])
    overlap = focal_mask & ref_mask
    if overlap.any():
        raise InputBlocker(f"Contrast {contrast['id']} focal and reference arms overlap for {int(overlap.sum())} cells")
    if not focal_mask.any() or not ref_mask.any():
        raise InputBlocker(f"Contrast {contrast['id']} has zero cells in one arm")
    if sample_field not in metadata.columns:
        raise InputBlocker(f"Biological sample field '{sample_field}' absent")
    if min_cells < 1:
        raise InputBlocker("de.min_cells_per_sample_arm must be at least 1")

    sample_values = metadata[sample_field].astype(str)
    samples = sorted(sample_values.unique())
    group_indices: dict[tuple[str, str], np.ndarray] = {}
    audit_rows: list[dict[str, Any]] = []
    for sample in samples:
        for arm, mask in (("focal", focal_mask), ("reference", ref_mask)):
            idx = np.flatnonzero((sample_values == sample).to_numpy() & mask.to_numpy())
            group_indices[(sample, arm)] = idx
            audit_rows.append({"sample_id": sample, "arm": arm, "cells_before": len(idx)})

    focal_samples = {s for s in samples if len(group_indices[(s, "focal")]) >= min_cells}
    ref_samples = {s for s in samples if len(group_indices[(s, "reference")]) >= min_cells}
    paired_samples = sorted(focal_samples & ref_samples)
    kind = str(contrast.get("kind", "auto"))

    if kind == "celltype_vs_rest":
        # "Focal vs all cells" means focal vs all OTHER cells in the same sample.
        paired_mode = True
        if len(paired_samples) < 2:
            raise InputBlocker(
                f"Contrast {contrast['id']} is celltype_vs_rest and requires at least two biological samples "
                f"with >= {min_cells} focal cells AND >= {min_cells} non-focal cells; found {len(paired_samples)}"
            )
        included_samples = paired_samples
    elif kind == "within_celltype_group":
        paired_mode = len(paired_samples) >= 2 and focal_samples == ref_samples == set(paired_samples)
        independent_mode = len(paired_samples) == 0
        if not paired_mode and not independent_mode:
            raise InputBlocker(
                f"Contrast {contrast['id']} has a mixed paired/unpaired sample structure. "
                "Use a fully paired design (the same biological_sample IDs in both groups) or a fully independent design "
                "(different biological_sample IDs); do not mix the two."
            )
        if paired_mode:
            included_samples = paired_samples
        else:
            if len(focal_samples) < 2 or len(ref_samples) < 2:
                raise InputBlocker(f"Contrast {contrast['id']} requires at least two independent biological samples per arm after filtering")
            included_samples = sorted(focal_samples | ref_samples)
    else:
        raise InputBlocker("contrast.kind must be 'celltype_vs_rest' or 'within_celltype_group'")

    selected_groups: list[tuple[str, str, np.ndarray]] = []
    if paired_mode:
        # Equalize focal/reference cell numbers independently inside each sample.
        for sample in included_samples:
            n = min(len(group_indices[(sample, "focal")]), len(group_indices[(sample, "reference")]))
            for arm in ("focal", "reference"):
                idx = _sample_indices(group_indices[(sample, arm)], n, derive_seed(seed, contrast["id"], sample, arm))
                selected_groups.append((sample, arm, idx))
    else:
        # Equalize every pseudobulk to a single global cell count across both arms.
        n = min(
            [len(group_indices[(s, "focal")]) for s in sorted(focal_samples)]
            + [len(group_indices[(s, "reference")]) for s in sorted(ref_samples)]
        )
        for sample, arm in ([(s, "focal") for s in sorted(focal_samples)] + [(s, "reference") for s in sorted(ref_samples)]):
            idx = _sample_indices(group_indices[(sample, arm)], n, derive_seed(seed, contrast["id"], sample, arm))
            selected_groups.append((sample, arm, idx))

    counts_rows: list[np.ndarray] = []
    meta_rows: list[dict[str, Any]] = []
    after_lookup: dict[tuple[str, str], dict[str, Any]] = {}
    focal_label = str(contrast["focal_label"])
    ref_label = str(contrast["reference_label"])
    for sample, arm, idx in selected_groups:
        count_sum = np.asarray(matrix[idx, :].sum(axis=0)).ravel().astype(np.int64)
        pseudo_id = f"{sample}__{arm}"
        counts_rows.append(count_sum)
        meta_row = {
            "sample_id": pseudo_id,
            "biological_sample": sample,
            "condition": focal_label if arm == "focal" else ref_label,
            "arm": arm,
            "n_cells": len(idx),
            "paired_design": paired_mode,
            "contrast_kind": kind,
        }
        for field in contrast.get("batch_fields", []):
            if field not in metadata.columns:
                raise InputBlocker(f"Batch field '{field}' is absent from single-cell metadata")
            vals = metadata.iloc[idx][field].dropna().astype(str).unique()
            if len(vals) != 1:
                raise InputBlocker(f"Batch field '{field}' is not constant within pseudobulk {pseudo_id}: {vals.tolist()}")
            meta_row[field] = vals[0]
        meta_rows.append(meta_row)
        selected_cell_ids = sorted(metadata.index[idx].astype(str).tolist())
        selected_cell_hash = hashlib.sha256(("\n".join(selected_cell_ids) + "\n").encode("utf-8")).hexdigest()
        after_lookup[(sample, arm)] = {
            "cells_after": len(idx),
            "pseudobulk_id": pseudo_id,
            "status": "included",
            "selected_cell_ids_sha256": selected_cell_hash,
        }

    qc_rows: list[dict[str, Any]] = []
    for row in audit_rows:
        key = (row["sample_id"], row["arm"])
        extra = after_lookup.get(key)
        if extra:
            qc_rows.append({**row, **extra, "drop_reason": ""})
        else:
            other = "reference" if row["arm"] == "focal" else "focal"
            reason = "below_min_cells"
            if row["cells_before"] >= min_cells and paired_mode and len(group_indices[(row["sample_id"], other)]) < min_cells:
                reason = "paired_counterpart_below_min_cells"
            qc_rows.append({**row, "cells_after": np.nan, "pseudobulk_id": "", "status": "dropped", "drop_reason": reason, "selected_cell_ids_sha256": ""})

    counts_df = pd.DataFrame(counts_rows, index=[x["sample_id"] for x in meta_rows])
    meta_df = pd.DataFrame(meta_rows).set_index("sample_id")
    return counts_df, meta_df, pd.DataFrame(qc_rows)


def build_design(meta: pd.DataFrame, contrast: Mapping[str, Any]) -> str:
    factors: list[str] = []
    paired = bool(meta["paired_design"].all())
    if paired:
        # Blocking by biological sample is mandatory for every fully paired contrast.
        factors.append("biological_sample")
    for field in contrast.get("batch_fields", []):
        if field in meta.columns and meta[field].astype(str).nunique() > 1:
            factors.append(field)
    for field in contrast.get("design_factors", []):
        if field == "sample_id":
            field = "biological_sample"
        if field in meta.columns and field not in {"condition", "arm", "n_cells", "paired_design", "contrast_kind"}:
            factors.append(field)
    factors.append("condition")
    factors = list(dict.fromkeys(factors))
    design = "~ " + " + ".join(factors)
    validate_design_matrix(meta, factors)
    return design


def validate_design_matrix(meta: pd.DataFrame, factors: Sequence[str]) -> None:
    matrices = [np.ones((len(meta), 1))]
    columns = ["Intercept"]
    for factor in factors:
        if factor not in meta.columns:
            raise InputBlocker(f"Design factor '{factor}' absent from pseudobulk metadata")
        dummies = pd.get_dummies(meta[factor].astype(str), prefix=factor, drop_first=True, dtype=float)
        if dummies.shape[1]:
            matrices.append(dummies.to_numpy())
            columns.extend(dummies.columns.tolist())
    matrix = np.column_stack(matrices)
    rank = np.linalg.matrix_rank(matrix)
    if rank < matrix.shape[1]:
        raise InputBlocker(f"DESeq2 design is rank deficient ({rank}/{matrix.shape[1]}). Factors are confounded: {columns}")


def run_pydeseq2(counts: pd.DataFrame, meta: pd.DataFrame, design: str, focal: str, reference: str, threads: int) -> pd.DataFrame:
    from pydeseq2.dds import DeseqDataSet
    from pydeseq2.default_inference import DefaultInference
    from pydeseq2.ds import DeseqStats
    inference = DefaultInference(n_cpus=max(1, threads))
    dds = DeseqDataSet(counts=counts.astype(int), metadata=meta.copy(), design=design, refit_cooks=True, inference=inference, quiet=True)
    dds.deseq2()
    stat = DeseqStats(dds, contrast=["condition", focal, reference], alpha=0.05, inference=inference, quiet=True)
    stat.summary()
    result = stat.results_df.copy()
    result.index.name = "gene_id"
    result = result.reset_index()
    return result


def run_r_deseq2(counts: pd.DataFrame, meta: pd.DataFrame, design: str, focal: str, reference: str, runtime_dir: Path, work_dir: Path, threads: int, r_env: str = "scPURE_agent") -> pd.DataFrame:
    work_dir.mkdir(parents=True, exist_ok=True)
    counts_path = work_dir / "r_counts.csv"
    meta_path = work_dir / "r_metadata.csv"
    out_path = work_dir / "r_deseq2_results.csv"
    out_counts = counts.copy()
    out_counts.insert(0, "sample_id", out_counts.index)
    atomic_write_csv(counts_path, out_counts)
    out_meta = meta.copy()
    out_meta.insert(0, "sample_id", out_meta.index)
    atomic_write_csv(meta_path, out_meta)
    script = runtime_dir / "run_r_deseq2.R"
    cmd = environment_command(r_env, ["Rscript", str(script), str(counts_path), str(meta_path), design, "condition", focal, reference, str(out_path), str(max(1, threads))])
    run_checked(cmd, log_path=work_dir / "r_deseq2.log")
    return pd.read_csv(out_path)


def run_differential_expression(matrix: sparse.csr_matrix, genes: list[str], metadata: pd.DataFrame, manifest: Mapping[str, Any], runtime_dir: Path, output_root: Path, threads: int) -> dict[str, dict[str, Path]]:
    de_cfg = manifest["de"]
    sample_field = manifest["single_cell"]["sample_field"]
    backend = de_cfg.get("backend", "pydeseq2")
    repeats = int(de_cfg.get("repeated_subsamples", 10))
    global_seed = int(manifest["project"].get("seed", DEFAULT_SEED))
    results: dict[str, dict[str, Path]] = {}
    for contrast in manifest["contrasts"]:
        cdir = output_root / contrast["id"]
        cdir.mkdir(parents=True, exist_ok=True)
        repeat_results: list[pd.DataFrame] = []
        for repeat in range(repeats):
            seed = derive_seed(global_seed, contrast["id"], f"repeat{repeat}")
            counts, pmeta, balance = construct_balanced_pseudobulk(matrix, metadata, contrast, sample_field, int(de_cfg.get("min_cells_per_sample_arm", 20)), seed)
            counts.columns = genes
            design = build_design(pmeta, contrast)
            atomic_write_csv(cdir / f"cell_balance_repeat_{repeat:02d}.csv", balance.assign(repeat=repeat, balancing_seed=seed))
            if repeat == 0:
                atomic_write_csv(cdir / "pseudobulk_counts.csv", counts.reset_index(names="sample_id"))
                atomic_write_csv(cdir / "pseudobulk_metadata.csv", pmeta.reset_index())
                atomic_write_csv(cdir / "cell_balance.csv", balance.assign(repeat=repeat, balancing_seed=seed))
                atomic_write_text(cdir / "design.txt", design + "\n")
            if backend == "pydeseq2":
                de = run_pydeseq2(counts, pmeta, design, str(contrast["focal_label"]), str(contrast["reference_label"]), threads)
            elif backend == "r_deseq2":
                de = run_r_deseq2(counts, pmeta, design, str(contrast["focal_label"]), str(contrast["reference_label"]), runtime_dir, cdir / f"repeat_{repeat:02d}", threads, de_cfg.get("r_environment", "scPURE_agent"))
            else:
                raise InputBlocker("de.backend must be 'pydeseq2' or 'r_deseq2'")
            de["repeat"] = repeat
            repeat_results.append(de)
            atomic_write_csv(cdir / f"deseq2_repeat_{repeat:02d}.csv", de)
        primary = repeat_results[0].copy()
        lfc_thr = float(de_cfg.get("lfc_threshold", 1.0))
        q_thr = float(de_cfg.get("qvalue_threshold", 0.05))
        primary["direction"] = np.where((primary["padj"] < q_thr) & (primary["log2FoldChange"] >= lfc_thr), "up", np.where((primary["padj"] < q_thr) & (primary["log2FoldChange"] <= -lfc_thr), "down", "not_significant"))
        atomic_write_csv(cdir / "deseq2_full_results.csv", primary)
        up = primary[primary["direction"] == "up"].copy()
        down = primary[primary["direction"] == "down"].copy()
        atomic_write_csv(cdir / "deg_up.csv", up)
        atomic_write_csv(cdir / "deg_down.csv", down)
        all_repeats = pd.concat(repeat_results, ignore_index=True)
        all_repeats["selected_up"] = (all_repeats["padj"] < q_thr) & (all_repeats["log2FoldChange"] >= lfc_thr)
        all_repeats["selected_down"] = (all_repeats["padj"] < q_thr) & (all_repeats["log2FoldChange"] <= -lfc_thr)
        stability = all_repeats.groupby("gene_id", as_index=False).agg(selection_frequency_up=("selected_up", "mean"), selection_frequency_down=("selected_down", "mean"), median_log2FC=("log2FoldChange", "median"), log2FC_IQR=("log2FoldChange", lambda x: x.quantile(.75) - x.quantile(.25)), sign_consistency=("log2FoldChange", lambda x: max((x > 0).mean(), (x < 0).mean())))
        atomic_write_csv(cdir / "deg_stability.csv", stability)
        labels = pd.concat([up[["gene_id"]].assign(Label=1), down[["gene_id"]].assign(Label=0)], ignore_index=True).rename(columns={"gene_id": "GeneID"})
        atomic_write_csv(cdir / "pure_labels_up_vs_down.csv", labels)
        atomic_write_json(cdir / "de_backend.json", {"backend": "PyDESeq2 0.5.4" if backend == "pydeseq2" else "R/Bioconductor DESeq2 1.46.0", "design": design, "balanced_subsampling_is_mandatory": True, "repeated_subsamples": repeats, "note": "PyDESeq2 is a Python implementation of the DESeq2 method and is not the R package. Results may differ slightly; the exact backend is reported."})
        results[contrast["id"]] = {"labels": cdir / "pure_labels_up_vs_down.csv", "de": cdir / "deseq2_full_results.csv", "stability": cdir / "deg_stability.csv"}
    return results


def normalize_columns(df: pd.DataFrame) -> dict[str, str]:
    return {re.sub(r"[^a-z0-9]", "", str(c).lower()): str(c) for c in df.columns}


def _parse_regulon_targets(value: Any) -> list[tuple[str, float]]:
    if pd.isna(value):
        return []
    text = str(value).strip()
    pairs: list[tuple[str, float]] = []
    # Handles Python-like lists, semicolon/comma separated values, and target(weight).
    for token in re.split(r"[;,|]", text.strip("[]{}()")):
        token = token.strip().strip("'\"")
        if not token:
            continue
        m = re.match(r"(.+?)[\s:(]+(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\)?$", token)
        if m:
            pairs.append((m.group(1).strip().strip("'\""), float(m.group(2))))
        else:
            pairs.append((token, 1.0))
    return pairs


def normalize_network(path: Path, cfg: Mapping[str, Any], out_dir: Path) -> tuple[pd.DataFrame, pd.DataFrame]:
    suffix = path.suffix.lower()
    if suffix in {".h5", ".hdf5"}:
        matrix = pd.read_hdf(path, key=cfg.get("input_h5_key", "/regulons"))
        matrix.index = matrix.index.astype(str)
        matrix.columns = matrix.columns.astype(str)
        long = matrix.stack().reset_index(name="weight").rename(columns={matrix.index.name or "level_0": "target", "level_1": "TF"})
        long = long[long["weight"] != 0]
    else:
        df = read_table(path)
        cols = normalize_columns(df)
        tf_col = cfg.get("tf_column") or next((cols[x] for x in ["tf", "transcriptionfactor", "regulon"] if x in cols), None)
        target_col = cfg.get("target_column") or next((cols[x] for x in ["target", "targetgene", "gene", "geneid"] if x in cols), None)
        weight_col = cfg.get("weight_column") or next((cols[x] for x in ["weight", "importance", "score", "regulatoryweight"] if x in cols), None)
        if tf_col and target_col:
            long = df[[tf_col, target_col] + ([weight_col] if weight_col else [])].copy()
            long.columns = ["TF", "target"] + (["weight"] if weight_col else [])
            if "weight" not in long:
                long["weight"] = 1.0
        elif tf_col and any(x in cols for x in ["targetgenes", "targets", "genelist"]):
            list_col = next(cols[x] for x in ["targetgenes", "targets", "genelist"] if x in cols)
            rows = []
            for _, row in df.iterrows():
                for target, weight in _parse_regulon_targets(row[list_col]):
                    rows.append({"TF": str(row[tf_col]), "target": target, "weight": weight})
            long = pd.DataFrame(rows)
        else:
            first = str(df.columns[0])
            if df.shape[1] < 2:
                raise InputBlocker("Network must be a long table, wide target-by-TF matrix, pySCENIC regulon table, or HDF5 matrix")
            matrix = df.set_index(first)
            matrix = matrix.apply(pd.to_numeric, errors="coerce").fillna(0.0)
            matrix.index = matrix.index.astype(str)
            matrix.columns = matrix.columns.astype(str)
            long = matrix.stack().reset_index(name="weight").rename(columns={first: "target", "level_1": "TF"})
            long = long[long["weight"] != 0]
    long["TF"] = long["TF"].astype(str).str.replace(r"\(\+\)|\(-\)$", "", regex=True)
    long["target"] = long["target"].astype(str)
    long["weight"] = pd.to_numeric(long["weight"], errors="coerce")
    long = long.dropna(subset=["TF", "target", "weight"])
    dup = long[long.duplicated(["TF", "target"], keep=False)].sort_values(["TF", "target"])
    atomic_write_csv(out_dir / "network_duplicate_edges.csv", dup)
    if cfg.get("duplicate_edge_rule", "max_abs") == "max_abs":
        long = long.assign(_abs=long["weight"].abs()).sort_values("_abs").drop_duplicates(["TF", "target"], keep="last").drop(columns="_abs")
    else:
        long = long.groupby(["TF", "target"], as_index=False)["weight"].mean()
    matrix = long.pivot(index="target", columns="TF", values="weight").fillna(0.0).sort_index().sort_index(axis=1)
    atomic_write_csv(out_dir / "network_long_normalized.csv", long)
    h5_path = out_dir / "network_pure_compatible.h5"
    matrix.to_hdf(h5_path, key=cfg.get("output_h5_key", "/regulons"), mode="w", format="fixed")
    qc = pd.DataFrame([{"targets": matrix.shape[0], "TFs": matrix.shape[1], "nonzero_edges": int((matrix.to_numpy() != 0).sum()), "density": float((matrix.to_numpy() != 0).mean()), "duplicate_rows_before_resolution": len(dup)}])
    atomic_write_csv(out_dir / "network_qc.csv", qc)
    return matrix, long


def load_annotation(cfg: Mapping[str, Any] | None) -> pd.DataFrame:
    if not cfg:
        return pd.DataFrame(columns=["gene_id", "symbol", "go_terms"])
    path_value = cfg.get("path") or cfg.get("gene_table")  # legacy alias retained
    if not path_value:
        return pd.DataFrame(columns=["gene_id", "symbol", "go_terms"])
    path = ensure_file(path_value, "gene annotation table")
    df = read_table(path)
    gene_col = cfg.get("gene_id_column", "gene_id")
    if gene_col not in df.columns:
        raise InputBlocker(f"Annotation table is missing gene ID column '{gene_col}'")
    rename = {gene_col: "gene_id"}
    symbol_col = cfg.get("symbol_column", "symbol")
    go_col = cfg.get("go_column", "go_terms")
    if symbol_col in df.columns:
        rename[symbol_col] = "symbol"
    if go_col in df.columns:
        rename[go_col] = "go_terms"
    df = df.rename(columns=rename)
    for col in ("gene_id", "symbol", "go_terms"):
        if col not in df:
            df[col] = ""
    df["gene_id"] = df["gene_id"].astype(str).str.strip()
    df["symbol"] = df["symbol"].fillna("").astype(str).str.strip()
    df["go_terms"] = df["go_terms"].fillna("").astype(str).str.strip()
    df = df[df["gene_id"] != ""]
    duplicate = df[df.duplicated("gene_id", keep=False)]
    if not duplicate.empty:
        # Deterministic aggregation preserves all GO terms while preferring the first non-empty symbol.
        sep = str(cfg.get("go_separator", ";"))
        rows = []
        for gene_id, group in df.groupby("gene_id", sort=True):
            symbols = [x for x in group["symbol"] if x and x.lower() != "nan"]
            terms: set[str] = set()
            for value in group["go_terms"]:
                terms.update(x.strip() for x in str(value).split(sep) if x.strip())
            rows.append({"gene_id": gene_id, "symbol": symbols[0] if symbols else "", "go_terms": sep.join(sorted(terms))})
        df = pd.DataFrame(rows)
    return df[["gene_id", "symbol", "go_terms"]].drop_duplicates("gene_id")


def label_gene(gene_id: str, annotation_map: Mapping[str, str] | None = None) -> str:
    """Human-facing label: unique symbol, duplicate-safe symbol_ID, or gene ID."""
    return display_gene_label(gene_id, annotation_map)


def _metric_rows(y_true: np.ndarray, probabilities: np.ndarray, predicted: np.ndarray) -> dict[str, float]:
    from sklearn.metrics import accuracy_score, average_precision_score, balanced_accuracy_score, f1_score, matthews_corrcoef, precision_score, recall_score, roc_auc_score
    return {
        "roc_auc": float(roc_auc_score(y_true, probabilities)),
        "pr_auc": float(average_precision_score(y_true, probabilities)),
        "balanced_accuracy": float(balanced_accuracy_score(y_true, predicted)),
        "accuracy": float(accuracy_score(y_true, predicted)),
        "precision": float(precision_score(y_true, predicted, zero_division=0)),
        "recall": float(recall_score(y_true, predicted, zero_division=0)),
        "f1": float(f1_score(y_true, predicted, zero_division=0)),
        "mcc": float(matthews_corrcoef(y_true, predicted)),
    }


def catboost_base_params(cfg: Mapping[str, Any], threads: int) -> dict[str, Any]:
    return {
        "loss_function": "Logloss",
        "eval_metric": "AUC",
        "iterations": int(cfg.get("iterations", 1000)),
        "learning_rate": float(cfg.get("learning_rate", 0.05)),
        "depth": int(cfg.get("depth", 6)),
        "l2_leaf_reg": float(cfg.get("l2_leaf_reg", 3.0)),
        "auto_class_weights": cfg.get("auto_class_weights", "Balanced"),
        "thread_count": max(1, threads),
        "allow_writing_files": False,
        "verbose": False,
        "task_type": "CPU",
    }


def catboost_baseline_cv(X: pd.DataFrame, y: np.ndarray, params: Mapping[str, Any], seed: int) -> tuple[float, float]:
    from catboost import CatBoostClassifier
    from sklearn.metrics import roc_auc_score
    from sklearn.model_selection import StratifiedKFold
    splitter = StratifiedKFold(n_splits=min(3, int(np.bincount(y).min())), shuffle=True, random_state=seed)
    scores: list[float] = []
    for fold, (train_idx, test_idx) in enumerate(splitter.split(X, y)):
        model = CatBoostClassifier(**dict(params), random_seed=derive_seed(seed, "baseline", str(fold)))
        model.fit(X.iloc[train_idx], y[train_idx])
        scores.append(float(roc_auc_score(y[test_idx], model.predict_proba(X.iloc[test_idx])[:, 1])))
    return float(np.mean(scores)), float(np.std(scores, ddof=1) if len(scores) > 1 else 0.0)


def tune_catboost_inner(X: pd.DataFrame, y: np.ndarray, base_params: Mapping[str, Any], cfg: Mapping[str, Any], seed: int) -> dict[str, Any]:
    import optuna
    from catboost import CatBoostClassifier
    from sklearn.metrics import average_precision_score, roc_auc_score
    from sklearn.model_selection import StratifiedKFold
    n_trials = int(cfg.get("optuna_trials", cfg.get("tuning_trials", 30)))
    inner_splits = min(3, int(np.bincount(y).min()))
    if inner_splits < 2:
        return dict(base_params)
    splitter = StratifiedKFold(n_splits=inner_splits, shuffle=True, random_state=seed)
    optuna.logging.set_verbosity(optuna.logging.WARNING)

    def objective(trial: Any) -> tuple[float, float]:
        params = dict(base_params)
        params.update({
            "iterations": trial.suggest_int("iterations", 500, 2500, step=100),
            "learning_rate": trial.suggest_float("learning_rate", 0.01, 0.10, log=True),
            "depth": trial.suggest_int("depth", 4, 8),
            "l2_leaf_reg": trial.suggest_float("l2_leaf_reg", 1.0, 12.0, log=True),
            "random_strength": trial.suggest_float("random_strength", 0.0, 2.0),
            "bagging_temperature": trial.suggest_float("bagging_temperature", 0.0, 2.0),
        })
        pr_scores: list[float] = []
        roc_scores: list[float] = []
        for fold, (train_idx, valid_idx) in enumerate(splitter.split(X, y)):
            model = CatBoostClassifier(**params, random_seed=derive_seed(seed, "inner", str(trial.number), str(fold)))
            model.fit(X.iloc[train_idx], y[train_idx])
            proba = model.predict_proba(X.iloc[valid_idx])[:, 1]
            pr_scores.append(float(average_precision_score(y[valid_idx], proba)))
            roc_scores.append(float(roc_auc_score(y[valid_idx], proba)))
        # Multi-objective: maximize PR AUC, then ROC AUC. Fold variance is stored as a user attribute.
        trial.set_user_attr("pr_sd", float(np.std(pr_scores, ddof=1) if len(pr_scores) > 1 else 0.0))
        return float(np.mean(pr_scores)), float(np.mean(roc_scores))

    study = optuna.create_study(directions=["maximize", "maximize"], sampler=optuna.samplers.TPESampler(seed=seed))
    study.optimize(objective, n_trials=n_trials, show_progress_bar=False)
    candidates = sorted(study.best_trials, key=lambda t: (t.values[0], t.values[1], -float(t.user_attrs.get("pr_sd", 0.0))), reverse=True)
    best = candidates[0]
    tuned = dict(base_params)
    tuned.update(best.params)
    return tuned


def fit_catboost_oof(network: pd.DataFrame, labels_path: Path, cfg: Mapping[str, Any], out_dir: Path, seed: int, threads: int) -> dict[str, Path]:
    from catboost import CatBoostClassifier, Pool
    from sklearn.metrics import precision_recall_curve, roc_curve
    from sklearn.model_selection import RepeatedStratifiedKFold
    labels = pd.read_csv(labels_path)
    labels.columns = ["GeneID", "Label"]
    labels["GeneID"] = labels["GeneID"].astype(str)
    common = labels[labels["GeneID"].isin(network.index)].drop_duplicates("GeneID")
    if len(common) < 40:
        raise InputBlocker(f"Only {len(common)} labeled genes overlap the network; at least 40 are required")
    counts = common["Label"].value_counts()
    if len(counts) != 2 or counts.min() < 10:
        raise InputBlocker(f"Both label classes require at least 10 genes; observed {counts.to_dict()}")
    X = network.loc[common["GeneID"]].copy()
    y = common["Label"].astype(int).to_numpy()
    genes = common["GeneID"].tolist()
    requested_splits = int(cfg.get("n_splits", 5))
    n_splits = min(requested_splits, int(counts.min()))
    repeats = int(cfg.get("repeats", 1))
    splitter = RepeatedStratifiedKFold(n_splits=n_splits, n_repeats=repeats, random_state=seed)
    shap_accum = np.zeros_like(X.to_numpy(dtype=float), dtype=float)
    shap_counts = np.zeros(len(X), dtype=int)
    metrics_rows: list[dict[str, Any]] = []
    prediction_rows: list[dict[str, Any]] = []
    roc_rows: list[dict[str, Any]] = []
    pr_rows: list[dict[str, Any]] = []
    fold_rankings: list[pd.Series] = []
    params = catboost_base_params(cfg, threads)
    tune_mode = str(cfg.get("tune", "auto")).lower()
    tuning_active = tune_mode in {"true", "on", "yes", "always"}
    baseline_mean = baseline_sd = None
    if tune_mode == "auto" and int(counts.min()) >= 100:
        baseline_mean, baseline_sd = catboost_baseline_cv(X, y, params, seed)
        tuning_active = baseline_mean < 0.75 or baseline_sd > 0.08
    atomic_write_json(out_dir / "tuning_decision.json", {"mode": tune_mode, "activated": tuning_active, "baseline_mean_roc_auc": baseline_mean, "baseline_sd_roc_auc": baseline_sd, "minimum_class_size": int(counts.min()), "nested_inner_cv": tuning_active})
    tuned_params_by_fold: list[dict[str, Any]] = []
    for fold, (train_idx, test_idx) in enumerate(splitter.split(X, y)):
        fold_seed = derive_seed(seed, f"fold{fold}")
        fold_params = tune_catboost_inner(X.iloc[train_idx], y[train_idx], params, cfg, fold_seed) if tuning_active else dict(params)
        tuned_params_by_fold.append(fold_params)
        model = CatBoostClassifier(**fold_params, random_seed=fold_seed)
        model.fit(X.iloc[train_idx], y[train_idx])
        proba = model.predict_proba(X.iloc[test_idx])[:, 1]
        pred = (proba >= 0.5).astype(int)
        metrics = _metric_rows(y[test_idx], proba, pred)
        metrics_rows.append({"fold": fold, **metrics, "n_train": len(train_idx), "n_validation": len(test_idx)})
        for i, idx in enumerate(test_idx):
            prediction_rows.append({"fold": fold, "gene_id": genes[idx], "label": int(y[idx]), "probability": float(proba[i]), "prediction": int(pred[i])})
        fpr, tpr, _ = roc_curve(y[test_idx], proba)
        prec, rec, _ = precision_recall_curve(y[test_idx], proba)
        roc_rows.extend({"fold": fold, "fpr": float(a), "tpr": float(b)} for a, b in zip(fpr, tpr))
        pr_rows.extend({"fold": fold, "recall": float(a), "precision": float(b)} for a, b in zip(rec, prec))
        shap_values = model.get_feature_importance(Pool(X.iloc[test_idx], y[test_idx]), type="ShapValues")[:, :-1]
        shap_accum[test_idx] += shap_values
        shap_counts[test_idx] += 1
        edge_mask = X.iloc[test_idx].to_numpy() != 0
        fold_rankings.append(pd.Series(np.abs(np.where(edge_mask, shap_values, 0.0)).sum(axis=0), index=X.columns, name=fold))
    if (shap_counts == 0).any():
        raise ScPUREError("Internal error: some genes lack out-of-fold SHAP values")
    shap_oof = shap_accum / shap_counts[:, None]
    shap_df = pd.DataFrame(shap_oof, index=genes, columns=X.columns)
    edge_filtered = shap_df.where(X.to_numpy() != 0, 0.0)
    nonzero_abs = np.abs(edge_filtered.to_numpy())
    nonzero_abs = nonzero_abs[nonzero_abs > 0]
    threshold = float(np.quantile(nonzero_abs, 1 - float(cfg.get("shap_keep_percent", 20)) / 100.0)) if nonzero_abs.size else math.inf
    top = edge_filtered.where(np.abs(edge_filtered) >= threshold, 0.0)
    raw_path = out_dir / "SHAP_oof_raw.csv"
    edge_path = out_dir / "SHAP_oof_edge_filtered.csv"
    top_path = out_dir / "SHAP_oof_top20pct.csv"
    shap_df.to_csv(raw_path, index_label="GeneID")
    edge_filtered.to_csv(edge_path, index_label="GeneID")
    top.to_csv(top_path, index_label="GeneID")
    metrics_df = pd.DataFrame(metrics_rows)
    pred_df = pd.DataFrame(prediction_rows)
    atomic_write_csv(out_dir / "cv_metrics.csv", metrics_df)
    atomic_write_csv(out_dir / "cv_predictions.csv", pred_df)
    atomic_write_csv(out_dir / "roc_coordinates.csv", pd.DataFrame(roc_rows))
    atomic_write_csv(out_dir / "pr_coordinates.csv", pd.DataFrame(pr_rows))
    rank_df = pd.concat(fold_rankings, axis=1).T.rank(axis=1, ascending=False, method="average")
    summary = pd.DataFrame({
        "TF": top.columns,
        "sum_signed_shap": top.sum(axis=0).to_numpy(),
        "sum_abs_shap": top.abs().sum(axis=0).to_numpy(),
        "target_count_top20pct": (top != 0).sum(axis=0).to_numpy(),
        "mean_abs_rank": top.abs().where(top != 0).rank(axis=1, ascending=False, method="average").mean(axis=0).to_numpy(),
        "stability_score": (rank_df <= int(cfg.get("top_tfs", 20))).mean(axis=0).reindex(top.columns).to_numpy(),
        "network_degree": (X != 0).sum(axis=0).to_numpy(),
    })
    summary["degree_normalized_sum_abs_shap"] = summary["sum_abs_shap"] / summary["network_degree"].clip(lower=1)
    summary = summary.sort_values(["sum_abs_shap", "stability_score"], ascending=[False, False])
    atomic_write_csv(out_dir / "SHAP_feature_summary.csv", summary)
    directional = pd.DataFrame({
        "TF": edge_filtered.columns,
        "net_signed_shap_edge_filtered": edge_filtered.sum(axis=0).to_numpy(),
        "positive_shap_toward_focal": edge_filtered.clip(lower=0).sum(axis=0).to_numpy(),
        "negative_shap_toward_reference": (-edge_filtered.clip(upper=0)).sum(axis=0).to_numpy(),
        "targets_with_nonzero_shap": (edge_filtered != 0).sum(axis=0).to_numpy(),
        "network_degree": (X != 0).sum(axis=0).to_numpy(),
    })
    directional["rank_toward_focal"] = directional["net_signed_shap_edge_filtered"].rank(ascending=False, method="min").astype(int)
    directional["rank_toward_reference"] = directional["net_signed_shap_edge_filtered"].rank(ascending=True, method="min").astype(int)
    directional = directional.sort_values("rank_toward_focal")
    atomic_write_csv(out_dir / "SHAP_directional_TF_ranking.csv", directional)
    pred_mean = pd.DataFrame(prediction_rows).groupby("gene_id", as_index=False).agg(label=("label", "first"), probability=("probability", "mean"))
    plot_directional_tfs(directional, out_dir, focal_label=str(cfg.get("_focal_label", "focal")), reference_label=str(cfg.get("_reference_label", "reference")), top_n=int(cfg.get("top_tfs", 20)))
    rank_long = top.stack().reset_index(name="shap_value").rename(columns={"level_0": "target_gene_id", "level_1": "TF"})
    rank_long = rank_long[rank_long["shap_value"] != 0]
    rank_long["abs_shap"] = rank_long["shap_value"].abs()
    rank_long["target_tf_rank"] = rank_long.groupby("target_gene_id")["abs_shap"].rank(ascending=False, method="min").astype(int)
    atomic_write_csv(out_dir / "SHAP_target_tf_rank_long.csv", rank_long.sort_values(["target_gene_id", "target_tf_rank"]))
    if tuned_params_by_fold:
        numeric_keys = ["iterations", "learning_rate", "depth", "l2_leaf_reg", "random_strength", "bagging_temperature"]
        final_params = dict(params)
        for key in numeric_keys:
            vals = [p[key] for p in tuned_params_by_fold if key in p]
            if vals:
                final_params[key] = int(round(float(np.median(vals)))) if key in {"iterations", "depth"} else float(np.median(vals))
    else:
        final_params = dict(params)
    atomic_write_json(out_dir / "catboost_parameters_by_fold.json", {"fold_parameters": tuned_params_by_fold, "final_full_data_parameters": final_params})
    final_model = CatBoostClassifier(**final_params, random_seed=seed)
    final_model.fit(X, y)
    final_model.save_model(str(out_dir / "catboost_full_data.cbm"))
    atomic_write_json(out_dir / "shap_filter.json", {"keep_percent": cfg.get("shap_keep_percent", 20), "absolute_shap_threshold": threshold, "retained_nonzero_fraction": float((top.to_numpy() != 0).sum() / max(1, (edge_filtered.to_numpy() != 0).sum())), "interpretation_guardrail": "SHAP sign indicates movement toward or away from the focal model class. It must not be described as TF activation or repression without independent signed regulatory evidence."})
    plot_model_performance(metrics_df, pd.DataFrame(roc_rows), pd.DataFrame(pr_rows), out_dir, pooled=pred_mean)
    return {"directional": out_dir / "SHAP_directional_TF_ranking.csv", "raw": raw_path, "edge": edge_path, "top": top_path, "summary": out_dir / "SHAP_feature_summary.csv", "rank_long": out_dir / "SHAP_target_tf_rank_long.csv", "metrics": out_dir / "cv_metrics.csv"}


def plot_model_performance(metrics: pd.DataFrame, roc: pd.DataFrame, pr: pd.DataFrame, out_dir: Path, pooled: pd.DataFrame | None = None) -> None:
    configure_plotting()
    import matplotlib.pyplot as plt
    from sklearn.metrics import auc, average_precision_score, precision_recall_curve, roc_auc_score, roc_curve
    pooled_auc = pooled_ap = None
    roc_src, pr_src = roc.assign(curve="fold"), pr.assign(curve="fold")
    if pooled is not None and not pooled.empty and pooled["label"].nunique() == 2:
        f, t, _ = roc_curve(pooled["label"], pooled["probability"])
        p, r, _ = precision_recall_curve(pooled["label"], pooled["probability"])
        pooled_auc = float(roc_auc_score(pooled["label"], pooled["probability"]))
        pooled_ap = float(average_precision_score(pooled["label"], pooled["probability"]))
        roc_src = pd.concat([roc_src, pd.DataFrame({"fold": "pooled", "fpr": f, "tpr": t, "curve": "pooled_out_of_fold"})])
        pr_src = pd.concat([pr_src, pd.DataFrame({"fold": "pooled", "recall": r, "precision": p, "curve": "pooled_out_of_fold"})])
        atomic_write_json(out_dir / "pooled_out_of_fold_metrics.json", {"roc_auc": pooled_auc, "average_precision": pooled_ap, "n_genes": int(len(pooled)), "note": "Probabilities averaged over CV repeats before pooling."})
    fig, ax = plt.subplots(figsize=(2.4, 2.3))
    for _, group in roc.groupby("fold"):
        ax.plot(group["fpr"], group["tpr"], lw=.5, color="#B9C3CC")
    if pooled_auc is not None:
        ax.plot(f, t, lw=1.3, color=COLORS["blue"], label=f"Pooled out-of-fold (AUC = {pooled_auc:.3f})")
        ax.legend(loc="lower right")
    ax.plot([0, 1], [0, 1], ls=(0, (2, 2)), lw=.6, color="#8A8A8A")
    ax.set(xlim=(0, 1), ylim=(0, 1.01), xlabel="False-positive rate", ylabel="True-positive rate", title="ROC")
    save_figure(fig, out_dir / "ROC_curves.pdf", roc_src)
    plt.close(fig)
    fig, ax = plt.subplots(figsize=(2.4, 2.3))
    for _, group in pr.groupby("fold"):
        ax.plot(group["recall"], group["precision"], lw=.5, color="#B9C3CC")
    if pooled_ap is not None:
        ax.plot(r, p, lw=1.3, color=COLORS["teal"], label=f"Pooled out-of-fold (AP = {pooled_ap:.3f})")
        ax.legend(loc="lower left")
    ax.set(xlim=(0, 1), ylim=(0, 1.01), xlabel="Recall", ylabel="Precision", title="Precision–recall")
    save_figure(fig, out_dir / "PR_curves.pdf", pr_src)
    plt.close(fig)
    long = metrics.melt(id_vars=["fold", "n_train", "n_validation"], value_vars=["roc_auc", "pr_auc", "balanced_accuracy", "f1", "mcc"], var_name="metric", value_name="value")
    names = {"roc_auc": "ROC AUC", "pr_auc": "PR AUC", "balanced_accuracy": "Balanced accuracy", "f1": "F1 score", "mcc": "MCC"}
    order = list(names)
    fig, ax = plt.subplots(figsize=(2.8, 1.9))
    for i, m in enumerate(order):
        v = long.loc[long["metric"] == m, "value"].to_numpy(dtype=float)
        if v.size == 0:
            continue
        ax.barh(i, np.nanmean(v), height=.62, color=COLORS["light_blue"], edgecolor=COLORS["blue"], lw=.6)
        ax.scatter(v, np.full(v.size, i) + np.linspace(-.18, .18, v.size), s=5, color=COLORS["blue"], zorder=3, lw=0)
    ax.set_yticks(range(len(order)), [names[m] for m in order]); ax.invert_yaxis()
    ax.set(xlim=(min(0, float(np.nanmin(long["value"])) if len(long) else 0), 1), xlabel="Held-out fold score", title="Cross-validated performance")
    save_figure(fig, out_dir / "performance_metrics.pdf", long)
    plt.close(fig)


def plot_directional_tfs(directional: pd.DataFrame, out_dir: Path, focal_label: str, reference_label: str, top_n: int = 20) -> None:
    """Two-panel dot plot of TFs with the largest net SHAP toward each class (edge-filtered, PURE-style)."""
    configure_plotting()
    import matplotlib.pyplot as plt
    from matplotlib.colors import LinearSegmentedColormap
    d = directional.copy()
    d["TF_label"] = d["TF"].map(display_gene_label)
    up = d[d["net_signed_shap_edge_filtered"] > 0].nlargest(top_n, "net_signed_shap_edge_filtered").assign(direction=f"toward {focal_label}", value=lambda x: x["net_signed_shap_edge_filtered"])
    dn = d[d["net_signed_shap_edge_filtered"] < 0].nsmallest(top_n, "net_signed_shap_edge_filtered").assign(direction=f"toward {reference_label}", value=lambda x: -x["net_signed_shap_edge_filtered"])
    panels = [(up, COLORS["red"], f"Toward {focal_label}"), (dn, COLORS["blue"], f"Toward {reference_label}")]
    n = max(len(up), len(dn), 1)
    fig, axes = plt.subplots(1, 2, figsize=(4.6, .16 * n + .9))
    for ax, (df, col, title) in zip(axes, panels):
        df = df.iloc[::-1]
        y = np.arange(len(df))
        if len(df):
            cmap = LinearSegmentedColormap.from_list("c", ["#E9EDF1", col])
            frac = (df["value"] / df["value"].max()).to_numpy()
            ax.hlines(y, 0, df["value"], color="#C9CED3", lw=.6)
            ax.scatter(df["value"], y, s=10 + 26 * frac, c=cmap(.35 + .65 * frac), edgecolor=col, lw=.4, zorder=3)
            ax.set_xlim(0, df["value"].max() * 1.12)
        ax.set_yticks(y, df["TF_label"]); ax.set_ylim(-.7, n - .3)
        ax.set(xlabel="Net SHAP (summed over genes)", title=title)
    fig.text(.01, -.02, "SHAP sign indicates contribution toward a model class, not activation or repression.", fontsize=5.5, color="#555555")
    fig.tight_layout(w_pad=1.5)
    save_figure(fig, out_dir / "top_TFs_directional_SHAP.pdf", pd.concat([up, dn])[["TF", "TF_label", "direction", "value", "targets_with_nonzero_shap"]])
    plt.close(fig)


def parse_fasta_gene_map(fasta_path: Path, annotation: pd.DataFrame, cfg: Mapping[str, Any]) -> tuple[dict[str, str], dict[str, str]]:
    from Bio import SeqIO
    known_genes = set(annotation["gene_id"].astype(str)) if not annotation.empty else set()
    protein_to_gene: dict[str, str] = {}
    seqs: dict[str, str] = {}
    regex_value = cfg.get("fasta_gene_id_regex") or cfg.get("protein_gene_regex") or r"(?:gene[:=]|gene_id[ =])([^\s;|]+)"
    regex = re.compile(regex_value)
    for record in SeqIO.parse(str(fasta_path), "fasta"):
        protein_id = str(record.id)
        desc = str(record.description)
        match = regex.search(desc)
        candidates = [match.group(1) if match else None, protein_id, protein_id.split(".")[0], protein_id.split("_")[0]]
        gene = next((str(x) for x in candidates if x and (not known_genes or str(x) in known_genes)), str(candidates[0] or protein_id))
        protein_to_gene[protein_id] = gene
        seqs[protein_id] = str(record.seq)
    return protein_to_gene, seqs


def run_self_blast(fasta_path: Path, annotation: pd.DataFrame, cfg: Mapping[str, Any], queries: Sequence[str], out_dir: Path, threads: int) -> tuple[pd.DataFrame, dict[str, list[HomologHit]]]:
    from Bio import SeqIO
    out_dir.mkdir(parents=True, exist_ok=True)
    protein_to_gene, seqs = parse_fasta_gene_map(fasta_path, annotation, cfg)
    gene_to_proteins: dict[str, list[str]] = defaultdict(list)
    for protein, gene in protein_to_gene.items(): gene_to_proteins[gene].append(protein)
    canonical = {gene: sorted(proteins, key=lambda p: (-len(seqs[p]), p))[0] for gene, proteins in gene_to_proteins.items()}
    symbol_to_genes: dict[str, list[str]] = defaultdict(list)
    if not annotation.empty:
        for row in annotation.itertuples(index=False):
            symbol = str(row.symbol).strip()
            if symbol and symbol.lower() != "nan": symbol_to_genes[symbol].append(str(row.gene_id))
    query_resolution_rows=[]; alias_by_gene: dict[str, list[str]] = defaultdict(list)
    for query in sorted(set(map(str, queries))):
        if query in canonical:
            resolved, method = query, "exact_gene_id"
        else:
            candidates = sorted(set(symbol_to_genes.get(query, [])))
            candidates = [x for x in candidates if x in canonical]
            if len(candidates) == 1: resolved, method = candidates[0], "unique_annotation_symbol"
            elif len(candidates) > 1: resolved, method = "", "ambiguous_annotation_symbol"
            else: resolved, method = "", "unresolved"
        query_resolution_rows.append({"requested_query_id": query, "resolved_gene_id": resolved, "resolution_method": method})
        if resolved: alias_by_gene[resolved].append(query)
    atomic_write_csv(out_dir / "homology_query_resolution.csv", pd.DataFrame(query_resolution_rows))
    missing = [x["requested_query_id"] for x in query_resolution_rows if not x["resolved_gene_id"]]
    if missing: atomic_write_text(out_dir / "homology_missing_queries.txt", "\n".join(missing) + "\n")
    records = {r.id: r for r in SeqIO.parse(str(fasta_path), "fasta")}
    resolved_genes = sorted(alias_by_gene)
    query_records = [records[canonical[g]] for g in resolved_genes]
    if not query_records:
        empty = pd.DataFrame(columns=["requested_query_ids", "query_gene_id", "subject_gene_id", "pident", "query_coverage", "subject_coverage", "rank"])
        atomic_write_csv(out_dir / "self_blast_filtered_homologs.csv", empty); return empty, {}
    query_fa = out_dir / "blast_queries.fa"; SeqIO.write(query_records, str(query_fa), "fasta")
    db_prefix = out_dir / "self_proteome_db"; run_checked(["makeblastdb", "-in", str(fasta_path), "-dbtype", "prot", "-out", str(db_prefix)], log_path=out_dir / "makeblastdb.log")
    raw = out_dir / "self_blast_raw.tsv"; fields = "qseqid sseqid pident length qlen slen qstart qend sstart send evalue bitscore"
    run_checked(["blastp", "-query", str(query_fa), "-db", str(db_prefix), "-out", str(raw), "-outfmt", f"6 {fields}", "-evalue", str(cfg.get("evalue", 1e-5)), "-max_target_seqs", str(cfg.get("max_target_seqs", 100)), "-num_threads", str(max(1, threads))], log_path=out_dir / "blastp.log")
    names = fields.split(); hits = pd.read_csv(raw, sep="\t", names=names) if raw.stat().st_size else pd.DataFrame(columns=names)
    if hits.empty:
        filtered = hits.assign(requested_query_ids=pd.Series(dtype=str), query_gene_id=pd.Series(dtype=str), subject_gene_id=pd.Series(dtype=str), query_coverage=pd.Series(dtype=float), subject_coverage=pd.Series(dtype=float), rank=pd.Series(dtype=int))
        atomic_write_csv(out_dir / "self_blast_filtered_homologs.csv", filtered); return filtered, {}
    hits["query_gene_id"] = hits["qseqid"].map(protein_to_gene); hits["subject_gene_id"] = hits["sseqid"].map(protein_to_gene)
    hits["requested_query_ids"] = hits["query_gene_id"].map(lambda x: ";".join(sorted(alias_by_gene.get(str(x), []))))
    hits["query_coverage"] = (hits["qend"] - hits["qstart"] + 1) / hits["qlen"]
    hits["subject_coverage"] = (hits["send"] - hits["sstart"] + 1).abs().add(1) / hits["slen"]
    filtered = hits[(hits["qseqid"] != hits["sseqid"]) & (hits["query_gene_id"] != hits["subject_gene_id"]) &
                    (hits["pident"] >= float(cfg.get("minimum_identity_percent", 60.0))) &
                    (hits["query_coverage"] >= float(cfg.get("minimum_query_coverage", 0.60))) &
                    (hits["subject_coverage"] >= float(cfg.get("minimum_subject_coverage", 0.60)))].copy()
    filtered = filtered.sort_values(["query_gene_id", "subject_gene_id", "bitscore", "pident", "query_coverage", "subject_coverage"], ascending=[True, True, False, False, False, False]).drop_duplicates(["query_gene_id", "subject_gene_id"], keep="first")
    filtered = filtered.sort_values(["query_gene_id", "bitscore", "pident", "query_coverage", "subject_coverage", "subject_gene_id"], ascending=[True, False, False, False, False, True])
    max_homologs = int(cfg.get("max_homologs_per_query", 20))
    if max_homologs < 1: raise InputBlocker("homology.max_homologs_per_query must be at least 1")
    filtered["rank"] = filtered.groupby("query_gene_id").cumcount() + 1; filtered = filtered[filtered["rank"] <= max_homologs].copy()
    atomic_write_csv(out_dir / "self_blast_filtered_homologs.csv", filtered)
    by_query: dict[str, list[HomologHit]] = defaultdict(list)
    for row in filtered.itertuples():
        hit = HomologHit(row.query_gene_id, row.subject_gene_id, row.sseqid, float(row.pident), float(row.query_coverage), float(row.subject_coverage), float(row.evalue), float(row.bitscore), int(row.rank))
        by_query[str(row.query_gene_id)].append(hit)
        for alias in alias_by_gene.get(str(row.query_gene_id), []): by_query[alias].append(hit)
    atomic_write_json(out_dir / "homology_policy.json", {"scope": "within_species_only", "minimum_identity_percent": float(cfg.get("minimum_identity_percent", 60.0)), "minimum_query_coverage": float(cfg.get("minimum_query_coverage", .60)), "minimum_subject_coverage": float(cfg.get("minimum_subject_coverage", .60)), "maximum_homologs_per_query": max_homologs, "query_resolution": "exact gene ID or unique annotation symbol", "rule": "Only same-proteome hits passing identity and bidirectional coverage thresholds are eligible. Direct-TF binding evidence always outranks homolog evidence."})
    return filtered, by_query


def parse_gff_attributes(text: str) -> dict[str, str]:
    from urllib.parse import unquote
    attrs: dict[str, str] = {}
    for piece in text.strip().strip(";").split(";"):
        if not piece.strip():
            continue
        if "=" in piece:
            key, value = piece.split("=", 1)
        elif " " in piece:
            key, value = piece.strip().split(" ", 1)
            value = value.strip('"')
        else:
            continue
        attrs[key.strip()] = unquote(value.strip().strip('"'))
    return attrs


def _clean_feature_id(value: str | None) -> str:
    if not value:
        return ""
    value = str(value).split(",")[0].strip()
    return re.sub(r"^(?:gene|transcript|rna|mRNA):", "", value, flags=re.I)


def select_longest_transcripts(gff_path: Path) -> tuple[pd.DataFrame, dict[str, TranscriptRecord]]:
    transcripts: dict[str, dict[str, Any]] = {}
    gene_coords: dict[str, tuple[str, int, int, str]] = {}
    child_features: list[tuple[str, int, int, list[str]]] = []
    with gff_path.open("r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 9:
                continue
            chrom, _, feature, start, end, _, strand, _, attr_text = parts
            start_i, end_i = int(start), int(end)
            if strand not in {"+", "-"}:
                continue
            attrs = parse_gff_attributes(attr_text)
            low = feature.lower()
            if low == "gene":
                gid = _clean_feature_id(attrs.get("ID") or attrs.get("gene_id") or attrs.get("Name"))
                if gid:
                    gene_coords[gid] = (chrom, start_i, end_i, strand)
            elif low in {"mrna", "transcript", "rna"}:
                tid = _clean_feature_id(attrs.get("ID") or attrs.get("transcript_id"))
                gid = _clean_feature_id(attrs.get("Parent") or attrs.get("gene_id"))
                if tid and gid:
                    transcripts[tid] = {"gene_id": gid, "chrom": chrom, "strand": strand, "start": start_i, "end": end_i, "exon_length": 0, "cds_length": 0}
            elif low in {"exon", "cds"}:
                parent_value = attrs.get("Parent") or attrs.get("transcript_id") or ""
                parents = [_clean_feature_id(x) for x in str(parent_value).split(",") if _clean_feature_id(x)]
                child_features.append((low, start_i, end_i, parents))
    # Attach child lengths in a second pass so out-of-order GFF3 records work.
    for feature, start_i, end_i, parents in child_features:
        for tid in parents:
            if tid in transcripts:
                key = "exon_length" if feature == "exon" else "cds_length"
                transcripts[tid][key] += end_i - start_i + 1
    records: list[TranscriptRecord] = []
    for tid, rec in transcripts.items():
        records.append(TranscriptRecord(rec["gene_id"], tid, rec["chrom"], rec["strand"], rec["start"], rec["end"], int(rec["exon_length"] or (rec["end"] - rec["start"] + 1)), int(rec["cds_length"]), int(rec["end"] - rec["start"] + 1)))
    represented = {r.gene_id for r in records}
    for gid, (chrom, start, end, strand) in gene_coords.items():
        if gid not in represented:
            records.append(TranscriptRecord(gid, gid, chrom, strand, start, end, end - start + 1, 0, end - start + 1))
    if not records:
        raise InputBlocker("No genes/transcripts could be parsed from the GFF/GTF")
    df = pd.DataFrame([asdict(x) for x in records])
    selected: dict[str, TranscriptRecord] = {}
    for gene, group in df.groupby("gene_id"):
        row = group.sort_values(["exon_length", "cds_length", "transcript_span", "transcript_id"], ascending=[False, False, False, True]).iloc[0]
        selected[gene] = TranscriptRecord(**{f: row[f] for f in TranscriptRecord.__dataclass_fields__})
    return df, selected


def generate_promoters(gff_path: Path, upstream: int, downstream: int, out_dir: Path) -> tuple[pd.DataFrame, dict[str, PromoterRecord]]:
    all_transcripts, selected = select_longest_transcripts(gff_path)
    atomic_write_csv(out_dir / "all_transcripts_qc.csv", all_transcripts)
    promoters: list[PromoterRecord] = []
    for gene, tx in selected.items():
        tss = tx.start_1based if tx.strand == "+" else tx.end_1based
        tss0 = tss - 1
        if tx.strand == "+":
            start0, end0 = max(0, tss0 - upstream), tss0 + downstream
        else:
            start0, end0 = max(0, tss0 - downstream), tss0 + upstream
        promoters.append(PromoterRecord(gene, tx.transcript_id, tx.chrom, start0, end0, tx.strand, tss, tx.exon_length, tx.cds_length, "longest_transcript_by_exon_length_then_CDS_length_then_span"))
    p_df = pd.DataFrame([asdict(x) for x in promoters])
    atomic_write_csv(out_dir / "promoter_generation_qc.csv", p_df)
    bed = p_df[["chrom", "start_0based", "end_0based", "gene_id", "transcript_id", "strand"]].copy()
    bed["score"] = 0
    bed = bed[["chrom", "start_0based", "end_0based", "gene_id", "score", "strand", "transcript_id"]]
    bed.to_csv(out_dir / "promoters.bed", sep="\t", header=False, index=False)
    return p_df, {x.gene_id: x for x in promoters}


def expand_peak_manifest(path: Path, expected_genome_build: str | None = None, require_matching_build: bool = True) -> pd.DataFrame:
    df = read_table(path)
    normalized = normalize_columns(df)
    mapping: dict[str, str] = {}
    aliases = {
        "tf_gene_id": ["tfgeneid", "geneid", "tfgene", "tfid"],
        "tf_symbol": ["tfsymbol", "symbol", "tfname"],
        "peak_path": ["peakpath", "peakbed", "bed", "peaks"],
        "bigwig_path": ["bigwigpath", "bigwig", "bw", "signalpath"],
        "assay": ["assay", "datatype"],
        "replicate": ["replicate", "sampleid", "rep", "sample"],
        "genome_build": ["genomebuild", "assembly"],
    }
    for canonical, options in aliases.items():
        found = next((normalized[x] for x in options if x in normalized), None)
        if found:
            mapping[found] = canonical
    df = df.rename(columns=mapping)
    required = {"tf_gene_id", "tf_symbol", "peak_path", "bigwig_path"}
    if not required.issubset(df.columns):
        raise InputBlocker("Peak manifest is mandatory for binding analysis and must contain: geneID/tf_gene_id, TF symbol/tf_symbol, peak path/peak_path, and bigWig path/bigwig_path. Use repeated rows for replicates, or semicolon-separated paths with matching counts.")
    rows: list[dict[str, Any]] = []
    for i, row in df.iterrows():
        tf_gene = str(row["tf_gene_id"]).strip()
        tf_symbol = str(row["tf_symbol"]).strip()
        if not tf_gene or tf_gene.lower() == "nan" or not tf_symbol or tf_symbol.lower() == "nan":
            raise InputBlocker(f"Peak manifest row {i + 2}: tf_gene_id and tf_symbol must both be non-empty")
        peak_paths = [x.strip() for x in str(row["peak_path"]).split(";") if x.strip() and x.strip().lower() != "nan"]
        bw_paths = [x.strip() for x in str(row["bigwig_path"]).split(";") if x.strip() and x.strip().lower() != "nan"]
        if not peak_paths or len(peak_paths) != len(bw_paths):
            raise InputBlocker(f"Peak manifest row {i + 2}: peak and bigWig path counts differ or are empty")
        build_value = "" if pd.isna(row.get("genome_build", "")) else str(row.get("genome_build", "")).strip()
        if require_matching_build and expected_genome_build:
            if not build_value:
                raise InputBlocker(f"Peak manifest row {i + 2}: genome_build is required because binding.require_matching_genome_build=true")
            if build_value != str(expected_genome_build):
                raise InputBlocker(f"Peak manifest row {i + 2}: genome_build '{build_value}' does not match project.genome_build '{expected_genome_build}'")
        assay_raw = "" if pd.isna(row.get("assay", "")) else str(row.get("assay", "")).strip()
        assay_values = [x.strip() for x in assay_raw.split(";") if x.strip()] or ["DAP-seq/ChIP-seq"]
        replicate_raw = "" if pd.isna(row.get("replicate", "")) else str(row.get("replicate", "")).strip()
        replicate_values = [x.strip() for x in replicate_raw.split(";") if x.strip()]
        if len(assay_values) not in {1, len(peak_paths)}:
            raise InputBlocker(f"Peak manifest row {i + 2}: assay labels must be one value or match the number of peak/bigWig pairs")
        if replicate_values and len(replicate_values) not in {1, len(peak_paths)}:
            raise InputBlocker(f"Peak manifest row {i + 2}: replicate labels must be one value or match the number of peak/bigWig pairs")
        for j, (peak, bw) in enumerate(zip(peak_paths, bw_paths), start=1):
            p = ensure_file(peak, f"peak file row {i + 2}")
            b = ensure_file(bw, f"bigWig file row {i + 2}")
            lower_name = p.name.lower()
            if not (lower_name.endswith(".bed") or lower_name.endswith(".bed.gz") or lower_name.endswith(".narrowpeak") or lower_name.endswith(".narrowpeak.gz") or lower_name.endswith(".broadpeak") or lower_name.endswith(".broadpeak.gz")):
                raise InputBlocker(f"Peak file should be BED/narrowPeak/broadPeak (optionally gzipped): {p}")
            if b.suffix.lower() not in {".bw", ".bigwig"}:
                raise InputBlocker(f"Signal file must be .bw or .bigWig: {b}")
            assay_value = assay_values[0] if len(assay_values) == 1 else assay_values[j - 1]
            if not replicate_values:
                replicate_value = f"row{i + 2}_rep{j}"
            elif len(replicate_values) == 1 and len(peak_paths) > 1:
                replicate_value = f"{replicate_values[0]}_{j}"
            else:
                replicate_value = replicate_values[0] if len(replicate_values) == 1 else replicate_values[j - 1]
            rows.append({
                "tf_gene_id": tf_gene,
                "tf_symbol": tf_symbol,
                "peak_path": str(p),
                "bigwig_path": str(b),
                "assay": assay_value,
                "replicate": replicate_value,
                "genome_build": build_value,
            })
    out = pd.DataFrame(rows).drop_duplicates(["tf_gene_id", "replicate", "peak_path", "bigwig_path"])
    return out


def read_bed_intervals(path: Path) -> pd.DataFrame:
    raw = pd.read_csv(path, sep="\t", comment="#", header=None, engine="python")
    if raw.shape[1] < 3:
        raise InputBlocker(f"BED-like file must contain at least 3 columns: {path}")
    names = ["chrom", "start", "end", "name", "score", "strand"]
    for i, name in enumerate(names):
        raw[i] = raw[i] if i in raw.columns else np.nan
    df = raw.iloc[:, :6].copy()
    df.columns = names
    df = df.dropna(subset=["chrom", "start", "end"])
    df["start"] = pd.to_numeric(df["start"], errors="coerce")
    df["end"] = pd.to_numeric(df["end"], errors="coerce")
    df = df.dropna(subset=["start", "end"])
    df["start"] = df["start"].astype(int)
    df["end"] = df["end"].astype(int)
    if (df["start"] < 0).any() or (df["end"] <= df["start"]).any():
        raise InputBlocker(f"Malformed BED coordinates in {path}")
    return df


def preflight_peak_manifest(
    peak_manifest: pd.DataFrame,
    promoter_map: Mapping[str, PromoterRecord],
    out_dir: Path,
) -> pd.DataFrame:
    """Validate BED/bigWig readability and chromosome compatibility per row."""
    import pyBigWig
    promoter_chroms = {str(x.chrom) for x in promoter_map.values()}
    rows: list[dict[str, Any]] = []
    for row in peak_manifest.itertuples(index=False):
        record = row._asdict(); errors: list[str] = []
        bed_chroms: set[str] = set(); bw_chroms: set[str] = set()
        try:
            bed = read_bed_intervals(Path(row.peak_path)); bed_chroms = set(bed["chrom"].astype(str))
            if bed.empty: errors.append("peak_file_has_no_valid_intervals")
        except Exception as exc: errors.append(f"peak_error:{exc}")
        try:
            with pyBigWig.open(str(row.bigwig_path)) as bw:
                if bw is None: raise ValueError("pyBigWig returned no handle")
                bw_chroms = set(map(str, bw.chroms().keys()))
                if not bw_chroms: errors.append("bigwig_has_no_chromosomes")
        except Exception as exc: errors.append(f"bigwig_error:{exc}")
        if bed_chroms and not (bed_chroms & promoter_chroms): errors.append("peak_chromosomes_do_not_overlap_GFF")
        if bw_chroms and not (bw_chroms & promoter_chroms): errors.append("bigwig_chromosomes_do_not_overlap_GFF")
        if bed_chroms and bw_chroms and not (bed_chroms & bw_chroms): errors.append("peak_and_bigwig_chromosomes_do_not_overlap")
        rows.append({**record, "preflight_status": "valid" if not errors else "invalid", "preflight_error": ";".join(errors),
                     "peak_chromosome_count": len(bed_chroms), "bigwig_chromosome_count": len(bw_chroms),
                     "peak_GFF_chromosome_overlap_count": len(bed_chroms & promoter_chroms),
                     "bigwig_GFF_chromosome_overlap_count": len(bw_chroms & promoter_chroms)})
    qc = pd.DataFrame(rows); out_dir.mkdir(parents=True, exist_ok=True); atomic_write_csv(out_dir / "peak_bigwig_preflight.csv", qc)
    valid = qc[qc["preflight_status"] == "valid"].copy()
    if valid.empty:
        raise InputBlocker("No peak/bigWig manifest rows passed readability and chromosome compatibility checks against the selected GFF/GTF")
    return valid.drop(columns=["preflight_status", "preflight_error", "peak_chromosome_count", "bigwig_chromosome_count", "peak_GFF_chromosome_overlap_count", "bigwig_GFF_chromosome_overlap_count"])


def summarize_bigwig(path: Path, chrom: str, start: int, end: int) -> tuple[float | None, float | None, float | None]:
    import pyBigWig
    with pyBigWig.open(str(path)) as bw:
        chroms = bw.chroms()
        if chrom not in chroms:
            return None, None, None
        start = max(0, start)
        end = min(end, chroms[chrom])
        if end <= start:
            return None, None, None
        vals = bw.stats(chrom, start, end, type="mean", nBins=min(200, max(1, end - start)))
        arr = np.asarray([np.nan if x is None else x for x in vals], dtype=float)
        if np.isnan(arr).all():
            return None, None, None
        return float(np.nanmean(arr)), float(np.nanmax(arr)), float(np.nanquantile(arr, .995))


def validate_binding(
    edges: pd.DataFrame,
    promoter_map: Mapping[str, PromoterRecord],
    peak_manifest: pd.DataFrame,
    homologs: Mapping[str, list[HomologHit]],
    annotation: pd.DataFrame,
    out_dir: Path,
) -> pd.DataFrame:
    annotation_symbol = dict(zip(annotation["gene_id"].astype(str), annotation["symbol"].astype(str))) if not annotation.empty else {}
    peak_by_gene = {str(gene): group.copy() for gene, group in peak_manifest.groupby("tf_gene_id")}
    peak_by_symbol = {str(symbol): group.copy() for symbol, group in peak_manifest.groupby("tf_symbol")}
    bed_cache: dict[str, pd.DataFrame] = {}
    rows: list[dict[str, Any]] = []

    def empty_record(edge_dict: dict[str, Any], level: str = "not_testable") -> dict[str, Any]:
        return {**edge_dict, "binding_validated": False, "validation_source": level, "validation_level": level,
                "validated_tf_gene_id": "", "validated_tf_symbol": "", "homolog_identity": np.nan,
                "homolog_support_count": 0, "direct_support_count": 0, "peak_replicate_support": 0,
                "direct_supporting_tf_ids": "", "direct_supporting_replicates": "",
                "homolog_supporting_tf_ids": "", "homolog_supporting_identities": "",
                "homolog_supporting_replicates": "", "highest_homolog_identity": np.nan,
                "peak_count": 0, "max_peak_score": np.nan, "mean_bigwig_signal": np.nan,
                "max_bigwig_signal": np.nan, "nearest_peak_distance": np.nan,
                "supporting_track_rows_json": "[]"}

    for edge in edges.itertuples(index=False):
        edge_dict = edge._asdict()
        tf = str(edge.TF)
        target = str(edge.target_gene_id)
        promoter = promoter_map.get(target)
        if promoter is None:
            rows.append(empty_record(edge_dict))
            continue
        candidates: list[tuple[str, str, pd.DataFrame, float | None]] = []
        direct = peak_by_gene.get(tf)
        if direct is None:
            direct = peak_by_symbol.get(tf)
        if direct is None and annotation_symbol.get(tf):
            direct = peak_by_symbol.get(annotation_symbol[tf])
        if direct is not None:
            candidates.append(("direct_same_tf", tf, direct, 100.0))
        for hit in homologs.get(tf, []):
            if hit.pident < 60.0:
                continue
            hdf = peak_by_gene.get(hit.subject_gene_id)
            if hdf is None and annotation_symbol.get(hit.subject_gene_id):
                hdf = peak_by_symbol.get(annotation_symbol[hit.subject_gene_id])
            if hdf is not None:
                candidates.append(("same_species_homolog", hit.subject_gene_id, hdf, hit.pident))
        candidate_rows: list[dict[str, Any]] = []
        for source, validated_tf, files, identity in candidates:
            for file_row in files.itertuples(index=False):
                try:
                    if file_row.peak_path not in bed_cache:
                        bed_cache[file_row.peak_path] = read_bed_intervals(Path(file_row.peak_path))
                    bed = bed_cache[file_row.peak_path]
                    chrom_bed = bed[bed["chrom"].astype(str) == promoter.chrom]
                    overlap = chrom_bed[(chrom_bed["start"] < promoter.end_0based) & (chrom_bed["end"] > promoter.start_0based)].copy()
                    if overlap.empty:
                        distances = np.minimum(np.abs(chrom_bed["end"].to_numpy() - promoter.start_0based), np.abs(chrom_bed["start"].to_numpy() - promoter.end_0based)) if not chrom_bed.empty else np.array([])
                        nearest, peak_count, max_peak_score = (float(distances.min()) if distances.size else np.nan), 0, np.nan
                    else:
                        score = pd.to_numeric(overlap["score"], errors="coerce")
                        nearest, peak_count = 0.0, int(len(overlap))
                        max_peak_score = float(score.max()) if score.notna().any() else np.nan
                    mean_signal, max_signal, q995 = summarize_bigwig(Path(file_row.bigwig_path), promoter.chrom, promoter.start_0based, promoter.end_0based)
                    status, error = "tested", ""
                except Exception as exc:
                    nearest = peak_count = max_peak_score = mean_signal = max_signal = q995 = np.nan
                    status, error = "track_input_error", str(exc)
                candidate_rows.append({"source": source, "validated_tf_gene_id": validated_tf, "validated_tf_symbol": file_row.tf_symbol,
                                       "homolog_identity": identity, "replicate": file_row.replicate, "assay": file_row.assay,
                                       "peak_path": file_row.peak_path, "bigwig_path": file_row.bigwig_path,
                                       "peak_count": 0 if pd.isna(peak_count) else int(peak_count), "max_peak_score": max_peak_score,
                                       "mean_bigwig_signal": mean_signal, "max_bigwig_signal": max_signal, "bigwig_q995": q995,
                                       "nearest_peak_distance": nearest, "input_status": status, "input_error": error})
        if not candidate_rows:
            rows.append(empty_record(edge_dict))
            continue
        candidates_df = pd.DataFrame(candidate_rows)
        candidates_df["priority"] = candidates_df["source"].map({"direct_same_tf": 0, "same_species_homolog": 1})
        candidates_df["has_peak"] = candidates_df["peak_count"] > 0
        candidates_df["has_signal"] = candidates_df["max_bigwig_signal"].fillna(0) > 0
        # Direct validated evidence always outranks homolog evidence, regardless of signal magnitude.
        candidates_df = candidates_df.sort_values(["has_peak", "priority", "homolog_identity", "peak_count", "max_bigwig_signal"], ascending=[False, True, False, False, False])
        best = candidates_df.iloc[0]
        has_peak, has_signal = bool(best["has_peak"]), bool(best["has_signal"])
        if has_peak and has_signal: level = "validated_peak_and_signal"
        elif has_peak: level = "validated_peak"
        elif has_signal: level = "signal_support_only"
        elif pd.notna(best["nearest_peak_distance"]): level = "nearest_peak_only"
        elif (candidates_df["input_status"] == "track_input_error").all(): level = "input_error"
        else: level = "not_validated"
        direct_supported_df = candidates_df[(candidates_df["source"] == "direct_same_tf") & candidates_df["has_peak"]]
        homolog_supported_df = candidates_df[(candidates_df["source"] == "same_species_homolog") & candidates_df["has_peak"]]
        direct_ids = sorted(direct_supported_df["validated_tf_gene_id"].astype(str).unique())
        homolog_ids = sorted(homolog_supported_df["validated_tf_gene_id"].astype(str).unique())
        homolog_identity_map = homolog_supported_df.groupby("validated_tf_gene_id")["homolog_identity"].max().sort_values(ascending=False)
        rows.append({**edge_dict,
            "binding_validated": has_peak,
            "validation_source": best["source"] if has_peak or has_signal else "tested_not_validated",
            "validation_level": level,
            "validated_tf_gene_id": best["validated_tf_gene_id"], "validated_tf_symbol": best["validated_tf_symbol"],
            "homolog_identity": best["homolog_identity"] if best["source"] == "same_species_homolog" else np.nan,
            "homolog_support_count": len(homolog_ids), "direct_support_count": len(direct_ids),
            "peak_replicate_support": int(candidates_df[candidates_df["has_peak"]][["validated_tf_gene_id", "replicate"]].drop_duplicates().shape[0]),
            "direct_supporting_tf_ids": ";".join(direct_ids),
            "direct_supporting_replicates": ";".join(sorted(direct_supported_df["replicate"].astype(str).unique())),
            "homolog_supporting_tf_ids": ";".join(homolog_ids),
            "homolog_supporting_identities": ";".join(f"{gene}:{identity:.3f}" for gene, identity in homolog_identity_map.items()),
            "homolog_supporting_replicates": ";".join(sorted(homolog_supported_df["replicate"].astype(str).unique())),
            "highest_homolog_identity": float(homolog_supported_df["homolog_identity"].max()) if not homolog_supported_df.empty else np.nan,
            "peak_count": int(candidates_df["peak_count"].sum()), "max_peak_score": candidates_df["max_peak_score"].max(),
            "mean_bigwig_signal": candidates_df["mean_bigwig_signal"].mean(), "max_bigwig_signal": candidates_df["max_bigwig_signal"].max(),
            "nearest_peak_distance": candidates_df["nearest_peak_distance"].min(),
            "supporting_track_rows_json": candidates_df.drop(columns=["priority"]).to_json(orient="records")})
    result = pd.DataFrame(rows)
    out_dir.mkdir(parents=True, exist_ok=True)
    atomic_write_csv(out_dir / "binding_validation_integrated.csv", result)
    return result


def plot_tf_summary(summary: pd.DataFrame, validation: pd.DataFrame, out_dir: Path, contrast_color: str = COLORS["blue"], top_n: int = 20) -> None:
    configure_plotting()
    import matplotlib.pyplot as plt
    out_dir.mkdir(parents=True, exist_ok=True)
    integrated = summary.copy()
    if not validation.empty:
        v = validation.copy()
        v["direct_edge"] = pd.to_numeric(v.get("direct_support_count", 0), errors="coerce").fillna(0) > 0
        v["homolog_only_edge"] = (~v["direct_edge"]) & (pd.to_numeric(v.get("homolog_support_count", 0), errors="coerce").fillna(0) > 0)
        evidence = v.groupby("TF", as_index=False).agg(
            binding_validated_targets=("binding_validated", "sum"),
            direct_validated_targets=("direct_edge", "sum"),
            homolog_only_validated_targets=("homolog_only_edge", "sum"),
            highest_homolog_identity=("highest_homolog_identity", "max") if "highest_homolog_identity" in v.columns else ("homolog_identity", "max"),
        )
        integrated = integrated.merge(evidence, on="TF", how="left")
    for col in ("binding_validated_targets", "direct_validated_targets", "homolog_only_validated_targets"):
        if col not in integrated:
            integrated[col] = 0
        integrated[col] = integrated[col].fillna(0).astype(int)
    integrated = decorate_gene_columns(integrated)
    integrated["TF_label"] = integrated["TF"].map(display_gene_label)
    atomic_write_csv(out_dir / "SHAP_feature_summary_with_binding_validation.csv", integrated)

    def mark(ax: Any, x: float, y: float, row: Any) -> None:
        off = (ax.get_xlim()[1] - ax.get_xlim()[0]) * .025
        if row.direct_validated_targets > 0:
            ax.scatter([x + off], [y], marker="*", s=34, color=COLORS["gold"], edgecolor=COLORS["near_black"], lw=.3, zorder=4, clip_on=False)
        elif row.homolog_only_validated_targets > 0:
            ax.scatter([x + off], [y], marker="D", s=12, color=COLORS["purple"], lw=0, zorder=4, clip_on=False)

    plot_df = integrated.nlargest(top_n, "sum_abs_shap").sort_values("sum_abs_shap")
    fig, ax = plt.subplots(figsize=(3.4, max(2.2, .15 * len(plot_df) + .9)))
    bars = ax.barh(plot_df["TF_label"], plot_df["sum_abs_shap"], color=contrast_color, height=.68, edgecolor=COLORS["near_black"], lw=.4)
    for bar, row in zip(bars, plot_df.itertuples()):
        mark(ax, bar.get_width(), bar.get_y() + bar.get_height()/2, row)
    ax.set(xlabel="Total absolute out-of-fold SHAP", title="Ranked TFs by total absolute SHAP")
    ax.text(0, -.14, "Gold star: direct-TF peak support; purple diamond: same-species homolog peak support", transform=ax.transAxes, fontsize=5.5, color="#555555")
    ax.text(-0.12, 1.02, "A", transform=ax.transAxes, fontweight="bold")
    save_figure(fig, out_dir / "top_TFs_sum_abs_SHAP.pdf", plot_df)
    plt.close(fig)

    count_df = integrated.nlargest(top_n, "target_count_top20pct").sort_values("target_count_top20pct")
    fig, ax = plt.subplots(figsize=(3.4, max(2.2, .15 * len(count_df) + .9)))
    bars = ax.barh(count_df["TF_label"], count_df["target_count_top20pct"], color=COLORS["teal"], height=.68, edgecolor=COLORS["near_black"], lw=.4)
    for bar, row in zip(bars, count_df.itertuples()):
        mark(ax, bar.get_width(), bar.get_y() + bar.get_height()/2, row)
    ax.set(xlabel="Retained target count", title="Ranked TFs by retained target count")
    ax.text(0, -.14, "Gold star: direct-TF peak support; purple diamond: same-species homolog peak support", transform=ax.transAxes, fontsize=5.5, color="#555555")
    ax.text(-0.12, 1.02, "B", transform=ax.transAxes, fontweight="bold")
    save_figure(fig, out_dir / "top_TFs_target_count.pdf", count_df)
    plt.close(fig)

    dot_df = integrated.nlargest(top_n, "sum_abs_shap").sort_values("sum_abs_shap").copy()
    dot_df["log2_total_abs_shap_plus_1"] = np.log2(dot_df["sum_abs_shap"] + 1)
    fig, ax = plt.subplots(figsize=(3.8, max(2.2, .15 * len(dot_df) + .9)))
    sizes = 25 + 8 * np.sqrt(dot_df["target_count_top20pct"].clip(lower=1))
    scatter = ax.scatter(dot_df["log2_total_abs_shap_plus_1"], dot_df["TF_label"], s=sizes * .45, c=dot_df["sum_abs_shap"], cmap="Blues", edgecolor=COLORS["blue"], lw=.4)
    for row in dot_df.itertuples():
        mark(ax, row.log2_total_abs_shap_plus_1, row.TF_label, row)
    fig.colorbar(scatter, ax=ax, label="Total absolute SHAP")
    ax.set(xlabel="log2(Total absolute SHAP + 1)", title="Ranked TF contribution magnitude")
    ax.text(-0.12, 1.02, "C", transform=ax.transAxes, fontweight="bold")
    save_figure(fig, out_dir / "top_TFs_SHAP_dotplot.pdf", dot_df)
    plt.close(fig)


def plot_target_lollipop(target: str, table: pd.DataFrame, out_path: Path, label_map: Mapping[str, str], top_n: int = 20) -> None:
    configure_plotting()
    import matplotlib.pyplot as plt
    data = table[table["target_gene_id"].astype(str) == target].nsmallest(top_n, "target_tf_rank").copy()
    if data.empty: return
    data["tf_label"] = data["TF"].map(lambda x: label_gene(str(x), label_map))
    data["direct_validation"] = pd.to_numeric(data.get("direct_support_count", 0), errors="coerce").fillna(0) > 0
    data["homolog_only_validation"] = (~data["direct_validation"]) & (pd.to_numeric(data.get("homolog_support_count", 0), errors="coerce").fillna(0) > 0)
    data = data.sort_values("shap_value")
    fig, ax = plt.subplots(figsize=(3.4, max(2.0, .15 * len(data) + .9)))
    y = np.arange(len(data)); ax.hlines(y, 0, data["shap_value"], color="#BBBBBB", lw=1)
    edgecolors = np.where(data["direct_validation"], COLORS["gold"], np.where(data["homolog_only_validation"], COLORS["purple"], "none"))
    ax.scatter(data["shap_value"], y, s=18 + 10 * data["binding_validated"].astype(int), color=np.where(data["shap_value"] >= 0, COLORS["blue"], COLORS["red"]), edgecolor=edgecolors, linewidth=1.3)
    ax.axvline(0, color="#777777", lw=.8); ax.set_yticks(y, data["tf_label"])
    ax.set(xlabel="Signed out-of-fold SHAP contribution", title=f"Regulatory contributions for {label_gene(target, label_map)}")
    ax.text(.01, -.20, "Positive/negative SHAP means toward/away from the focal class, not activation/repression. Gold outline: direct TF; purple outline: homolog.", transform=ax.transAxes, fontsize=5.5, color="#555555")
    save_figure(fig, out_path, data); plt.close(fig)


def parse_pathway_file(path: Path, target_col: str, pathway_col: str) -> pd.DataFrame:
    df = read_table(path)
    if target_col not in df.columns:
        raise InputBlocker(f"Pathway file lacks target column '{target_col}'")
    if pathway_col not in df.columns:
        df[pathway_col] = "focus_targets"
    out = df[[target_col, pathway_col]].rename(columns={target_col: "gene_id", pathway_col: "pathway"})
    out["gene_id"] = out["gene_id"].astype(str)
    return out.drop_duplicates()


def analyze_targets_pathways(integrated_edges: pd.DataFrame, manifest: Mapping[str, Any], annotation: pd.DataFrame, out_dir: Path) -> None:
    focus = manifest.get("focus", {})
    if not focus.get("target_or_pathway_file"):
        return
    path = ensure_file(focus["target_or_pathway_file"], "target/pathway file")
    pathways = parse_pathway_file(path, focus.get("target_column", "gene_id"), focus.get("pathway_column", "pathway"))
    label_map = dict(zip(annotation["gene_id"].astype(str), annotation["symbol"].astype(str))) if not annotation.empty else {}
    for target in pathways["gene_id"].unique():
        tdir = out_dir / "targets" / re.sub(r"[^A-Za-z0-9_.-]+", "_", target)
        tdir.mkdir(parents=True, exist_ok=True)
        table = integrated_edges[integrated_edges["target_gene_id"].astype(str) == target].sort_values("target_tf_rank")
        atomic_write_csv(tdir / "all_TF_contributions.csv", table)
        plot_target_lollipop(target, table, tdir / "top_TF_lollipop.pdf", label_map)
    configure_plotting()
    import matplotlib.pyplot as plt
    for pathway, pgenes in pathways.groupby("pathway"):
        genes = set(pgenes["gene_id"])
        table = integrated_edges[integrated_edges["target_gene_id"].isin(genes)].copy()
        pdir = out_dir / "pathways" / re.sub(r"[^A-Za-z0-9_.-]+", "_", str(pathway))
        pdir.mkdir(parents=True, exist_ok=True)
        atomic_write_csv(pdir / "pathway_edges.csv", table)
        if table.empty:
            continue
        table["direct_validation"] = pd.to_numeric(table.get("direct_support_count", 0), errors="coerce").fillna(0) > 0
        table["homolog_only_validation"] = (~table["direct_validation"]) & (pd.to_numeric(table.get("homolog_support_count", 0), errors="coerce").fillna(0) > 0)
        tf_sum = table.groupby("TF", as_index=False).agg(sum_abs_shap=("abs_shap", "sum"), sum_signed_shap=("shap_value", "sum"), target_count=("target_gene_id", "nunique"), binding_validated_targets=("binding_validated", "sum"), direct_validated_targets=("direct_validation", "sum"), homolog_only_validated_targets=("homolog_only_validation", "sum")).nlargest(20, "sum_abs_shap").sort_values("sum_abs_shap")
        tf_sum = decorate_gene_columns(tf_sum)
        tf_sum["TF_label"] = tf_sum["TF"].map(display_gene_label)
        fig, ax = plt.subplots(figsize=(6.4, max(4.0, .30 * len(tf_sum) + 1.4)))
        ax.barh(tf_sum["TF_label"], tf_sum["sum_abs_shap"], color=COLORS["teal"])
        for y, row in enumerate(tf_sum.itertuples()):
            if row.direct_validated_targets:
                ax.text(row.sum_abs_shap, y, "★", color=COLORS["gold"], va="center")
            elif row.homolog_only_validated_targets:
                ax.text(row.sum_abs_shap, y, "◆", color=COLORS["purple"], va="center")
        ax.set(xlabel="Pathway total absolute SHAP", title=f"Ranked TFs for {pathway}")
        save_figure(fig, pdir / "pathway_TF_summary.pdf", tf_sum)
        plt.close(fig)
        heat = table[table["TF"].isin(tf_sum["TF"])].pivot_table(index="target_gene_id", columns="TF", values="shap_value", aggfunc="sum", fill_value=0)
        if heat.shape[0] and heat.shape[1]:
            fig, ax = plt.subplots(figsize=(max(5, .28 * heat.shape[1] + 2), max(4, .22 * heat.shape[0] + 2)))
            im = ax.imshow(heat.to_numpy(), aspect="auto", cmap="coolwarm")
            ax.set_xticks(range(heat.shape[1]), [display_gene_label(x) for x in heat.columns], rotation=90)
            ax.set_yticks(range(heat.shape[0]), [label_gene(x, label_map) for x in heat.index])
            ax.set_title(f"TF contributions across {pathway}")
            fig.colorbar(im, ax=ax, label="Signed SHAP")
            save_figure(fig, pdir / "pathway_SHAP_heatmap.pdf", heat.reset_index())
            plt.close(fig)
        count_df = tf_sum.sort_values("target_count")
        fig, ax = plt.subplots(figsize=(3.4, max(2.2, .15 * len(count_df) + .9)))
        ax.barh(count_df["TF_label"], count_df["target_count"], color=COLORS["purple"])
        ax.set(xlabel="Pathway target count", title=f"TF target counts for {pathway}")
        save_figure(fig, pdir / "pathway_TF_target_count.pdf", count_df)
        plt.close(fig)
        network_edges = table[table["TF"].isin(tf_sum.nlargest(10, "sum_abs_shap")["TF"])].nlargest(int(focus.get("max_network_edges", 40)), "abs_shap").copy()
        if not network_edges.empty:
            import networkx as nx
            graph = nx.DiGraph()
            for row in network_edges.itertuples():
                tf_node = "TF::" + str(row.TF)
                target_node = "TARGET::" + str(row.target_gene_id)
                graph.add_node(tf_node, node_type="TF", display_label=display_gene_label(row.TF))
                graph.add_node(target_node, node_type="target", display_label=display_gene_label(row.target_gene_id))
                graph.add_edge(tf_node, target_node, weight=float(row.abs_shap), evidence="direct" if bool(row.direct_validation) else ("homolog" if bool(row.homolog_only_validation) else "none"))
            tf_nodes = [n for n, d in graph.nodes(data=True) if d["node_type"] == "TF"]
            target_nodes = [n for n, d in graph.nodes(data=True) if d["node_type"] == "target"]
            pos = {}
            for i, node in enumerate(tf_nodes): pos[node] = (0, i - (len(tf_nodes)-1)/2)
            for i, node in enumerate(target_nodes): pos[node] = (1, i - (len(target_nodes)-1)/2)
            fig, ax = plt.subplots(figsize=(8.0, max(5.0, .16 * max(len(tf_nodes), len(target_nodes)) + 2)))
            nx.draw_networkx_nodes(graph, pos, nodelist=tf_nodes, node_color=COLORS["blue"], node_size=260, ax=ax)
            nx.draw_networkx_nodes(graph, pos, nodelist=target_nodes, node_color=COLORS["light_blue"], node_size=150, ax=ax)
            direct_edges = [(u, v) for u, v, d in graph.edges(data=True) if d["evidence"] == "direct"]
            homolog_edges = [(u, v) for u, v, d in graph.edges(data=True) if d["evidence"] == "homolog"]
            other_edges = [(u, v) for u, v, d in graph.edges(data=True) if d["evidence"] == "none"]
            nx.draw_networkx_edges(graph, pos, edgelist=other_edges, alpha=.35, width=.6, arrows=False, ax=ax)
            nx.draw_networkx_edges(graph, pos, edgelist=homolog_edges, edge_color=COLORS["purple"], alpha=.75, width=1.0, arrows=False, ax=ax)
            nx.draw_networkx_edges(graph, pos, edgelist=direct_edges, edge_color=COLORS["gold"], alpha=.85, width=1.2, arrows=False, ax=ax)
            nx.draw_networkx_labels(graph, pos, labels={n: d.get("display_label", n) for n, d in graph.nodes(data=True)}, font_size=7, ax=ax)
            ax.set_title(f"TF–target edge display for {pathway}")
            ax.axis("off")
            save_figure(fig, pdir / "pathway_TF_target_network.pdf", network_edges)
            plt.close(fig)
        expression_path = focus.get("expression_table")
        if expression_path:
            expr = read_table(ensure_file(expression_path, "focus.expression_table"))
            gene_col = focus.get("expression_gene_column", str(expr.columns[0]))
            if gene_col not in expr.columns:
                raise InputBlocker(f"Expression table lacks gene column '{gene_col}'")
            expr = expr.set_index(gene_col).apply(pd.to_numeric, errors="coerce")
            display_genes = [x for x in list(tf_sum.nlargest(10, "sum_abs_shap")["TF"]) + list(genes) if x in expr.index]
            if display_genes:
                e = np.log2(expr.loc[display_genes].fillna(0) + 1)
                e = e.sub(e.mean(axis=1), axis=0).div(e.std(axis=1).replace(0, 1), axis=0)
                fig, ax = plt.subplots(figsize=(max(5, .35 * e.shape[1] + 2), max(4, .22 * e.shape[0] + 2)))
                im = ax.imshow(e.to_numpy(), aspect="auto", cmap="coolwarm", vmin=-2.5, vmax=2.5)
                ax.set_xticks(range(e.shape[1]), e.columns, rotation=90)
                ax.set_yticks(range(e.shape[0]), [label_gene(str(x), label_map) for x in e.index])
                ax.set_title(f"Expression context for {pathway}")
                fig.colorbar(im, ax=ax, label="Row z-score of log2(expression + 1)")
                save_figure(fig, pdir / "pathway_expression_heatmap.pdf", e.reset_index(names="gene_id"))
                plt.close(fig)


def parse_obo_bp(obo_path: Path) -> tuple[dict[str, str], dict[str, list[tuple[str, str]]], dict[str, str]]:
    names: dict[str, str] = {}
    parents: dict[str, list[tuple[str, str]]] = defaultdict(list)
    namespace: dict[str, str] = {}
    current: dict[str, Any] = {}
    obsolete = False
    def commit() -> None:
        nonlocal current, obsolete
        term = current.get("id")
        if term and not obsolete:
            names[term] = current.get("name", term)
            namespace[term] = current.get("namespace", "")
            parents[term].extend(current.get("parents", []))
        current = {}
        obsolete = False
    with obo_path.open("r", encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            line = raw.strip()
            if line == "[Term]":
                commit()
            elif not line or line.startswith("!"):
                continue
            elif line.startswith("id: GO:"):
                current["id"] = line.split("id:", 1)[1].strip()
            elif line.startswith("name:"):
                current["name"] = line.split("name:", 1)[1].strip()
            elif line.startswith("namespace:"):
                current["namespace"] = line.split("namespace:", 1)[1].strip()
            elif line.startswith("is_a:"):
                parent = line.split("is_a:", 1)[1].split("!")[0].strip()
                current.setdefault("parents", []).append((parent, "is_a"))
            elif line.startswith("relationship: part_of"):
                parent = line.split("relationship: part_of", 1)[1].split("!")[0].strip()
                current.setdefault("parents", []).append((parent, "part_of"))
            elif line == "is_obsolete: true":
                obsolete = True
    commit()
    bp = {term for term, ns in namespace.items() if ns == "biological_process"}
    return {k: v for k, v in names.items() if k in bp}, {k: [(p, rel) for p, rel in vals if p in bp] for k, vals in parents.items() if k in bp}, {k: v for k, v in namespace.items() if k in bp}


def wang_semantic_values(term: str, parents: Mapping[str, list[tuple[str, str]]], is_a_weight: float = .8, part_of_weight: float = .6) -> dict[str, float]:
    values = {term: 1.0}
    queue = deque([term])
    while queue:
        child = queue.popleft()
        child_value = values[child]
        for parent, relation in parents.get(child, []):
            weight = is_a_weight if relation == "is_a" else part_of_weight
            contribution = child_value * weight
            if contribution > values.get(parent, 0.0):
                values[parent] = contribution
                queue.append(parent)
    return values


def wang_similarity(
    term_a: str,
    term_b: str,
    parents: Mapping[str, list[tuple[str, str]]],
    cache: dict[tuple[str, float, float], dict[str, float]] | None = None,
    is_a_weight: float = .8,
    part_of_weight: float = .6,
) -> float:
    cache = cache if cache is not None else {}
    key_a = (term_a, is_a_weight, part_of_weight)
    key_b = (term_b, is_a_weight, part_of_weight)
    va = cache.setdefault(key_a, wang_semantic_values(term_a, parents, is_a_weight, part_of_weight))
    vb = cache.setdefault(key_b, wang_semantic_values(term_b, parents, is_a_weight, part_of_weight))
    common = set(va) & set(vb)
    denom = sum(va.values()) + sum(vb.values())
    return (sum(va[x] + vb[x] for x in common) / denom) if denom else 0.0


def go_ora(target_genes: set[str], universe_genes: set[str], annotation: pd.DataFrame, obo_path: Path, cfg: Mapping[str, Any]) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    """BP over-representation with ancestor propagation and local Wang simplification.

    GOATOOLS is used only as a parser dependency elsewhere; this implementation
    does not assume that GOATOOLS provides Wang semantic similarity.
    """
    names, parents, _ = parse_obo_bp(obo_path)
    sep = cfg.get("go_separator", ";")
    ancestor_cache: dict[str, set[str]] = {}
    def ancestors(term: str) -> set[str]:
        if term in ancestor_cache:
            return ancestor_cache[term]
        seen = {term}
        queue = deque([term])
        while queue:
            child = queue.popleft()
            for parent, _relation in parents.get(child, []):
                if parent not in seen:
                    seen.add(parent); queue.append(parent)
        ancestor_cache[term] = seen
        return seen
    gene_terms: dict[str, set[str]] = {}
    for row in annotation.itertuples():
        direct = {x.strip() for x in str(row.go_terms).split(sep) if x.strip() in names}
        propagated: set[str] = set()
        for term in direct:
            propagated.update(ancestors(term))
        if propagated:
            gene_terms[str(row.gene_id)] = propagated
    universe = set(map(str, universe_genes)) & set(gene_terms)
    targets = set(map(str, target_genes)) & universe
    term_genes: dict[str, set[str]] = defaultdict(set)
    for gene in universe:
        for term in gene_terms[gene]:
            term_genes[term].add(gene)
    N, n = len(universe), len(targets)
    rows: list[dict[str, Any]] = []
    if N == 0 or n == 0:
        return pd.DataFrame(), pd.DataFrame(), pd.DataFrame()
    for term, genes in term_genes.items():
        K = len(genes); overlap = targets & genes; k = len(overlap)
        if K < int(cfg.get("min_term_size", 5)) or K > int(cfg.get("max_term_size", 500)) or k < int(cfg.get("min_overlap", 3)):
            continue
        pvalue = float(hypergeom.sf(k - 1, N, K, n))
        rows.append({"GO_ID": term, "Description": names.get(term, term), "ontology": "BP", "gene_count": k, "term_size": K,
                     "target_size": n, "universe_size": N, "gene_ratio": k / n, "background_ratio": K / N,
                     "pvalue": pvalue, "genes": ";".join(sorted(overlap)), "annotation_propagated_to_ancestors": True})
    all_df = pd.DataFrame(rows)
    if all_df.empty:
        return all_df, all_df.copy(), pd.DataFrame()
    all_df["padj"] = multipletests(all_df["pvalue"], method="fdr_bh")[1]
    all_df = all_df.sort_values(["padj", "pvalue", "gene_ratio", "GO_ID"], ascending=[True, True, False, True])
    selected = all_df[all_df["padj"] < float(cfg.get("qvalue_threshold", .05))].copy()
    if selected.empty:
        return all_df, selected, pd.DataFrame()
    cache: dict[tuple[str, float, float], dict[str, float]] = {}
    threshold = float(cfg.get("wang_similarity_threshold", .70))
    is_a_weight = float(cfg.get("wang_is_a_weight", .80))
    part_of_weight = float(cfg.get("wang_part_of_weight", .60))
    terms = sorted(selected["GO_ID"].astype(str))
    adjacency: dict[str, set[str]] = {t: set() for t in terms}
    pair_rows: list[dict[str, Any]] = []
    for i, a in enumerate(terms):
        for b in terms[i + 1:]:
            sim = wang_similarity(a, b, parents, cache, is_a_weight, part_of_weight)
            if sim >= threshold:
                adjacency[a].add(b); adjacency[b].add(a)
            pair_rows.append({"term_a": a, "term_b": b, "wang_similarity": sim, "above_threshold": sim >= threshold})
    # Deterministic connected components make transitive redundancy explicit.
    components: list[list[str]] = []
    unseen = set(terms)
    while unseen:
        seed = min(unseen); unseen.remove(seed); component = {seed}; queue = deque([seed])
        while queue:
            node = queue.popleft()
            for neighbour in sorted(adjacency[node]):
                if neighbour in unseen:
                    unseen.remove(neighbour); component.add(neighbour); queue.append(neighbour)
        components.append(sorted(component))
    depth_cache: dict[str, int] = {}
    def depth(term: str, trail: set[str] | None = None) -> int:
        if term in depth_cache: return depth_cache[term]
        trail = set() if trail is None else set(trail)
        if term in trail: return 0
        trail.add(term)
        ps = [parent for parent, _ in parents.get(term, [])]
        depth_cache[term] = 0 if not ps else 1 + max(depth(parent, trail) for parent in ps)
        return depth_cache[term]
    reps: list[pd.Series] = []; map_rows: list[dict[str, Any]] = []
    for cluster_id, component in enumerate(components, start=1):
        cluster_df = selected[selected["GO_ID"].isin(component)].copy()
        cluster_df["depth"] = cluster_df["GO_ID"].map(depth)
        representative = cluster_df.sort_values(["padj", "gene_ratio", "gene_count", "depth", "GO_ID"], ascending=[True, False, False, False, True]).iloc[0].copy()
        representative["redundancy_cluster"] = cluster_id
        representative["represented_terms"] = ";".join(component)
        representative["represented_term_count"] = len(component)
        reps.append(representative)
        for term in component:
            map_rows.append({"redundancy_cluster": cluster_id, "representative_GO_ID": representative["GO_ID"], "member_GO_ID": term,
                             "similarity_to_representative": wang_similarity(str(representative["GO_ID"]), term, parents, cache, is_a_weight, part_of_weight)})
    simplified = pd.DataFrame(reps).drop(columns=["depth"], errors="ignore")
    redundancy = pd.DataFrame(map_rows)
    if pair_rows:
        redundancy.attrs["pairwise_similarity"] = pair_rows
    return all_df, simplified, redundancy


def clean_mapman_value(value: Any) -> str:
    if value is None or (isinstance(value, float) and math.isnan(value)):
        return ""
    text = str(value).strip()
    while text and text[0] in {"'", '"'}:
        text = text[1:].strip()
    while text and text[-1] in {"'", '"'}:
        text = text[:-1].strip()
    return text


def mapman_level_name(name: str, level: int) -> str:
    cleaned = clean_mapman_value(name)
    parts = [part.strip() for part in cleaned.split(".") if part.strip()]
    return ".".join(parts[:level]) if parts else ""


def load_mapman_annotation(path: Path, cfg: Mapping[str, Any]) -> tuple[pd.DataFrame, pd.DataFrame]:
    """Normalize Mercator/MapMan hierarchy tables to a gene-to-BIN mapping.

    Hierarchy-only rows may have an empty IDENTIFIER. Gene rows may be quoted
    with single quotes as in Mercator exports. By default, assignments are
    aggregated to the first three dot-separated BINCODE components and rows
    shallower than the requested level are excluded with an explicit QC count.
    """
    raw = pd.read_csv(path, sep="\t", dtype=str, keep_default_na=False, comment="#", engine="python")
    normalized = {re.sub(r"[^a-z0-9]", "", str(col).lower()): str(col) for col in raw.columns}

    def resolve(config_key: str, aliases: Sequence[str], required: bool = True) -> str | None:
        configured = cfg.get(config_key)
        if configured:
            if configured not in raw.columns:
                raise InputBlocker(f"MapMan column '{configured}' configured by mapman.{config_key} is absent; available columns: {list(raw.columns)}")
            return str(configured)
        for alias in aliases:
            key = re.sub(r"[^a-z0-9]", "", alias.lower())
            if key in normalized:
                return normalized[key]
        if required:
            raise InputBlocker(f"MapMan annotation requires one of columns {list(aliases)}; available columns: {list(raw.columns)}")
        return None

    code_col = resolve("bincode_column", ["BINCODE", "BIN_CODE", "BIN"])
    name_col = resolve("name_column", ["NAME", "BINNAME", "BIN_NAME"])
    gene_col = resolve("gene_id_column", ["IDENTIFIER", "GENE_ID", "GENEID", "ID"])
    description_col = resolve("description_column", ["DESCRIPTION", "DESC"], required=False)
    type_col = resolve("type_column", ["TYPE"], required=False)
    level = int(cfg.get("enrichment_level", 3))
    if not 1 <= level <= 12:
        raise InputBlocker("mapman.enrichment_level must be between 1 and 12")

    frame = pd.DataFrame({
        "original_bincode": raw[code_col].map(clean_mapman_value),
        "original_name": raw[name_col].map(clean_mapman_value),
        "gene_id": raw[gene_col].map(clean_mapman_value),
        "description": raw[description_col].map(clean_mapman_value) if description_col else "",
        "type": raw[type_col].map(clean_mapman_value) if type_col else "",
    })
    code_ok = frame["original_bincode"].str.fullmatch(r"\d+(?:\.\d+)*", na=False)
    invalid_code_rows = int((frame["original_bincode"].ne("") & ~code_ok).sum())
    frame = frame[code_ok].copy()
    frame["original_level"] = frame["original_bincode"].str.count(r"\.") + 1

    # Prefer explicit hierarchy rows when choosing an exact BIN name.
    name_candidates = frame[frame["original_name"].ne("")].copy()
    name_candidates["hierarchy_priority"] = name_candidates["gene_id"].ne("").astype(int)
    name_by_code = (
        name_candidates.sort_values(["hierarchy_priority", "original_bincode", "original_name"])
        .drop_duplicates("original_bincode")
        .set_index("original_bincode")["original_name"]
        .to_dict()
    )

    assignments = frame[frame["gene_id"].ne("")].copy()
    requested_type = clean_mapman_value(cfg.get("gene_type_value", "T"))
    type_filter_applied = False
    type_filter_fallback = False
    if type_col and requested_type:
        typed = assignments[assignments["type"].str.casefold() == requested_type.casefold()].copy()
        if not typed.empty:
            assignments = typed
            type_filter_applied = True
        elif not assignments.empty:
            type_filter_fallback = True
    shallow_rows = int((assignments["original_level"] < level).sum())
    assignments = assignments[assignments["original_level"] >= level].copy()
    if assignments.empty:
        raise InputBlocker(f"MapMan annotation contains no gene assignments at or below BIN level {level}")
    assignments["BINCODE"] = assignments["original_bincode"].map(lambda x: ".".join(x.split(".")[:level]))

    def choose_name(row: pd.Series) -> str:
        exact = clean_mapman_value(name_by_code.get(row["BINCODE"], ""))
        if exact:
            return exact
        derived = mapman_level_name(str(row["original_name"]), level)
        return derived or row["BINCODE"]

    assignments["NAME"] = assignments.apply(choose_name, axis=1)
    mapping = assignments[["gene_id", "BINCODE", "NAME", "original_bincode", "original_name", "description", "type"]].drop_duplicates().sort_values(["BINCODE", "gene_id", "original_bincode"]).reset_index(drop=True)
    qc = pd.DataFrame([{
        "source_path": str(path),
        "raw_rows": len(raw),
        "valid_bincode_rows": len(frame),
        "invalid_nonempty_bincode_rows": invalid_code_rows,
        "gene_assignment_rows_after_type_filter": len(assignments),
        "unique_annotated_genes": mapping["gene_id"].nunique(),
        "unique_BINs": mapping["BINCODE"].nunique(),
        "requested_BIN_level": level,
        "shallow_gene_rows_excluded": shallow_rows,
        "type_column_present": bool(type_col),
        "requested_gene_type": requested_type,
        "type_filter_applied": type_filter_applied,
        "type_filter_fallback_to_all_identifier_rows": type_filter_fallback,
        "duplicate_gene_BIN_rows_removed": int(len(assignments) - len(mapping)),
    }])
    return mapping, qc


def mapman_ora(
    target_genes: set[str],
    universe_genes: set[str],
    mapping: pd.DataFrame,
    cfg: Mapping[str, Any],
) -> tuple[pd.DataFrame, pd.DataFrame]:
    """Deterministic MapMan BIN over-representation analysis at one level."""
    if mapping.empty:
        return pd.DataFrame(), pd.DataFrame()
    # Mercator/MapMan exports often use lower-case identifiers and protein/transcript suffixes
    # (for example zm00001eb000010_p001), whereas expression and network tables use canonical gene IDs
    # (Zm00001eb000010). Map annotation IDs onto the modeled gene IDs before testing.
    lookup = {str(g).casefold(): str(g) for g in universe_genes}
    def to_modeled_id(gene_id: Any) -> str | None:
        key = str(gene_id).strip().casefold()
        for candidate in (key, re.sub(r"[._](?:p|t)\d+$", "", key)):
            if candidate in lookup:
                return lookup[candidate]
        return None
    mapping = mapping.assign(gene_id=mapping["gene_id"].map(to_modeled_id)).dropna(subset=["gene_id"])
    if mapping.empty:
        return pd.DataFrame(), pd.DataFrame()
    annotated = set(mapping["gene_id"].astype(str))
    universe = set(map(str, universe_genes)) & annotated
    targets = set(map(str, target_genes)) & universe
    N, n = len(universe), len(targets)
    if N == 0 or n == 0:
        return pd.DataFrame(), pd.DataFrame()
    rows: list[dict[str, Any]] = []
    min_size = int(cfg.get("min_bin_size", 5))
    max_size = int(cfg.get("max_bin_size", 5000))
    min_overlap = int(cfg.get("min_overlap", 3))
    level = int(cfg.get("enrichment_level", 3))
    for (code, name), group in mapping.groupby(["BINCODE", "NAME"], sort=True):
        genes = set(group["gene_id"].astype(str)) & universe
        overlap = genes & targets
        K, k = len(genes), len(overlap)
        if K < min_size or K > max_size or k < min_overlap:
            continue
        pvalue = float(hypergeom.sf(k - 1, N, K, n))
        gene_ratio = k / n
        background_ratio = K / N
        rows.append({
            "BINCODE": str(code),
            "NAME": str(name),
            "BIN_level": level,
            "gene_count": k,
            "bin_size": K,
            "target_size": n,
            "universe_size": N,
            "gene_ratio": gene_ratio,
            "background_ratio": background_ratio,
            "fold_enrichment": gene_ratio / background_ratio if background_ratio else np.nan,
            "pvalue": pvalue,
            "genes": ";".join(sorted(overlap)),
        })
    all_df = pd.DataFrame(rows)
    if all_df.empty:
        return all_df, all_df.copy()
    all_df["padj"] = multipletests(all_df["pvalue"], method="fdr_bh")[1]
    all_df = all_df.sort_values(["padj", "pvalue", "fold_enrichment", "BINCODE"], ascending=[True, True, False, True]).reset_index(drop=True)
    significant = all_df[all_df["padj"] < float(cfg.get("qvalue_threshold", 0.05))].copy()
    return all_df, significant


def run_pyclusterprofiler_supplement(
    target_genes: set[str],
    cfg: Mapping[str, Any],
    runtime_dir: Path | None,
    out_dir: Path,
    cluster_name: str,
) -> None:
    """Run the legacy pyclusterprofiler backend only when its ID contract is met.

    The local BP ORA + local Wang simplification remains authoritative because
    pyclusterprofiler 0.1.dev14 is legacy and does not provide the required
    deterministic Wang redundancy workflow.
    """
    backend = str(cfg.get("backend", "auto"))
    compatible = str(cfg.get("id_type", "species_gene_id")) == "ncbi_gene_id" and bool(cfg.get("taxid"))
    requested = backend == "pyclusterprofiler_supplement" or (backend == "auto" and compatible)
    status = {"requested": requested, "compatible": compatible, "backend": backend, "authoritative_result": "local_BP_ORA_plus_local_Wang"}
    if not requested:
        status["status"] = "not_requested"; atomic_write_json(out_dir / "pyclusterprofiler_status.json", status); return
    if not compatible:
        status.update({"status": "not_run", "reason": "pyclusterprofiler requires true NCBI Gene IDs and go.taxid"}); atomic_write_json(out_dir / "pyclusterprofiler_status.json", status); return
    if runtime_dir is None:
        status.update({"status": "not_run", "reason": "runtime directory unavailable"}); atomic_write_json(out_dir / "pyclusterprofiler_status.json", status); return
    bootstrap_status_path = runtime_dir / "pyclusterprofiler_status.json"
    if bootstrap_status_path.is_file():
        try:
            bootstrap_status = json.loads(bootstrap_status_path.read_text(encoding="utf-8"))
        except Exception as exc:
            bootstrap_status = {"available": False, "reason": f"invalid bootstrap status: {exc}"}
        if not bool(bootstrap_status.get("available", False)):
            status.update({"status": "fallback_local", "reason": bootstrap_status.get("reason", "pyclusterprofiler dependency smoke test did not pass")})
            atomic_write_json(out_dir / "pyclusterprofiler_status.json", status)
            return
    input_path = out_dir / "pyclusterprofiler_input.csv"; output_path = out_dir / "GO_BP_pyclusterprofiler_supplement.csv"
    atomic_write_csv(input_path, pd.DataFrame({"gene_id": sorted(target_genes), "cluster": cluster_name}))
    command = environment_command(str(cfg.get("environment", "scPURE_agent")), ["python", str(runtime_dir / "pyclusterprofiler_runner.py"), "--input", str(input_path), "--taxid", str(cfg["taxid"]), "--output", str(output_path)])
    try:
        run_checked(command, log_path=out_dir / "pyclusterprofiler.log")
        status.update({"status": "complete", "output": str(output_path)})
    except Exception as exc:
        status.update({"status": "failed_optional", "reason": str(exc)})
    atomic_write_json(out_dir / "pyclusterprofiler_status.json", status)


def analyze_focus_tfs(
    integrated_edges: pd.DataFrame,
    manifest: Mapping[str, Any],
    annotation: pd.DataFrame,
    modeled_genes: set[str],
    out_dir: Path,
    runtime_dir: Path | None = None,
    go_output_root: Path | None = None,
    mapman_mapping: pd.DataFrame | None = None,
    mapman_output_root: Path | None = None,
) -> None:
    focus_tfs = [str(x) for x in manifest.get("focus", {}).get("tfs", [])]
    if not focus_tfs:
        return
    configure_plotting()
    import matplotlib.pyplot as plt
    go_cfg = manifest.get("go", {})
    mapman_cfg = manifest.get("mapman", {})
    label_map = dict(zip(annotation["gene_id"].astype(str), annotation["symbol"].astype(str))) if not annotation.empty else {}
    for tf in focus_tfs:
        tdir = out_dir / re.sub(r"[^A-Za-z0-9_.-]+", "_", tf)
        tdir.mkdir(parents=True, exist_ok=True)
        targets = integrated_edges[(integrated_edges["TF"].astype(str) == tf) & (integrated_edges["target_tf_rank"] <= int(manifest["model"].get("per_target_tf_rank", 20)))].sort_values("target_tf_rank")
        atomic_write_csv(tdir / "candidate_targets.csv", targets)
        if not targets.empty:
            plot = targets.head(int(manifest.get("focus", {}).get("max_plot_targets", 25))).sort_values("shap_value")
            fig, ax = plt.subplots(figsize=(6.0, max(3.5, .22 * len(plot) + 1.2)))
            size = 30 + 35 * plot["binding_validated"].astype(int) + 10 * pd.to_numeric(plot["homolog_support_count"], errors="coerce").fillna(0).clip(upper=5)
            direct = pd.to_numeric(plot.get("direct_support_count", 0), errors="coerce").fillna(0) > 0
            homolog_only = (~direct) & (pd.to_numeric(plot.get("homolog_support_count", 0), errors="coerce").fillna(0) > 0)
            edgecolors = np.where(direct, COLORS["gold"], np.where(homolog_only, COLORS["purple"], "none"))
            ax.scatter(plot["shap_value"], range(len(plot)), s=size, color=np.where(plot["shap_value"] >= 0, COLORS["blue"], COLORS["red"]), edgecolor=edgecolors)
            ax.set_yticks(range(len(plot)), [label_gene(str(x), label_map) for x in plot["target_gene_id"]])
            ax.axvline(0, color="#777777", lw=.8)
            ax.set(xlabel="Signed out-of-fold SHAP", title=f"Ranked targets of {display_gene_label(tf)}")
            save_figure(fig, tdir / "focus_TF_targets_dotplot.pdf", plot)
            plt.close(fig)
        if go_cfg.get("obo_path") and not targets.empty and not annotation.empty:
            gdir = (go_output_root / re.sub(r"[^A-Za-z0-9_.-]+", "_", tf)) if go_output_root is not None else tdir
            gdir.mkdir(parents=True, exist_ok=True)
            all_go, simple_go, redundancy = go_ora(set(targets["target_gene_id"]), modeled_genes, annotation, ensure_file(go_cfg["obo_path"], "GO OBO file"), {**go_cfg, "go_separator": manifest.get("annotation", {}).get("go_separator", ";")})
            atomic_write_csv(gdir / "GO_BP_all.csv", all_go)
            atomic_write_csv(gdir / "GO_BP_simplified.csv", simple_go)
            atomic_write_csv(gdir / "GO_BP_redundancy_map.csv", redundancy)
            run_pyclusterprofiler_supplement(set(targets["target_gene_id"].astype(str)), go_cfg, runtime_dir, gdir, tf)
            if not simple_go.empty:
                plot = simple_go.nsmallest(20, "padj").sort_values("gene_ratio")
                fig, ax = plt.subplots(figsize=(6.5, max(3.5, .3 * len(plot) + 1.2)))
                ax.barh(plot["Description"], plot["gene_ratio"], color=COLORS["teal"])
                ax.set(xlabel="Gene ratio", title=f"GO Biological Process enrichment: {display_gene_label(tf)}")
                save_figure(fig, gdir / "GO_BP_barplot.pdf", plot)
                plt.close(fig)
        if mapman_mapping is not None and not mapman_mapping.empty and not targets.empty:
            mdir = (mapman_output_root / re.sub(r"[^A-Za-z0-9_.-]+", "_", tf)) if mapman_output_root is not None else tdir
            mdir.mkdir(parents=True, exist_ok=True)
            all_mapman, significant_mapman = mapman_ora(set(targets["target_gene_id"].astype(str)), modeled_genes, mapman_mapping, mapman_cfg)
            level = int(mapman_cfg.get("enrichment_level", 3))
            atomic_write_csv(mdir / f"MapMan_BIN{level}_all.csv", all_mapman)
            atomic_write_csv(mdir / f"MapMan_BIN{level}_significant.csv", significant_mapman)
            if not significant_mapman.empty:
                plot = significant_mapman.nsmallest(20, "padj").sort_values("gene_ratio")
                labels = plot["BINCODE"].astype(str) + "  " + plot["NAME"].astype(str)
                fig, ax = plt.subplots(figsize=(7.0, max(3.5, .3 * len(plot) + 1.2)))
                ax.barh(labels, plot["gene_ratio"], color=COLORS["teal"])
                ax.set(xlabel="Gene ratio", title=f"MapMan BIN level {level} enrichment: {display_gene_label(tf)}")
                save_figure(fig, mdir / f"MapMan_BIN{level}_barplot.pdf", plot)
                plt.close(fig)


def create_gene_model_bed12(tx: TranscriptRecord, out_path: Path, display_label: str | None = None) -> None:
    # A conservative one-block model is used because transcript exon coordinates are not retained here.
    chrom_start = tx.start_1based - 1
    chrom_end = tx.end_1based
    label = display_label or display_gene_label(tx.gene_id)
    row = [tx.chrom, chrom_start, chrom_end, label, 0, tx.strand, chrom_start, chrom_end, COLORS["dark_blue"].lstrip("#"), 1, chrom_end - chrom_start, 0]
    out_path.write_text("\t".join(map(str, row)) + "\n", encoding="utf-8")


def split_chunks(items: Sequence[Any], size: int) -> Iterator[Sequence[Any]]:
    for i in range(0, len(items), size):
        yield items[i:i + size]


def compact_track_label(value: Any, max_chars: int) -> str:
    text = re.sub(r"\s+", " ", str(value or "").strip())
    if len(text) <= max_chars:
        return text
    if max_chars < 8:
        return text[:max_chars]
    return text[: max_chars - 1].rstrip() + "…"


def compact_assay_name(value: Any) -> str:
    text = str(value or "").strip()
    replacements = {
        "DAP-seq": "DAP",
        "ChIP-seq": "ChIP",
        "CUT&Tag": "CUT&Tag",
        "CUT&RUN": "CUT&RUN",
    }
    for source, short in replacements.items():
        text = re.sub(re.escape(source), short, text, flags=re.IGNORECASE)
    return re.sub(r"\s+", " ", text) or "assay"


def promoter_centered_region(promoter: PromoterRecord, cfg: Mapping[str, Any]) -> tuple[int, int, bool]:
    upstream = int(cfg.get("region_upstream_bp", 5000))
    downstream = int(cfg.get("region_downstream_bp", 3000))
    max_region = int(cfg.get("max_region_bp", 50000))
    tss0 = promoter.tss_1based - 1
    if promoter.strand == "-":
        start = max(0, tss0 - downstream)
        end = tss0 + upstream
    else:
        start = max(0, tss0 - upstream)
        end = tss0 + downstream
    start = min(start, promoter.start_0based)
    end = max(end, promoter.end_0based)
    truncated = False
    if end - start > max_region:
        half = max_region // 2
        start = max(0, tss0 - half)
        end = start + max_region
        truncated = True
    return start, end, truncated


def render_tracks(validation: pd.DataFrame, promoters: Mapping[str, PromoterRecord], transcripts: Mapping[str, TranscriptRecord], cfg: Mapping[str, Any], out_dir: Path, annotation: pd.DataFrame | None = None) -> pd.DataFrame:
    """Render readable promoter-centered tracks with strict pagination.

    Direct and homolog evidence are placed on separate pages. Track titles are
    symbol-first and length-capped; identifiers remain in the inventory CSV and
    file names. The target transcript is the only labeled gene model.
    """
    out_dir.mkdir(parents=True, exist_ok=True)
    if annotation is not None and not annotation.empty:
        set_active_annotation(annotation)
    if not bool(cfg.get("enabled", True)):
        inventory = pd.DataFrame([{"status": "not_run", "reason": "tracks.enabled=false"}])
        atomic_write_csv(out_dir / "track_inventory.csv", inventory)
        return inventory

    max_tracks = int(cfg.get("max_signal_tracks_per_page", 4))
    max_pairs = int(cfg.get("max_pairs_per_contrast", 100))
    rank_limit = int(cfg.get("per_target_tf_rank", 20))
    max_region = int(cfg.get("max_region_bp", 50000))
    dpi = int(cfg.get("dpi", 300))
    width = float(cfg.get("width_cm", 32))
    plot_width = float(cfg.get("plot_width_cm", 23))
    label_fraction = float(cfg.get("track_label_fraction", 0.24))
    base_height = float(cfg.get("base_height_cm", 4.5))
    signal_height = float(cfg.get("signal_height_cm", 1.7))
    peak_height = float(cfg.get("peak_height_cm", 0.45))
    spacer_height = float(cfg.get("spacer_height_cm", 0.25))
    font_size = int(cfg.get("font_size", 9))
    max_title_chars = int(cfg.get("max_track_title_chars", 30))
    upstream = int(cfg.get("region_upstream_bp", 5000))
    downstream = int(cfg.get("region_downstream_bp", 3000))

    if not 1 <= max_tracks <= 6:
        raise InputBlocker("tracks.max_signal_tracks_per_page must be between 1 and 6 for readable pages")
    if max_pairs < 1:
        raise InputBlocker("tracks.max_pairs_per_contrast must be at least 1")
    if upstream < 500 or downstream < 500 or not 2_000 <= max_region <= 250_000:
        raise InputBlocker("tracks region windows must be >=500 bp and max_region_bp must be 2,000-250,000")
    if not 72 <= dpi <= 600 or not 24 <= width <= 40 or not 16 <= plot_width <= 30 or plot_width >= width:
        raise InputBlocker("tracks require dpi 72-600, width_cm 24-40, and plot_width_cm 16-30 smaller than width_cm")
    if not 0.18 <= label_fraction <= 0.32:
        raise InputBlocker("tracks.track_label_fraction must be between 0.18 and 0.32")
    if not 3.5 <= base_height <= 8 or not 1.2 <= signal_height <= 2.5 or not .3 <= peak_height <= .8 or not .12 <= spacer_height <= .5:
        raise InputBlocker("tracks height settings violate the fixed readable-layout ranges")
    if not 8 <= font_size <= 14 or not 18 <= max_title_chars <= 48:
        raise InputBlocker("tracks.font_size must be 8-14 and max_track_title_chars must be 18-48")

    eligible = validation[validation["binding_validated"].astype(bool)].copy()
    if "target_tf_rank" in eligible.columns:
        eligible = eligible[eligible["target_tf_rank"] <= rank_limit]
    eligible["direct_priority"] = (pd.to_numeric(eligible.get("direct_support_count", 0), errors="coerce").fillna(0) > 0).astype(int)
    eligible["homolog_identity_priority"] = pd.to_numeric(eligible.get("highest_homolog_identity", eligible.get("homolog_identity", np.nan)), errors="coerce").fillna(-1)
    shap_col = "abs_shap" if "abs_shap" in eligible.columns else ("abs_shap_value" if "abs_shap_value" in eligible.columns else None)
    sort_columns = ["direct_priority", "target_tf_rank"] + ([shap_col] if shap_col else []) + ["homolog_identity_priority", "target_gene_id", "TF"]
    ascending = [False, True] + ([False] if shap_col else []) + [False, True, True]
    eligible = eligible.sort_values(sort_columns, ascending=ascending).drop_duplicates(["TF", "target_gene_id"])
    total_eligible = len(eligible)
    eligible = eligible.head(max_pairs)
    if eligible.empty:
        inventory = pd.DataFrame([{"status": "not_run", "reason": "no top-ranked validated TF-target pairs"}])
        atomic_write_csv(out_dir / "track_inventory.csv", inventory)
        return inventory

    track_rows: list[dict[str, Any]] = []
    layout_rows: list[dict[str, Any]] = []
    if total_eligible > max_pairs:
        track_rows.append({"status": "capped", "reason": f"{total_eligible - max_pairs} eligible TF-target pairs omitted by tracks.max_pairs_per_contrast={max_pairs}", "eligible_pairs": total_eligible, "rendered_pair_limit": max_pairs})

    for edge in eligible.itertuples(index=False):
        pair_key = f"{edge.TF}__to__{edge.target_gene_id}"
        tf_label = display_gene_label(edge.TF)
        target_label = display_gene_label(edge.target_gene_id)
        if not getattr(edge, "supporting_track_rows_json", None):
            track_rows.append({"TF": edge.TF, "target_gene_id": edge.target_gene_id, "status": "skipped", "reason": "missing supporting track JSON"})
            continue
        try:
            supports = pd.DataFrame(json.loads(edge.supporting_track_rows_json))
        except Exception as exc:
            track_rows.append({"TF": edge.TF, "target_gene_id": edge.target_gene_id, "status": "skipped", "reason": f"invalid supporting track JSON: {exc}"})
            continue
        supports = supports[pd.to_numeric(supports.get("peak_count", 0), errors="coerce").fillna(0) > 0].copy()
        if not bool(cfg.get("include_homolog_tracks", True)):
            supports = supports[supports["source"] == "direct_same_tf"]
        supports["priority"] = supports["source"].map({"direct_same_tf": 0, "same_species_homolog": 1}).fillna(9)
        supports["homolog_identity"] = pd.to_numeric(supports.get("homolog_identity", np.nan), errors="coerce")
        supports = supports.sort_values(["priority", "homolog_identity", "validated_tf_gene_id", "replicate"], ascending=[True, False, True, True])
        promoter = promoters.get(str(edge.target_gene_id))
        tx = transcripts.get(str(edge.target_gene_id))
        if promoter is None or tx is None or supports.empty:
            track_rows.append({"TF": edge.TF, "target_gene_id": edge.target_gene_id, "status": "skipped", "reason": "missing promoter/transcript or supported tracks"})
            continue

        region_start, region_end, truncated = promoter_centered_region(promoter, cfg)
        pair_dir = out_dir / re.sub(r"[^A-Za-z0-9_.-]+", "_", pair_key)
        pair_dir.mkdir(parents=True, exist_ok=True)
        gene_bed = pair_dir / "target_gene.bed12"
        create_gene_model_bed12(tx, gene_bed, target_label)
        promoter_bed = pair_dir / "promoter.bed"
        promoter_bed.write_text(f"{promoter.chrom}\t{promoter.start_0based}\t{promoter.end_0based}\t{target_label}\n", encoding="utf-8")

        evidence_groups = [
            ("direct", supports[supports["source"] == "direct_same_tf"]),
            ("homolog", supports[supports["source"] == "same_species_homolog"]),
        ]
        for evidence_group, group in evidence_groups:
            if group.empty:
                continue
            for page, chunk in enumerate(split_chunks(list(group.itertuples(index=False)), max_tracks), start=1):
                stem = f"{evidence_group}_page_{page:02d}"
                ini = pair_dir / f"{stem}.ini"
                pdf = pair_dir / f"{stem}.pdf"
                title = (
                    f"Direct promoter-peak evidence | TF {tf_label} | target {target_label}"
                    if evidence_group == "direct"
                    else f"Homolog promoter-peak evidence | candidate TF {tf_label} | target {target_label}"
                )
                lines = [
                    "[target gene]",
                    f"file = {gene_bed}",
                    "file_type = bed",
                    f"title = Target | {compact_track_label(target_label, max_title_chars)}",
                    "height = 1.0",
                    f"color = {COLORS['dark_blue']}",
                    "border_color = none",
                    "display = collapsed",
                    "labels = true",
                    "style = UCSC",
                    "",
                    "[promoter highlight]",
                    f"file = {promoter_bed}",
                    "type = vhighlight",
                    f"color = {COLORS['red']}",
                    "alpha = 0.08",
                    "",
                    "[spacer top]",
                    f"height = {spacer_height}",
                    "",
                ]
                y_max_values: list[float | None] = []
                track_labels: list[str] = []
                for i, row in enumerate(chunk, start=1):
                    validated_label = str(getattr(row, "validated_tf_symbol", "") or "").strip()
                    if not validated_label:
                        validated_label = display_gene_label(row.validated_tf_gene_id)
                    assay = compact_assay_name(getattr(row, "assay", ""))
                    replicate = str(getattr(row, "replicate", "rep")).strip() or "rep"
                    if evidence_group == "direct":
                        raw_label = f"{validated_label} | {assay} | {replicate}"
                    else:
                        identity = float(row.homolog_identity) if pd.notna(row.homolog_identity) else float("nan")
                        identity_text = f"{identity:.0f}%" if math.isfinite(identity) else "identity NA"
                        raw_label = f"{validated_label} | hom {identity_text} | {replicate}"
                    label = compact_track_label(raw_label, max_title_chars)
                    track_labels.append(label)
                    y_max = float(row.bigwig_q995) if pd.notna(row.bigwig_q995) and float(row.bigwig_q995) > 0 else None
                    y_max_values.append(y_max)
                    lines += [
                        f"[signal {i}]",
                        f"file = {row.bigwig_path}",
                        "file_type = bigwig",
                        f"title = {label}",
                        f"height = {signal_height}",
                        f"color = {COLORS['green'] if evidence_group == 'direct' else COLORS['teal']}",
                        "type = fill",
                        "summary_method = mean",
                        "nans_to_zeros = false",
                        "show_data_range = true",
                        "grid = false",
                        f"number_of_bins = {min(2000, max(700, math.ceil((region_end-region_start)/20)))}",
                    ]
                    if y_max:
                        lines.append(f"max_value = {y_max}")
                    peak_type = "narrow_peak" if str(row.peak_path).lower().endswith((".narrowpeak", ".narrowpeak.gz")) else "bed"
                    lines += [
                        "",
                        f"[peaks {i}]",
                        f"file = {row.peak_path}",
                        f"file_type = {peak_type}",
                        f"height = {peak_height}",
                        f"color = {COLORS['slate'] if evidence_group == 'direct' else COLORS['purple']}",
                        "labels = false",
                        "display = collapsed",
                        "",
                        f"[spacer {i}]",
                        f"height = {spacer_height}",
                        "",
                    ]
                lines += ["[x-axis]", "where = bottom", f"fontsize = {max(8, font_size)}"]
                atomic_write_text(ini, "\n".join(lines) + "\n")
                page_height = base_height + len(chunk) * (signal_height + peak_height + spacer_height * 1.5)
                command = [
                    "pyGenomeTracks",
                    "--tracks", str(ini),
                    "--region", f"{promoter.chrom}:{region_start}-{region_end}",
                    "--outFileName", str(pdf),
                    "--dpi", str(dpi),
                    "--width", str(width),
                    "--plotWidth", str(plot_width),
                    "--height", str(page_height),
                    "--fontSize", str(font_size),
                    "--trackLabelFraction", str(label_fraction),
                    "--trackLabelHAlign", "left",
                    "--title", compact_track_label(title, 100),
                ]
                try:
                    run_checked(command, log_path=pair_dir / f"{stem}.log")
                    status, reason = "created", ""
                except Exception as exc:
                    status, reason = "failed", str(exc)
                direct_count = sum(x.source == "direct_same_tf" for x in chunk)
                homolog_count = sum(x.source == "same_species_homolog" for x in chunk)
                record = {
                    "TF": edge.TF,
                    "target_gene_id": edge.target_gene_id,
                    "target_tf_rank": getattr(edge, "target_tf_rank", np.nan),
                    "evidence_group": evidence_group,
                    "page": page,
                    "region": f"{promoter.chrom}:{region_start}-{region_end}",
                    "region_mode": "strand_aware_promoter_centered",
                    "region_truncated": truncated,
                    "signal_tracks": len(chunk),
                    "track_labels": ";".join(track_labels),
                    "ini": str(ini),
                    "pdf": str(pdf) if pdf.exists() else "",
                    "direct_tracks": direct_count,
                    "homolog_tracks": homolog_count,
                    "q995_y_max_values": ";".join("" if x is None else f"{x:.6g}" for x in y_max_values),
                    "page_width_cm": width,
                    "plot_width_cm": plot_width,
                    "page_height_cm": page_height,
                    "track_label_fraction": label_fraction,
                    "font_size": font_size,
                    "status": status,
                    "reason": reason,
                }
                track_rows.append(record)
                layout_rows.append({
                    **{k: record[k] for k in ("TF", "target_gene_id", "evidence_group", "page", "signal_tracks", "page_width_cm", "plot_width_cm", "page_height_cm", "track_label_fraction", "font_size", "status")},
                    "estimated_cm_per_signal_peak_pair": signal_height + peak_height + spacer_height * 1.5,
                    "max_track_title_chars": max_title_chars,
                    "target_display_label": target_label,
                    "candidate_TF_display_label": tf_label,
                })
    inventory = decorate_gene_columns(pd.DataFrame(track_rows))
    atomic_write_csv(out_dir / "track_inventory.csv", inventory)
    atomic_write_csv(out_dir / "track_layout_audit.csv", decorate_gene_columns(pd.DataFrame(layout_rows)))
    return inventory


def compare_contrasts(model_outputs: Mapping[str, Mapping[str, Path]], combined_validation: pd.DataFrame, manifest: Mapping[str, Any], out_dir: Path) -> None:
    """Create scale-safe comparisons across contrasts.

    Raw SHAP magnitudes are never compared directly across independently fitted
    models. The exported matrices use within-contrast ranks, fractions of total
    absolute SHAP, or presence/validation indicators.
    """
    if len(model_outputs) < 2:
        return
    out_dir.mkdir(parents=True, exist_ok=True)
    summary_rows: list[pd.DataFrame] = []
    for contrast, outputs in model_outputs.items():
        df = pd.read_csv(outputs["summary"]).copy()
        df["contrast"] = contrast
        df["within_contrast_rank"] = df["sum_abs_shap"].rank(ascending=False, method="min")
        total = float(df["sum_abs_shap"].sum())
        df["fraction_total_abs_shap"] = df["sum_abs_shap"] / total if total > 0 else 0.0
        summary_rows.append(df)
    tf_long = decorate_gene_columns(pd.concat(summary_rows, ignore_index=True))
    tf_long["TF_label"] = tf_long["TF"].map(display_gene_label)
    atomic_write_csv(out_dir / "top_TFs_across_contrasts_long.csv", tf_long)
    rank_matrix = tf_long.pivot_table(index="TF", columns="contrast", values="within_contrast_rank", aggfunc="min")
    fraction_matrix = tf_long.pivot_table(index="TF", columns="contrast", values="fraction_total_abs_shap", aggfunc="sum", fill_value=0)
    atomic_write_csv(out_dir / "top_TFs_rank_matrix.csv", rank_matrix.reset_index())
    atomic_write_csv(out_dir / "top_TFs_fraction_matrix.csv", fraction_matrix.reset_index())
    configure_plotting()
    import matplotlib.pyplot as plt
    top_union: set[str] = set()
    top_n = int(manifest.get("model", {}).get("top_tfs", 20))
    for contrast in rank_matrix.columns:
        top_union.update(rank_matrix[contrast].nsmallest(top_n).index.astype(str))
    if top_union:
        ordered = sorted(top_union, key=lambda gene: (float(rank_matrix.loc[gene].min(skipna=True)), display_gene_label(gene), gene))
        plot_rank = rank_matrix.loc[ordered].copy()
        plot_rank = plot_rank.fillna(plot_rank.max().max() + 1)
        heat_width = max(7.5, 1.25 * len(plot_rank.columns) + 3.5)
        heat_height = max(5.0, .32 * len(plot_rank) + 1.8)
        fig, ax = plt.subplots(figsize=(heat_width, heat_height))
        im = ax.imshow(plot_rank.to_numpy(), aspect="auto", cmap="viridis_r")
        ax.set_xticks(range(len(plot_rank.columns)), plot_rank.columns, rotation=30, ha="right")
        ax.set_yticks(range(len(plot_rank.index)), [display_gene_label(x) for x in plot_rank.index])
        if len(plot_rank.columns) <= 6 and len(plot_rank.index) <= 40:
            for row_i in range(plot_rank.shape[0]):
                for col_i in range(plot_rank.shape[1]):
                    ax.text(col_i, row_i, f"{plot_rank.iat[row_i, col_i]:.0f}", ha="center", va="center", fontsize=6)
        ax.set_title("Within-contrast TF ranks")
        fig.colorbar(im, ax=ax, label="Rank (lower is stronger)", fraction=0.035, pad=0.03)
        save_figure(fig, out_dir / "top_TFs_rank_heatmap.pdf", decorate_gene_columns(plot_rank.reset_index(names="TF")))
        plt.close(fig)
        plot_fraction = fraction_matrix.reindex(plot_rank.index).fillna(0)
        fig, ax = plt.subplots(figsize=(heat_width, heat_height))
        im = ax.imshow(plot_fraction.to_numpy(), aspect="auto", cmap="Blues")
        ax.set_xticks(range(len(plot_fraction.columns)), plot_fraction.columns, rotation=30, ha="right")
        ax.set_yticks(range(len(plot_fraction.index)), [display_gene_label(x) for x in plot_fraction.index])
        if len(plot_fraction.columns) <= 6 and len(plot_fraction.index) <= 40:
            for row_i in range(plot_fraction.shape[0]):
                for col_i in range(plot_fraction.shape[1]):
                    ax.text(col_i, row_i, f"{plot_fraction.iat[row_i, col_i]:.3f}", ha="center", va="center", fontsize=6)
        ax.set_title("Fraction of total absolute SHAP")
        fig.colorbar(im, ax=ax, label="Within-contrast fraction", fraction=0.035, pad=0.03)
        save_figure(fig, out_dir / "top_TFs_normalized_contribution_heatmap.pdf", decorate_gene_columns(plot_fraction.reset_index(names="TF")))
        plt.close(fig)

    if combined_validation.empty:
        return
    edges = combined_validation.copy()
    edges["direct_binding"] = (edges.get("binding_validated", False).astype(bool)) & (edges.get("validation_source", "") == "direct_same_tf")
    edges["homolog_binding"] = (edges.get("binding_validated", False).astype(bool)) & (edges.get("validation_source", "") == "same_species_homolog")
    edge_presence = edges.assign(retained_edge=1).pivot_table(index=["TF", "target_gene_id"], columns="contrast", values="retained_edge", aggfunc="max", fill_value=0).reset_index()
    atomic_write_csv(out_dir / "retained_TF_target_edges_matrix.csv", edge_presence)
    validation_summary = edges.groupby(["contrast", "TF"], as_index=False).agg(
        retained_targets=("target_gene_id", "nunique"),
        directly_validated_targets=("direct_binding", "sum"),
        homolog_validated_targets=("homolog_binding", "sum"),
        homologs_supporting=("homolog_support_count", "max"),
    )
    atomic_write_csv(out_dir / "TF_target_validation_across_contrasts.csv", validation_summary)

    focus_targets = set(map(str, manifest.get("focus", {}).get("target_genes", [])))
    if focus_targets:
        target_rows = edges[edges["target_gene_id"].astype(str).isin(focus_targets)].copy()
        target_rows = target_rows.sort_values(["target_gene_id", "contrast", "target_tf_rank"])
        atomic_write_csv(out_dir / "focus_targets_top_TFs_across_contrasts.csv", target_rows)
    focus_tfs = set(map(str, manifest.get("focus", {}).get("tfs", [])))
    if focus_tfs:
        tf_targets = edges[(edges["TF"].astype(str).isin(focus_tfs)) & (edges["target_tf_rank"] <= int(manifest.get("model", {}).get("per_target_tf_rank", 20)))].copy()
        tf_targets = tf_targets.sort_values(["TF", "contrast", "target_tf_rank"])
        atomic_write_csv(out_dir / "focus_TFs_targets_across_contrasts.csv", tf_targets)

    # Pairwise Jaccard similarities use retained TF-target identities only.
    contrast_sets = {c: set(zip(g["TF"].astype(str), g["target_gene_id"].astype(str))) for c, g in edges.groupby("contrast")}
    jaccard_rows = []
    names = sorted(contrast_sets)
    for i, a in enumerate(names):
        for b in names[i:]:
            union = contrast_sets[a] | contrast_sets[b]
            score = len(contrast_sets[a] & contrast_sets[b]) / len(union) if union else 1.0
            jaccard_rows.append({"contrast_a": a, "contrast_b": b, "edge_jaccard": score, "intersection_edges": len(contrast_sets[a] & contrast_sets[b]), "union_edges": len(union)})
    atomic_write_csv(out_dir / "contrast_edge_jaccard.csv", pd.DataFrame(jaccard_rows))

def pdf_to_png(pdf: Path, png: Path, dpi: int = 300) -> bool:
    try:
        import fitz
        doc = fitz.open(pdf)
        if len(doc) == 0:
            return False
        page = doc[0]
        pix = page.get_pixmap(matrix=fitz.Matrix(dpi / 72, dpi / 72), alpha=False)
        pix.save(png)
        return True
    except Exception:
        return False


def add_toc(document: Any) -> None:
    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn
    paragraph = document.add_paragraph()
    run = paragraph.add_run()
    fld_char = OxmlElement("w:fldChar")
    fld_char.set(qn("w:fldCharType"), "begin")
    instr = OxmlElement("w:instrText")
    instr.set(qn("xml:space"), "preserve")
    instr.text = 'TOC \\o "1-3" \\h \\z \\u'
    fld_sep = OxmlElement("w:fldChar")
    fld_sep.set(qn("w:fldCharType"), "separate")
    fld_end = OxmlElement("w:fldChar")
    fld_end.set(qn("w:fldCharType"), "end")
    run._r.extend([fld_char, instr, fld_sep, fld_end])


def set_cell_text(cell: Any, text: Any, bold: bool = False) -> None:
    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn
    cell.text = ""
    if text is None or (isinstance(text, float) and not math.isfinite(text)) or pd.isna(text):
        rendered = "—"
    elif isinstance(text, (bool, np.bool_)):
        rendered = "Yes" if bool(text) else "No"
    elif isinstance(text, (int, np.integer)):
        rendered = f"{int(text):,}"
    elif isinstance(text, (float, np.floating)):
        value = float(text)
        if value == 0:
            rendered = "0"
        elif abs(value) >= 10_000 or abs(value) < 0.001:
            rendered = f"{value:.3e}"
        else:
            rendered = f"{value:.4g}"
    else:
        rendered = str(text).strip()
        if not rendered or rendered.lower() == "nan":
            rendered = "—"
        rendered = re.sub(r"\s+", " ", rendered)
        if len(rendered) > 90:
            rendered = rendered[:87].rstrip() + "…"
    run = cell.paragraphs[0].add_run(rendered)
    run.bold = bold
    run.font.size = __import__("docx").shared.Pt(8.5)
    tc_pr = cell._tc.get_or_add_tcPr()
    no_wrap = tc_pr.find(qn("w:noWrap"))
    if no_wrap is not None:
        tc_pr.remove(no_wrap)


def shade_cell(cell: Any, hex_fill: str) -> None:
    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn
    shd = OxmlElement("w:shd"); shd.set(qn("w:val"), "clear"); shd.set(qn("w:color"), "auto"); shd.set(qn("w:fill"), hex_fill)
    cell._tc.get_or_add_tcPr().append(shd)


def style_table_borders(table: Any) -> None:
    """Horizontal rules only (top, below header, bottom); no vertical lines."""
    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn
    tbl_pr = table._tbl.tblPr
    borders = OxmlElement("w:tblBorders")
    for edge, val, sz in [("top", "single", "8"), ("bottom", "single", "8"), ("insideH", "single", "2"),
                          ("left", "nil", "0"), ("right", "nil", "0"), ("insideV", "nil", "0")]:
        el = OxmlElement(f"w:{edge}"); el.set(qn("w:val"), val); el.set(qn("w:sz"), sz); el.set(qn("w:space"), "0"); el.set(qn("w:color"), "8A8A8A" if edge == "insideH" else "222222")
        borders.append(el)
    old = tbl_pr.find(qn("w:tblBorders"))
    if old is not None: tbl_pr.remove(old)
    tbl_pr.append(borders)


def add_note(document: Any, text: str) -> None:
    from docx.shared import Pt, RGBColor
    p = document.add_paragraph(); p.paragraph_format.space_after = Pt(8)
    r = p.add_run(text); r.italic = True; r.font.size = Pt(8.5); r.font.color.rgb = RGBColor(0x55, 0x60, 0x6B)


def repeat_table_header(row: Any) -> None:
    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn
    tr_pr = row._tr.get_or_add_trPr()
    tbl_header = OxmlElement("w:tblHeader")
    tbl_header.set(qn("w:val"), "true")
    tr_pr.append(tbl_header)


def humanize_report_frame(df: pd.DataFrame) -> pd.DataFrame:
    """Use symbols in human-facing tables while preserving IDs in source CSVs."""
    frame = decorate_gene_columns(df)
    replacements = [
        ("gene_id", "gene_label", "gene"),
        ("target_gene_id", "target_gene_label", "target"),
        ("target", "target_label", "target"),
        ("TF", "TF_label", "TF"),
        ("tf_gene_id", "tf_label", "TF"),
        ("validated_tf_gene_id", "validated_tf_label", "validated TF"),
        ("query_gene_id", "query_gene_label", "query"),
        ("subject_gene_id", "subject_gene_label", "homolog"),
    ]
    for id_col, label_col, display_name in replacements:
        if id_col in frame.columns and label_col in frame.columns:
            frame[id_col] = frame[label_col]
            frame = frame.rename(columns={id_col: display_name})
    drop_cols = [
        col for col in frame.columns
        if col.endswith("_label") or (
            col.endswith("_symbol") and col not in {"tf_symbol", "validated_tf_symbol"}
        )
    ]
    frame = frame.drop(columns=drop_cols, errors="ignore")
    frame = frame.loc[:, ~frame.columns.duplicated()]

    def sanitize_path_value(value: Any) -> Any:
        if not isinstance(value, str):
            return value
        text = value.strip()
        if not text:
            return value
        parts = text.split(";")
        cleaned: list[str] = []
        changed = False
        for part in parts:
            item = part.strip()
            is_absolute = item.startswith("/") or bool(re.match(r"^[A-Za-z]:[\\/]", item))
            if is_absolute:
                normalized = item.replace("\\", "/").rstrip("/")
                cleaned.append(normalized.rsplit("/", 1)[-1])
                changed = True
            else:
                cleaned.append(item)
        return ";".join(cleaned) if changed else value

    for col in frame.columns:
        if frame[col].dtype == object:
            frame[col] = frame[col].map(sanitize_path_value)
    return frame


def add_dataframe(
    document: Any,
    df: pd.DataFrame,
    title: str,
    *,
    source_rel: str | None = None,
    max_rows: int = 10,
    max_cols: int = 8,
    preferred_columns: Sequence[str] | None = None,
) -> None:
    document.add_paragraph(title, style="Caption")
    frame = humanize_report_frame(df)
    if preferred_columns:
        preferred = [col for col in preferred_columns if col in frame.columns]
        remaining = [col for col in frame.columns if col not in preferred]
        frame = frame[preferred + remaining]
    shown = frame.iloc[:max_rows, :max_cols].copy()
    if shown.empty:
        add_note(document, "No rows were available.")
        return
    table = document.add_table(rows=1, cols=len(shown.columns))
    table.style = "Table Grid"
    repeat_table_header(table.rows[0])
    for i, col in enumerate(shown.columns):
        set_cell_text(table.rows[0].cells[i], col, bold=True)
        shade_cell(table.rows[0].cells[i], "D6E7EF")
    style_table_borders(table)
    for _, row in shown.iterrows():
        cells = table.add_row().cells
        for i, value in enumerate(row):
            set_cell_text(cells[i], value)
    details = []
    if len(frame) > max_rows or frame.shape[1] > max_cols:
        details.append(f"preview: {len(shown)} of {len(frame)} rows, {len(shown.columns)} of {frame.shape[1]} columns")
    if source_rel:
        details.append(f"full table: {source_rel}")
    if details:
        add_note(document, "; ".join(details) + ".")


def aggregate_cv_metrics(df: pd.DataFrame) -> pd.DataFrame:
    metrics = [c for c in ("roc_auc", "pr_auc", "balanced_accuracy", "accuracy", "precision", "recall", "f1", "mcc") if c in df.columns]
    rows = []
    for metric in metrics:
        values = pd.to_numeric(df[metric], errors="coerce").dropna()
        if values.empty:
            continue
        rows.append({"metric": metric, "mean": values.mean(), "sd": values.std(ddof=1) if len(values) > 1 else 0.0, "minimum": values.min(), "maximum": values.max(), "folds": len(values)})
    return pd.DataFrame(rows)


def report_text_lint(document: Any) -> list[str]:
    """Block conclusion/discussion language from the fixed descriptive report."""
    banned = [
        r"\bwe conclude\b",
        r"\bresults? suggest(?:s|ed)? that\b",
        r"\bresults? indicate(?:s|d)? that\b",
        r"\bconsistent with (?:a|an|the) biological\b",
        r"\bsupports? a role\b",
        r"\bkey regulator\b",
        r"\bbiologically meaningful\b",
        r"\bmay regulate\b",
        r"\blikely regulates\b",
        r"\bdemonstrates? that\b",
        r"\bwe propose\b",
        r"\bwe infer\b",
    ]
    texts = [p.text for p in document.paragraphs]
    for table in document.tables:
        for row in table.rows:
            texts.extend(cell.text for cell in row.cells)
    violations: list[str] = []
    for value in texts:
        for pattern in banned:
            if re.search(pattern, value, flags=re.IGNORECASE):
                violations.append(f"{pattern}: {value[:180]}")
    return violations


def add_landscape_section(document: Any) -> Any:
    from docx.enum.section import WD_ORIENT, WD_SECTION
    from docx.shared import Inches
    section = document.add_section(WD_SECTION.NEW_PAGE)
    section.orientation = WD_ORIENT.LANDSCAPE
    section.page_width, section.page_height = section.page_height, section.page_width
    section.top_margin = Inches(.55)
    section.bottom_margin = Inches(.55)
    section.left_margin = Inches(.55)
    section.right_margin = Inches(.55)
    return section


def add_portrait_section(document: Any) -> Any:
    from docx.enum.section import WD_ORIENT, WD_SECTION
    from docx.shared import Inches
    section = document.add_section(WD_SECTION.NEW_PAGE)
    section.orientation = WD_ORIENT.PORTRAIT
    section.page_width = Inches(8.27)
    section.page_height = Inches(11.69)
    section.top_margin = Inches(.7)
    section.bottom_margin = Inches(.7)
    section.left_margin = Inches(.7)
    section.right_margin = Inches(.7)
    return section


def build_word_report(project_root: Path, manifest: Mapping[str, Any], out_path: Path) -> None:
    """Generate the fixed English descriptive report with no conclusions."""
    from docx import Document
    from docx.enum.text import WD_ALIGN_PARAGRAPH
    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn
    from docx.shared import Inches, Pt

    report_cfg = manifest.get("report", {})
    max_rows = int(report_cfg.get("max_table_rows", 10))
    max_cols = int(report_cfg.get("max_table_columns", 8))
    max_summary_figures = int(report_cfg.get("max_summary_figures", 24))
    max_tracks_per_contrast = int(report_cfg.get("max_track_figures_per_contrast", 6))
    max_track_total = int(report_cfg.get("max_total_track_figures", 12))
    preview_dpi = int(report_cfg.get("preview_dpi", 220))
    if not 5 <= max_rows <= 25 or not 5 <= max_cols <= 12:
        raise InputBlocker("report table preview limits must be 5-25 rows and 5-12 columns")
    if not 1 <= max_summary_figures <= 40 or not 0 <= max_tracks_per_contrast <= 12 or not 0 <= max_track_total <= 30:
        raise InputBlocker("report figure limits are outside the fixed readable ranges")
    if not 120 <= preview_dpi <= 300:
        raise InputBlocker("report.preview_dpi must be 120-300")

    def read_csv(path: Path) -> pd.DataFrame:
        try:
            return pd.read_csv(path) if path.exists() and path.stat().st_size else pd.DataFrame()
        except Exception:
            return pd.DataFrame()

    annotation = read_csv(project_root / "02_single_cell" / "gene_annotation_normalized.csv")
    if annotation.empty:
        annotation = load_annotation(manifest.get("annotation"))
    set_active_annotation(annotation)

    def add_status_paragraph(value: str) -> None:
        add_note(document, value)

    document = Document()
    section = document.sections[0]
    section.top_margin = Inches(.7)
    section.bottom_margin = Inches(.7)
    section.left_margin = Inches(.7)
    section.right_margin = Inches(.7)
    styles = document.styles
    for style_name, size, bold, italic in [
        ("Normal", 10.5, False, False),
        ("Title", 22, True, False),
        ("Heading 1", 16, True, False),
        ("Heading 2", 13, True, False),
        ("Caption", 9, False, True),
    ]:
        styles[style_name].font.name = "Arial"
        styles[style_name].font.size = Pt(size)
        styles[style_name].font.bold = bold
        styles[style_name].font.italic = italic
        if style_name in ("Title", "Heading 1", "Heading 2"):
            styles[style_name].font.color.rgb = __import__("docx").shared.RGBColor(0x2B, 0x4C, 0x70)
    header = section.header.paragraphs[0]
    header.text = "scPURE analysis output"
    header.alignment = WD_ALIGN_PARAGRAPH.RIGHT
    footer = section.footer.paragraphs[0]
    footer.alignment = WD_ALIGN_PARAGRAPH.CENTER
    run = footer.add_run("Page ")
    fld = OxmlElement("w:fldSimple")
    fld.set(qn("w:instr"), "PAGE")
    run._r.addnext(fld)

    title = report_cfg.get("title", "scPURE Analysis Output Report")
    p_title = document.add_paragraph(style="Title")
    p_title.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p_title.add_run(title)
    p_project = document.add_paragraph()
    p_project.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p_project.add_run(manifest["project"].get("name", "Unnamed project")).bold = True
    p_meta = document.add_paragraph()
    p_meta.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p_meta.add_run(
        f"Species: {manifest['project'].get('species', 'Not specified')}\n"
        f"Genome build: {manifest['project'].get('genome_build', 'Not specified')}\n"
        f"Generated: {now_iso()}\n"
        f"scPURE skill version: {SKILL_VERSION}\n"
        "Report mode: descriptive output only"
    )
    document.add_page_break()
    document.add_heading("Table of contents", level=1)
    add_toc(document)
    document.add_page_break()

    document.add_heading("Run scope and configuration", level=1)
    document.add_paragraph(
        "This document records the configured analysis, quality-control summaries, statistical output tables, model metrics, ranked SHAP summaries, enrichment tables, binding-validation records, and artifact locations. It contains descriptive outputs only and excludes biological interpretation, causal claims, literature synthesis, and recommendations."
    )
    contrast_rows = [
        {
            "contrast_id": c.get("id"),
            "kind": c.get("kind"),
            "subset": c.get("subset", "all cells"),
            "focal_filter": c.get("focal_filter"),
            "reference_filter": c.get("reference_filter"),
            "focal_label": c.get("focal_label"),
            "reference_label": c.get("reference_label"),
        }
        for c in manifest.get("contrasts", [])
    ]
    if contrast_rows:
        add_dataframe(document, pd.DataFrame(contrast_rows), "Exact contrast definitions", source_rel="00_manifest/input_manifest.yml", max_rows=25, max_cols=8)

    document.add_heading("Input inventory and preflight status", level=1)
    hashes = read_csv(project_root / "00_manifest" / "input_hashes.csv")
    if not hashes.empty:
        compact = hashes.copy()
        compact["file"] = compact["absolute_path"].map(lambda x: Path(str(x)).name)
        compact["sha256"] = compact["sha256"].astype(str)
        compact = compact[[c for c in ("roles", "file", "size_bytes", "sha256") if c in compact.columns]]
        add_dataframe(
            document,
            compact,
            "Declared input files",
            source_rel="00_manifest/input_hashes.csv",
            max_rows=max_rows,
            max_cols=5,
            preferred_columns=["roles", "file", "size_bytes", "sha256"],
        )
    software = read_csv(project_root / "00_manifest" / "software_versions.csv")
    if not software.empty:
        software = software.copy()
        if "path" in software.columns:
            software["path"] = software["path"].map(lambda x: Path(str(x).replace("\\", "/")).name if pd.notna(x) and str(x).strip() else "")
        add_dataframe(
            document,
            software,
            "Pinned software audit",
            source_rel="00_manifest/software_versions.csv",
            max_rows=25,
            max_cols=7,
            preferred_columns=["name", "status", "version", "expected", "path"],
        )

    document.add_heading("Single-cell data and contrast audit", level=1)
    document.add_paragraph(
        "Cells were randomly equalized before pseudobulk aggregation. Cells are not biological replicates. Cell-type-versus-rest reference arms exclude the focal cell type. Paired designs use biological-sample blocking; mixed paired/unpaired structures are rejected."
    )
    levels = read_csv(project_root / "02_single_cell" / "metadata_levels.csv")
    if not levels.empty:
        add_dataframe(document, levels, "Metadata-level counts", source_rel="02_single_cell/metadata_levels.csv", max_rows=20, max_cols=5)
    for path in sorted((project_root / "03_differential_expression").glob("*/cell_balance.csv")):
        df = read_csv(path)
        if df.empty:
            continue
        included = df[df.get("status", "").astype(str).eq("included")].copy() if "status" in df.columns else df
        add_dataframe(
            document,
            included,
            f"Included cell-balance rows — {path.parent.name}",
            source_rel=str(path.relative_to(project_root)),
            max_rows=12,
            max_cols=7,
            preferred_columns=["sample_id", "arm", "cells_before", "cells_after", "pseudobulk_id", "status"],
        )
        if "status" in df.columns:
            dropped = df[~df["status"].astype(str).eq("included")]
            if not dropped.empty:
                drop_summary = dropped.groupby(["status", "drop_reason"], dropna=False).size().reset_index(name="rows")
                add_dataframe(document, drop_summary, f"Excluded cell-balance row counts — {path.parent.name}", source_rel=str(path.relative_to(project_root)), max_rows=10, max_cols=4)
    for path in sorted((project_root / "03_differential_expression").glob("*/pseudobulk_metadata.csv")):
        df = read_csv(path)
        if not df.empty:
            add_dataframe(document, df, f"Pseudobulk design — {path.parent.name}", source_rel=str(path.relative_to(project_root)), max_rows=12, max_cols=7)

    document.add_heading("Differential-expression outputs", level=1)
    backend = manifest.get("de", {}).get("backend", "pydeseq2")
    document.add_paragraph(
        f"Backend: {backend}. Thresholds: absolute log2 fold change >= {manifest.get('de', {}).get('lfc_threshold', 1.0)} and adjusted P value < {manifest.get('de', {}).get('qvalue_threshold', 0.05)}. Repeated equal-cell subsampling is recorded as a stability procedure and is not counted as additional biological replication."
    )
    de_summary_rows = []
    for path in sorted((project_root / "03_differential_expression").glob("*/deseq2_full_results.csv")):
        df = read_csv(path)
        if df.empty:
            continue
        direction = df.get("direction", pd.Series(dtype=str))
        de_summary_rows.append({
            "contrast": path.parent.name,
            "tested_genes": len(df),
            "up_DEGs": int((direction == "up").sum()),
            "down_DEGs": int((direction == "down").sum()),
            "not_significant": int((direction == "not_significant").sum()),
        })
        selected = []
        for direction_name in ("up", "down"):
            subset = df[df.get("direction", "").astype(str).eq(direction_name)].sort_values(["padj", "pvalue"], na_position="last").head(5)
            selected.append(subset)
        preview = pd.concat(selected, ignore_index=True) if selected else pd.DataFrame()
        if not preview.empty:
            add_dataframe(
                document,
                preview,
                f"Top adjusted-P-value DEG rows by direction — {path.parent.name}",
                source_rel=str(path.relative_to(project_root)),
                max_rows=10,
                max_cols=7,
                preferred_columns=["gene", "gene_id", "direction", "log2FoldChange", "padj", "baseMean"],
            )
    if de_summary_rows:
        add_dataframe(document, pd.DataFrame(de_summary_rows), "DEG counts by contrast", source_rel="03_differential_expression/", max_rows=25, max_cols=5)

    document.add_heading("Network harmonization", level=1)
    network_qc = read_csv(project_root / "04_network" / "network_qc.csv")
    if not network_qc.empty:
        add_dataframe(document, network_qc, "Network quality-control summary", source_rel="04_network/network_qc.csv", max_rows=10, max_cols=8)

    document.add_heading("CatBoost performance", level=1)
    document.add_paragraph("Metrics are computed from out-of-fold predictions. SHAP values used in downstream summaries are also out-of-fold.")
    for path in sorted((project_root / "05_model").glob("*/cv_metrics.csv")):
        df = read_csv(path)
        if df.empty:
            continue
        aggregate = aggregate_cv_metrics(df)
        add_dataframe(document, aggregate, f"Cross-validation metric summary — {path.parent.name}", source_rel=str(path.relative_to(project_root)), max_rows=10, max_cols=6)

    document.add_heading("SHAP-based TF ranking", level=1)
    document.add_paragraph(
        f"The configured top {manifest.get('model', {}).get('shap_keep_percent', 20)}% of absolute SHAP edge values is retained. SHAP sign denotes movement toward or away from the focal model class and is not labeled as activation or repression."
    )
    summary_paths = sorted((project_root / "06_shap").glob("*/SHAP_feature_summary_with_binding_validation.csv"))
    if not summary_paths:
        summary_paths = sorted((project_root / "05_model").glob("*/SHAP_feature_summary.csv"))
    for path in summary_paths:
        df = read_csv(path)
        if not df.empty:
            df = df.sort_values("sum_abs_shap", ascending=False)
            add_dataframe(
                document,
                df,
                f"Ranked TF summary — {path.parent.name}",
                source_rel=str(path.relative_to(project_root)),
                max_rows=15,
                max_cols=8,
                preferred_columns=["TF", "sum_abs_shap", "target_count_top20pct", "stability_score", "direct_validated_targets", "homolog_only_validated_targets"],
            )

    document.add_heading("Target and pathway output tables", level=1)
    target_files = sorted((project_root / "07_targets_pathways").rglob("*.csv"))
    for path in target_files[:12]:
        df = read_csv(path)
        if not df.empty:
            add_dataframe(document, df, f"{path.stem.replace('_', ' ')} — {path.parent.name}", source_rel=str(path.relative_to(project_root)), max_rows=10, max_cols=8)

    document.add_heading("Focus-TF target tables", level=1)
    for path in sorted((project_root / "08_focus_tfs").rglob("candidate_targets.csv"))[:20]:
        df = read_csv(path)
        if not df.empty:
            contrast = path.parents[1].name if len(path.parents) > 1 else ""
            tf_label = display_gene_label(path.parent.name)
            add_dataframe(
                document,
                df,
                f"Candidate targets — {contrast} — {tf_label}",
                source_rel=str(path.relative_to(project_root)),
                max_rows=15,
                max_cols=8,
                preferred_columns=["target", "target_tf_rank", "abs_shap", "shap_value", "direct_support_count", "homolog_support_count", "binding_validated"],
            )

    document.add_heading("Functional-enrichment tables", level=1)
    document.add_heading("GO Biological Process", level=2)
    document.add_paragraph(
        "The GO universe is restricted to modeled genes with GO annotation. Direct BP annotations are propagated to BP ancestors. Redundancy reduction uses the embedded deterministic Wang semantic-similarity implementation."
    )
    go_added = False
    for path in sorted((project_root / "09_go_bp").rglob("GO_BP_simplified.csv")):
        df = read_csv(path)
        if not df.empty:
            add_dataframe(document, df, f"GO BP table — {display_gene_label(path.parent.name)}", source_rel=str(path.relative_to(project_root)), max_rows=10, max_cols=8)
            go_added = True
    if not go_added:
        add_status_paragraph("GO Biological Process: not run or no rows passed the configured filters. See 09_go_bp status files.")

    document.add_heading("MapMan BIN enrichment", level=2)
    level = int(manifest.get("mapman", {}).get("enrichment_level", 3))
    document.add_paragraph(f"MapMan assignments are aggregated to BIN level {level}; the universe is restricted to modeled genes annotated at that level.")
    mapman_qc = read_csv(project_root / "09_mapman" / "MapMan_annotation_qc.csv")
    if not mapman_qc.empty:
        add_dataframe(document, mapman_qc, "MapMan annotation QC", source_rel="09_mapman/MapMan_annotation_qc.csv", max_rows=5, max_cols=10)
    mapman_added = False
    for path in sorted((project_root / "09_mapman").rglob(f"MapMan_BIN{level}_significant.csv")):
        df = read_csv(path)
        if not df.empty:
            add_dataframe(document, df, f"MapMan BIN{level} table — {display_gene_label(path.parent.name)}", source_rel=str(path.relative_to(project_root)), max_rows=10, max_cols=8)
            mapman_added = True
    if not mapman_added:
        add_status_paragraph("MapMan: not run or no rows passed the configured filters. See 09_mapman status files.")

    document.add_heading("Within-species protein-homology records", level=1)
    document.add_paragraph(
        f"BLAST is restricted to the supplied same-species proteome. Eligibility requires at least {manifest.get('homology', {}).get('minimum_identity_percent', 60)}% identity plus the configured query and subject coverage thresholds. Direct-TF binding records remain distinct from homolog binding records."
    )
    homologs = read_csv(project_root / "10_homology" / "self_blast_filtered_homologs.csv")
    if not homologs.empty:
        add_dataframe(document, homologs, "Filtered within-species homolog records", source_rel="10_homology/self_blast_filtered_homologs.csv", max_rows=20, max_cols=8)

    document.add_heading("Promoter-overlap binding-validation records", level=1)
    document.add_paragraph(
        "The selected transcript is determined by summed exon length, then CDS length, transcript span, and transcript ID. Promoters are strand-aware TSS -2,000 bp to +500 bp intervals. binding_validated=true requires peak overlap with that promoter. bigWig signal is recorded as contextual signal and does not replace peak overlap."
    )
    binding = read_csv(project_root / "11_binding_validation" / "binding_validation_all_contrasts.csv")
    if not binding.empty:
        summary = binding.groupby("contrast", as_index=False).agg(
            retained_edges=("target_gene_id", "size"),
            binding_validated=("binding_validated", "sum"),
            direct_validated=("direct_support_count", lambda x: int((pd.to_numeric(x, errors="coerce").fillna(0) > 0).sum())),
            homolog_validated=("homolog_support_count", lambda x: int((pd.to_numeric(x, errors="coerce").fillna(0) > 0).sum())),
        )
        add_dataframe(document, summary, "Binding-validation counts", source_rel="11_binding_validation/binding_validation_all_contrasts.csv", max_rows=25, max_cols=5)
        preview = binding.sort_values(["binding_validated", "direct_support_count", "target_tf_rank"], ascending=[False, False, True])
        add_dataframe(
            document,
            preview,
            "Binding-validation record preview",
            source_rel="11_binding_validation/binding_validation_all_contrasts.csv",
            max_rows=15,
            max_cols=9,
            preferred_columns=["contrast", "TF", "target", "target_tf_rank", "validation_source", "validation_level", "direct_support_count", "homolog_support_count"],
        )

    document.add_heading("Genome-track inventory", level=1)
    track_frames = []
    for path in sorted((project_root / "12_tracks").glob("*/track_inventory.csv")):
        df = read_csv(path)
        if not df.empty:
            df["contrast"] = path.parent.name
            track_frames.append(df)
    track_inventory = pd.concat(track_frames, ignore_index=True) if track_frames else pd.DataFrame()
    if not track_inventory.empty:
        created = track_inventory[track_inventory.get("status", "").astype(str).eq("created")].copy()
        add_dataframe(
            document,
            track_inventory,
            "Genome-track inventory",
            source_rel="12_tracks/*/track_inventory.csv",
            max_rows=20,
            max_cols=10,
            preferred_columns=["contrast", "TF", "target", "evidence_group", "target_tf_rank", "region", "signal_tracks", "status"],
        )
    else:
        created = pd.DataFrame()
        add_status_paragraph("Genome tracks: no track inventory was generated.")

    if not created.empty and max_track_total > 0 and max_tracks_per_contrast > 0:
        add_landscape_section(document)
        document.add_heading("Genome-track pages", level=1)
        document.add_paragraph(
            "Track pages are promoter-centered and use symbol-first labels. Direct and homolog evidence are displayed on separate pages. Peak labels are suppressed, the target transcript is the only labeled gene model, and each page is inserted at landscape width. Complete vector PDFs and INI files remain under 12_tracks."
        )
        preview_dir = out_path.parent / "track_previews"
        preview_dir.mkdir(parents=True, exist_ok=True)
        selected_rows = []
        for contrast, group in created.groupby("contrast", sort=True):
            group = group.assign(_direct=(group.get("evidence_group", "") == "direct").astype(int))
            group = group.sort_values(["_direct", "target_tf_rank", "TF", "target_gene_id", "page"], ascending=[False, True, True, True, True])
            selected_rows.append(group.head(max_tracks_per_contrast))
        selected_tracks = pd.concat(selected_rows, ignore_index=True).head(max_track_total) if selected_rows else pd.DataFrame()
        figure_no = 1
        for row in selected_tracks.itertuples(index=False):
            pdf = Path(str(row.pdf))
            if not pdf.is_file():
                continue
            png = preview_dir / (re.sub(r"[^A-Za-z0-9_.-]+", "_", str(pdf.relative_to(project_root))) + ".png")
            if not pdf_to_png(pdf, png, preview_dpi):
                continue
            document.add_picture(str(png), width=Inches(10.2))
            cap = document.add_paragraph(style="Caption")
            cap.alignment = WD_ALIGN_PARAGRAPH.CENTER
            cap.add_run(
                f"Track {figure_no}. {display_gene_label(row.TF)} / target {display_gene_label(row.target_gene_id)}; "
                f"{row.evidence_group} evidence; region {row.region}. Vector source: {pdf.relative_to(project_root)}"
            )
            figure_no += 1
            document.add_page_break()
        add_portrait_section(document)

    document.add_heading("Cross-contrast descriptive matrices", level=1)
    selected_cross = [
        "top_TFs_across_contrasts_long.csv",
        "top_TFs_rank_matrix.csv",
        "top_TFs_fraction_matrix.csv",
        "TF_target_validation_across_contrasts.csv",
        "contrast_edge_jaccard.csv",
    ]
    for name in selected_cross:
        path = project_root / "13_cross_contrast" / name
        df = read_csv(path)
        if not df.empty:
            add_dataframe(document, df, path.stem.replace("_", " ").title(), source_rel=str(path.relative_to(project_root)), max_rows=10, max_cols=8)

    document.add_heading("Method definitions and scope limits", level=1)
    scope_rows = pd.DataFrame([
        {"item": "SHAP sign", "definition": "movement toward or away from the focal model class; not activation or repression"},
        {"item": "binding_validated", "definition": "promoter-overlapping direct-TF or eligible same-species-homolog peak"},
        {"item": "bigWig signal", "definition": "contextual signal only; not a replacement for promoter peak overlap"},
        {"item": "homolog evidence", "definition": "reported separately from direct-TF evidence"},
        {"item": "missing assay", "definition": "not_testable; not recorded as a negative biological result"},
        {"item": "subsampling repeat", "definition": "stability procedure; not an additional biological replicate"},
    ])
    add_dataframe(document, scope_rows, "Fixed method definitions", max_rows=10, max_cols=2)

    document.add_heading("Reproducibility and artifact summary", level=1)
    thread_resolution = read_csv(project_root / "00_manifest" / "thread_resolution.csv")
    if not thread_resolution.empty:
        scalar_cols = [c for c in ("logical_cpu_count", "available_cpu_count", "policy", "source", "idle_cpu_threshold_percent", "thread_sample_seconds", "estimated_idle_cpu_count", "resolved_threads") if c in thread_resolution.columns]
        add_dataframe(document, thread_resolution[scalar_cols], "Resolved thread policy", source_rel="00_manifest/thread_resolution.csv", max_rows=3, max_cols=8)
    parameter_rows = []
    for section_name in ("resources", "de", "model", "go", "mapman", "homology", "binding", "tracks", "report"):
        for key, value in manifest.get(section_name, {}).items():
            if any(token in key.lower() for token in ("path", "fasta", "gff", "manifest")) and value:
                display_value = Path(str(value)).name
            elif isinstance(value, (list, dict)):
                display_value = json.dumps(value, ensure_ascii=False)
            else:
                display_value = value
            parameter_rows.append({"section": section_name, "parameter": key, "value": display_value})
    add_dataframe(document, pd.DataFrame(parameter_rows), "Resolved analysis parameters", source_rel="00_manifest/input_manifest.yml", max_rows=40, max_cols=3)

    inventory_rows = []
    full_inventory = []
    for file in sorted(project_root.rglob("*")):
        if not file.is_file():
            continue
        rel = file.relative_to(project_root)
        full_inventory.append({"relative_path": str(rel), "size_bytes": file.stat().st_size})
    inventory_df = pd.DataFrame(full_inventory, columns=["relative_path", "size_bytes"])
    atomic_write_csv(out_path.parent / "output_inventory.csv", inventory_df)
    if not inventory_df.empty:
        inventory_df["stage"] = inventory_df["relative_path"].str.split("/", n=1).str[0]
        inventory_rows = inventory_df.groupby("stage", as_index=False).agg(file_count=("relative_path", "size"), total_bytes=("size_bytes", "sum"))
        add_dataframe(document, inventory_rows, "Artifact counts by stage", source_rel="14_report/output_inventory.csv", max_rows=25, max_cols=3)

    document.add_heading("Selected non-track figures", level=1)
    preview_dir = out_path.parent / "figure_previews"
    preview_dir.mkdir(parents=True, exist_ok=True)
    priority = ["ROC_curves", "performance_metrics", "top_TFs_directional_SHAP", "top_TFs_sum_abs_SHAP", "top_TFs_SHAP_dotplot", "top_TFs_target_count", "PR_curves"]
    def _fig_key(pdf: Path) -> tuple[int, str]:
        rank = next((i for i, p in enumerate(priority) if pdf.stem.startswith(p)), len(priority))
        return (rank, str(pdf.relative_to(project_root)))
    candidate_pdfs = sorted(
        (pdf for pdf in project_root.rglob("*.pdf") if "14_report" not in pdf.parts and "12_tracks" not in pdf.parts),
        key=_fig_key,
    )
    figure_no = 1
    for pdf in candidate_pdfs[:max_summary_figures]:
        png = preview_dir / (re.sub(r"[^A-Za-z0-9_.-]+", "_", str(pdf.relative_to(project_root))) + ".png")
        if not pdf_to_png(pdf, png, preview_dpi):
            continue
        try:
            import fitz as _fitz
            with _fitz.open(str(pdf)) as _d:
                native_in = _d[0].rect.width / 72.0
        except Exception:
            native_in = 4.0
        document.add_picture(str(png), width=Inches(min(6.7, max(2.6, native_in * 1.6))))
        document.paragraphs[-1].alignment = WD_ALIGN_PARAGRAPH.CENTER
        cap = document.add_paragraph(style="Caption")
        cap.alignment = WD_ALIGN_PARAGRAPH.CENTER
        cap.add_run(f"Figure {figure_no}. {pdf.stem.replace('_', ' ')}. Vector source: {pdf.relative_to(project_root)}")
        figure_no += 1
        document.add_page_break()

    violations = report_text_lint(document)
    policy = {
        "descriptive_only": True,
        "biological_interpretation_included": False,
        "conclusions_included": False,
        "literature_synthesis_included": False,
        "absolute_paths_in_main_report": False,
        "table_preview_rows": max_rows,
        "table_preview_columns": max_cols,
        "summary_figure_cap": max_summary_figures,
        "track_figure_cap_per_contrast": max_tracks_per_contrast,
        "track_figure_cap_total": max_track_total,
        "lint_violations": violations,
    }
    atomic_write_json(out_path.parent / "report_policy.json", policy)
    if violations:
        raise ScPUREError("Report conclusion-language lint failed:\n" + "\n".join(violations))
    out_path.parent.mkdir(parents=True, exist_ok=True)
    document.save(out_path)


def validate_manifest(manifest: Mapping[str, Any]) -> list[str]:
    blockers: list[str] = []
    for section, key in (("single_cell", "r_environment"), ("de", "r_environment"), ("go", "environment"), ("go", "legacy_environment")):
        value = manifest.get(section, {}).get(key)
        if value not in (None, "", "scPURE_agent"):
            blockers.append(f"{section}.{key} must be omitted or equal scPURE_agent; this skill creates exactly one environment")
    try:
        project = manifest["project"]
        ensure_dir(project["output_dir"], "project.output_dir", create=True)
        genomic_active = bool(manifest.get("binding", {}).get("enabled", True) or manifest.get("genome", {}).get("gff") or manifest.get("binding", {}).get("peak_manifest"))
        if genomic_active and (not str(project.get("genome_build", "")).strip() or str(project.get("genome_build", "")).startswith("REQUIRED")):
            blockers.append("project.genome_build must be the exact assembly identifier used by GFF, peaks, and bigWigs when genomic validation is enabled")
    except Exception as exc: blockers.append(str(exc))
    try:
        sc = manifest["single_cell"]; path = ensure_file(sc["path"], "single_cell.path")
        if path.suffix.lower() not in {".loom", ".rds"}: blockers.append("Only .loom and .rds containing a Seurat object are supported")
        if not sc.get("sample_field"): blockers.append("single_cell.sample_field is required and must identify independent biological samples")
    except Exception as exc: blockers.append(str(exc))
    contrasts = manifest.get("contrasts", [])
    if not contrasts: blockers.append("At least one contrast is required")
    ids = [str(x.get("id", "")) for x in contrasts]
    if any(not x for x in ids) or len(ids) != len(set(ids)): blockers.append("Every contrast requires a unique non-empty id")
    for contrast in contrasts:
        missing = [x for x in ("kind", "focal_filter", "reference_filter", "focal_label", "reference_label") if not contrast.get(x)]
        if missing: blockers.append(f"{contrast.get('id', '<unnamed>')}: missing contrast fields {missing}")
        if contrast.get("kind") not in {"celltype_vs_rest", "within_celltype_group"}: blockers.append(f"{contrast.get('id')}: unsupported kind")
        if contrast.get("focal_filter") == contrast.get("reference_filter"): blockers.append(f"{contrast.get('id')}: focal and reference filters must differ")
        if contrast.get("kind") == "celltype_vs_rest" and str(contrast.get("reference_filter", "")).strip().lower() in {"all", "all cells", "true"}:
            blockers.append(f"{contrast.get('id')}: reference_filter must explicitly exclude the focal cell type; 'all cells' cannot include the focal cells")
    de = manifest.get("de", {})
    if de.get("backend", "pydeseq2") not in {"pydeseq2", "r_deseq2"}: blockers.append("de.backend must be pydeseq2 or r_deseq2")
    if int(de.get("repeated_subsamples", 10)) < 1: blockers.append("de.repeated_subsamples must be >=1; equal-cell random balancing cannot be disabled")
    try: ensure_file(manifest["network"]["path"], "network.path")
    except Exception as exc: blockers.append(str(exc))
    ann = manifest.get("annotation", {})
    if ann.get("path") or ann.get("gene_table"):
        try: ensure_file(ann.get("path") or ann.get("gene_table"), "annotation.path")
        except Exception as exc: blockers.append(str(exc))
    for label, value in (("focus.target_or_pathway_file", manifest.get("focus", {}).get("target_or_pathway_file")), ("genome.protein_fasta", manifest.get("genome", {}).get("protein_fasta")), ("genome.gff", manifest.get("genome", {}).get("gff")), ("go.obo_path", manifest.get("go", {}).get("obo_path")), ("mapman.path", manifest.get("mapman", {}).get("path"))):
        if value:
            try: ensure_file(value, label)
            except Exception as exc: blockers.append(str(exc))
    resources = manifest.get("resources", {})
    if resources.get("threads") not in (None, "", "auto", "auto_half_idle") and _positive_int(resources.get("threads")) is None:
        blockers.append("resources.threads must be a positive integer, null, 'auto', or 'auto_half_idle'")
    try:
        threshold = float(resources.get("idle_cpu_threshold_percent", 20.0)); sample_seconds = float(resources.get("thread_sample_seconds", 0.5))
        if not 0 <= threshold <= 100: blockers.append("resources.idle_cpu_threshold_percent must be between 0 and 100")
        if not 0.1 <= sample_seconds <= 10: blockers.append("resources.thread_sample_seconds must be between 0.1 and 10 seconds")
    except Exception:
        blockers.append("resources idle-thread settings must be numeric")
    mapman = manifest.get("mapman", {})
    enabled = mapman.get("enabled", "auto")
    if enabled not in (True, False, "auto", None): blockers.append("mapman.enabled must be true, false, or auto")
    if enabled is True and not mapman.get("path"): blockers.append("mapman.enabled=true requires mapman.path")
    try:
        level = int(mapman.get("enrichment_level", 3))
        if not 1 <= level <= 12: blockers.append("mapman.enrichment_level must be between 1 and 12")
        if int(mapman.get("min_bin_size", 5)) < 1 or int(mapman.get("max_bin_size", 5000)) < int(mapman.get("min_bin_size", 5)):
            blockers.append("mapman min/max bin sizes are invalid")
        if int(mapman.get("min_overlap", 3)) < 1: blockers.append("mapman.min_overlap must be >=1")
        if not 0 < float(mapman.get("qvalue_threshold", 0.05)) <= 1: blockers.append("mapman.qvalue_threshold must be in (0,1]")
    except Exception:
        blockers.append("mapman enrichment parameters must be numeric")
    model = manifest.get("model", {})
    keep = float(model.get("shap_keep_percent", 20)); rank = int(model.get("per_target_tf_rank", 20))
    if not 0 < keep <= 100: blockers.append("model.shap_keep_percent must be in (0,100]")
    if rank < 1: blockers.append("model.per_target_tf_rank must be >=1")
    focus = manifest.get("focus", {})
    try:
        if not 1 <= int(focus.get("max_plot_targets", 25)) <= 50:
            blockers.append("focus.max_plot_targets must be between 1 and 50")
        if not 1 <= int(focus.get("max_network_edges", 40)) <= 80:
            blockers.append("focus.max_network_edges must be between 1 and 80")
    except Exception:
        blockers.append("focus plot-size limits must be integers")
    tracks = manifest.get("tracks", {})
    try:
        if tracks.get("region_mode", "promoter_centered") != "promoter_centered":
            blockers.append("tracks.region_mode is fixed to promoter_centered for readability")
        if not 1 <= int(tracks.get("max_signal_tracks_per_page", 4)) <= 6:
            blockers.append("tracks.max_signal_tracks_per_page must be between 1 and 6")
        if not 1000 <= int(tracks.get("max_region_bp", 50000)) <= 100000:
            blockers.append("tracks.max_region_bp must be between 1,000 and 100,000")
        if not 0 <= int(tracks.get("region_upstream_bp", 5000)) <= 50000 or not 0 <= int(tracks.get("region_downstream_bp", 3000)) <= 50000:
            blockers.append("tracks region upstream/downstream values must each be 0-50,000 bp")
        if not 24 <= float(tracks.get("width_cm", 32)) <= 40:
            blockers.append("tracks.width_cm must be 24-40 for readable labels")
        if not 16 <= float(tracks.get("plot_width_cm", 23)) <= 32:
            blockers.append("tracks.plot_width_cm must be 16-32")
        if not 0.18 <= float(tracks.get("track_label_fraction", 0.24)) <= 0.35:
            blockers.append("tracks.track_label_fraction must be 0.18-0.35")
        if not 8 <= float(tracks.get("font_size", 9)) <= 12:
            blockers.append("tracks.font_size must be 8-12")
        if not 15 <= int(tracks.get("max_track_title_chars", 30)) <= 50:
            blockers.append("tracks.max_track_title_chars must be 15-50")
    except Exception:
        blockers.append("tracks readability parameters must be numeric")
    report = manifest.get("report", {})
    if report.get("descriptive_only", True) is not True:
        blockers.append("report.descriptive_only is fixed to true")
    if report.get("include_absolute_paths", False) is not False:
        blockers.append("report.include_absolute_paths is fixed to false")
    if report.get("include_all_vector_figures", False) is not False:
        blockers.append("report.include_all_vector_figures is fixed to false; full vector files remain in stage folders")
    try:
        if not 5 <= int(report.get("max_table_rows", 10)) <= 25:
            blockers.append("report.max_table_rows must be 5-25")
        if not 5 <= int(report.get("max_table_columns", 8)) <= 12:
            blockers.append("report.max_table_columns must be 5-12")
        if not 1 <= int(report.get("max_summary_figures", 24)) <= 40:
            blockers.append("report.max_summary_figures must be 1-40")
        if not 0 <= int(report.get("max_track_figures_per_contrast", 6)) <= 12:
            blockers.append("report.max_track_figures_per_contrast must be 0-12")
        if not 0 <= int(report.get("max_total_track_figures", 12)) <= 30:
            blockers.append("report.max_total_track_figures must be 0-30")
        if not 120 <= int(report.get("preview_dpi", 220)) <= 300:
            blockers.append("report.preview_dpi must be 120-300")
    except Exception:
        blockers.append("report readability limits must be numeric")
    binding = manifest.get("binding", {})
    if binding.get("enabled", True):
        if not binding.get("peak_manifest"):
            blockers.append("binding.enabled=true requires binding.peak_manifest with tf_gene_id, tf_symbol, peak_path, and bigwig_path")
        if not manifest.get("genome", {}).get("gff"):
            blockers.append("binding.enabled=true requires genome.gff")
        if binding.get("peak_manifest"):
            try: expand_peak_manifest(ensure_file(binding["peak_manifest"], "binding.peak_manifest"), str(manifest.get("project", {}).get("genome_build", "")), bool(binding.get("require_matching_genome_build", True)))
            except Exception as exc: blockers.append(str(exc))
    return blockers


def prepare_project_dirs(root: Path) -> None:
    for sub in ["00_manifest", "01_preflight", "02_single_cell", "03_differential_expression", "04_network", "05_model", "06_shap", "07_targets_pathways", "08_focus_tfs", "09_go_bp", "09_mapman", "10_homology", "11_binding_validation", "12_tracks", "13_cross_contrast", "14_report", "logs"]:
        (root / sub).mkdir(parents=True, exist_ok=True)


def write_input_hash_inventory(manifest: Mapping[str, Any], manifest_path: Path, out_path: Path) -> pd.DataFrame:
    """Hash every declared primary input and every expanded peak/bigWig replicate.

    Hashes are content-based SHA-256 values. Duplicate physical paths are hashed
    once and retain all logical roles in a semicolon-separated label field.
    """
    declared: list[tuple[str, Path]] = [("manifest", ensure_file(manifest_path, "manifest"))]
    candidates = [
        ("single_cell.path", manifest.get("single_cell", {}).get("path")),
        ("network.path", manifest.get("network", {}).get("path")),
        ("focus.target_or_pathway_file", manifest.get("focus", {}).get("target_or_pathway_file")),
        ("focus.expression_table", manifest.get("focus", {}).get("expression_table")),
        ("annotation.path", manifest.get("annotation", {}).get("path") or manifest.get("annotation", {}).get("gene_table")),
        ("go.obo_path", manifest.get("go", {}).get("obo_path")),
        ("mapman.path", manifest.get("mapman", {}).get("path")),
        ("genome.protein_fasta", manifest.get("genome", {}).get("protein_fasta")),
        ("genome.gff", manifest.get("genome", {}).get("gff")),
        ("binding.peak_manifest", manifest.get("binding", {}).get("peak_manifest")),
    ]
    for label, value in candidates:
        if value:
            declared.append((label, ensure_file(value, label)))
    if manifest.get("binding", {}).get("enabled", True) and manifest.get("binding", {}).get("peak_manifest"):
        expanded = expand_peak_manifest(
            ensure_file(manifest["binding"]["peak_manifest"], "binding.peak_manifest"),
            str(manifest.get("project", {}).get("genome_build", "")),
            bool(manifest.get("binding", {}).get("require_matching_genome_build", True)),
        )
        for row in expanded.itertuples(index=False):
            role = f"binding:{row.tf_gene_id}:{row.replicate}"
            declared.append((role + ":peak", Path(row.peak_path)))
            declared.append((role + ":bigwig", Path(row.bigwig_path)))
    roles_by_path: dict[str, set[str]] = defaultdict(set)
    path_objects: dict[str, Path] = {}
    for role, path in declared:
        resolved = path.resolve()
        key = str(resolved)
        roles_by_path[key].add(role)
        path_objects[key] = resolved
    rows: list[dict[str, Any]] = []
    for key in sorted(path_objects):
        path = path_objects[key]
        stat = path.stat()
        rows.append({
            "roles": ";".join(sorted(roles_by_path[key])),
            "absolute_path": key,
            "size_bytes": int(stat.st_size),
            "mtime_ns": int(stat.st_mtime_ns),
            "sha256": sha256_file(path),
        })
    inventory = pd.DataFrame(rows)
    atomic_write_csv(out_path, inventory)
    return inventory


def run_project(manifest_path: str, runtime_dir: str, threads: int | None = None, strict_environment: bool = True) -> Path:
    if not strict_environment:
        raise InputBlocker("Scientific execution with version mismatches is prohibited. Repair and activate scPURE_agent, then rerun.")
    manifest = load_manifest(manifest_path)
    blockers = validate_manifest(manifest)
    if blockers: raise InputBlocker("Manifest validation failed:\n- " + "\n- ".join(blockers))
    root = ensure_dir(manifest["project"]["output_dir"], "project.output_dir", create=True); runtime = ensure_dir(runtime_dir, "runtime directory")
    prepare_project_dirs(root)
    threads, thread_details = resolve_thread_count(threads, manifest.get("resources", {}))
    apply_thread_limits(threads)
    atomic_write_json(root / "00_manifest" / "thread_resolution.json", thread_details)
    atomic_write_csv(root / "00_manifest" / "thread_resolution.csv", pd.DataFrame([{k: json.dumps(v) if isinstance(v, (list, dict)) else v for k, v in thread_details.items()}]))
    lock_source = runtime / "environment_lock"
    if lock_source.is_dir():
        lock_target = root / "00_manifest" / "environment_lock"
        lock_target.mkdir(parents=True, exist_ok=True)
        for lock_file in lock_source.glob("*.txt"):
            shutil.copy2(lock_file, lock_target / lock_file.name)
    atomic_write_text(root / "00_manifest" / "input_manifest.yml", yaml.safe_dump(manifest, sort_keys=False, allow_unicode=True))
    write_input_hash_inventory(manifest, ensure_file(manifest_path, "manifest"), root / "00_manifest" / "input_hashes.csv")
    sw = doctor(strict=strict_environment); atomic_write_csv(root / "00_manifest" / "software_versions.csv", sw)
    atomic_write_json(root / "00_manifest" / "system_info.json", {"platform": platform.platform(), "python": sys.version, "cpu_count": os.cpu_count(), "resolved_threads": threads, "thread_policy": thread_details.get("policy"), "skill_version": SKILL_VERSION, "run_start": now_iso()})
    annotation = load_annotation(manifest.get("annotation"))
    set_active_annotation(annotation)
    if not annotation.empty:
        atomic_write_csv(root / "02_single_cell" / "gene_annotation_normalized.csv", annotation)
    matrix, genes, metadata, _ = load_single_cell(manifest, runtime, root / "02_single_cell")
    de_results = run_differential_expression(matrix, genes, metadata, manifest, runtime, root / "03_differential_expression", threads)
    network, network_long = normalize_network(ensure_file(manifest["network"]["path"], "network"), manifest["network"], root / "04_network")
    mapman_mapping = pd.DataFrame()
    mapman_cfg = manifest.get("mapman", {})
    mapman_enabled = mapman_cfg.get("enabled", "auto") is True or (mapman_cfg.get("enabled", "auto") in ("auto", None) and bool(mapman_cfg.get("path")))
    if mapman_enabled:
        mapman_mapping, mapman_qc = load_mapman_annotation(ensure_file(mapman_cfg["path"], "mapman.path"), mapman_cfg)
        level = int(mapman_cfg.get("enrichment_level", 3))
        atomic_write_csv(root / "09_mapman" / f"MapMan_gene_to_BIN{level}.csv", mapman_mapping)
        atomic_write_csv(root / "09_mapman" / "MapMan_annotation_qc.csv", mapman_qc)
    model_outputs: dict[str, dict[str, Path]] = {}
    for contrast_id, de_paths in de_results.items():
        cdir = root / "05_model" / contrast_id; cdir.mkdir(parents=True, exist_ok=True)
        cdef = next((c for c in manifest["contrasts"] if str(c.get("id")) == str(contrast_id)), {})
        model_cfg = {**manifest["model"], "_focal_label": cdef.get("focal_label", "focal"), "_reference_label": cdef.get("reference_label", "reference")}
        model_outputs[contrast_id] = fit_catboost_oof(network, de_paths["labels"], model_cfg, cdir, derive_seed(int(manifest["project"].get("seed", DEFAULT_SEED)), contrast_id), threads)
    # BLAST all requested TFs, global top TFs, and TFs ranked for requested targets/pathways.
    focus_tfs = set(map(str, manifest.get("focus", {}).get("tfs", [])))
    requested_targets = set(map(str, manifest.get("focus", {}).get("target_genes", [])))
    focus_path = manifest.get("focus", {}).get("target_or_pathway_file")
    if focus_path:
        focus_df = read_table(ensure_file(focus_path, "focus.target_or_pathway_file")); target_col = manifest.get("focus", {}).get("target_column", "gene_id")
        if target_col in focus_df.columns: requested_targets.update(focus_df[target_col].dropna().astype(str))
    for outputs in model_outputs.values():
        summary = pd.read_csv(outputs["summary"]); focus_tfs.update(summary.head(int(manifest["model"].get("top_tfs", 20)))["TF"].astype(str))
        rank = pd.read_csv(outputs["rank_long"])
        if requested_targets:
            focus_tfs.update(rank[(rank["target_gene_id"].astype(str).isin(requested_targets)) & (rank["target_tf_rank"] <= int(manifest["model"].get("per_target_tf_rank", 20)))]["TF"].astype(str))
    homologs: dict[str, list[HomologHit]] = {}
    if manifest.get("genome", {}).get("protein_fasta"):
        _, homologs = run_self_blast(ensure_file(manifest["genome"]["protein_fasta"], "protein FASTA"), annotation, manifest.get("homology", {}), sorted(focus_tfs), root / "10_homology", threads)
    promoter_map: dict[str, PromoterRecord] = {}; selected_tx: dict[str, TranscriptRecord] = {}
    if manifest.get("genome", {}).get("gff"):
        _, selected_tx = select_longest_transcripts(ensure_file(manifest["genome"]["gff"], "GFF/GTF"))
        _, promoter_map = generate_promoters(ensure_file(manifest["genome"]["gff"], "GFF/GTF"), int(manifest.get("binding", {}).get("promoter_upstream_bp", 2000)), int(manifest.get("binding", {}).get("promoter_downstream_bp", 500)), root / "11_binding_validation")
    peak_manifest = None
    if manifest.get("binding", {}).get("enabled", True):
        peak_manifest = expand_peak_manifest(ensure_file(manifest["binding"]["peak_manifest"], "peak manifest"), str(manifest["project"]["genome_build"]), bool(manifest["binding"].get("require_matching_genome_build", True)))
        atomic_write_csv(root / "11_binding_validation" / "peak_manifest_normalized.csv", peak_manifest)
        peak_manifest = preflight_peak_manifest(peak_manifest, promoter_map, root / "11_binding_validation")
    all_validation: list[pd.DataFrame] = []
    for contrast_id, outputs in model_outputs.items():
        rank_long = pd.read_csv(outputs["rank_long"])
        rank_long = rank_long.merge(network_long.rename(columns={"target": "target_gene_id"}), on=["TF", "target_gene_id"], how="left")
        if peak_manifest is not None and promoter_map:
            validation = validate_binding(rank_long, promoter_map, peak_manifest, homologs, annotation, root / "11_binding_validation" / contrast_id)
        else:
            validation = rank_long.copy(); validation["binding_validated"] = False; validation["validation_source"] = "not_run"; validation["validation_level"] = "not_run"
            for col, default in {"homolog_support_count":0, "direct_support_count":0, "peak_count":0, "max_bigwig_signal":np.nan, "supporting_track_rows_json":"[]"}.items(): validation[col]=default
        validation.insert(0, "contrast", contrast_id); all_validation.append(validation)
        shap_dir = root / "06_shap" / contrast_id; shap_dir.mkdir(parents=True, exist_ok=True)
        atomic_write_csv(shap_dir / "SHAP_edges_with_binding_validation.csv", validation)
        summary = pd.read_csv(outputs["summary"]); plot_tf_summary(summary, validation, shap_dir, top_n=int(manifest["model"].get("top_tfs", 20)))
        analyze_targets_pathways(validation, manifest, annotation, root / "07_targets_pathways" / contrast_id)
        analyze_focus_tfs(
            validation,
            manifest,
            annotation,
            set(network.index),
            root / "08_focus_tfs" / contrast_id,
            runtime,
            root / "09_go_bp" / contrast_id,
            mapman_mapping,
            root / "09_mapman" / contrast_id,
        )
        track_cfg = {**manifest.get("tracks", {}), "per_target_tf_rank": int(manifest.get("model", {}).get("per_target_tf_rank", 20))}
        if promoter_map and selected_tx and not validation.empty:
            render_tracks(validation, promoter_map, selected_tx, track_cfg, root / "12_tracks" / contrast_id, annotation)
    combined_validation = pd.concat(all_validation, ignore_index=True) if all_validation else pd.DataFrame()
    atomic_write_csv(root / "11_binding_validation" / "binding_validation_all_contrasts.csv", combined_validation)
    compare_contrasts(model_outputs, combined_validation, manifest, root / "13_cross_contrast")
    build_word_report(root, manifest, root / "14_report" / "scPURE_report.docx")
    atomic_write_json(root / "00_manifest" / "run_complete.json", {"status": "complete", "completed": now_iso(), "skill_version": SKILL_VERSION, "report": str(root / "14_report" / "scPURE_report.docx")})
    return root


def main() -> None:
    parser = argparse.ArgumentParser(description="Embedded scPURE skill runtime. This script is materialized and invoked by an agent; it is not an installed CLI product.")
    parser.add_argument("--manifest", required=True)
    parser.add_argument("--runtime-dir", required=True)
    parser.add_argument("--threads", type=int, default=None, help="Explicit positive thread count. Omit to use half of currently idle available logical CPUs.")
    ns = parser.parse_args()
    root = run_project(ns.manifest, ns.runtime_dir, ns.threads, True)
    print(root)


if __name__ == "__main__":
    main()
~~~~
