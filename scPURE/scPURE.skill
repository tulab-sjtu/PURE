class SymbolAndReportPolicyTests(unittest.TestCase):
    def test_symbol_first_labels_and_duplicate_disambiguation(self) -> None:
        import scpure_runtime as runtime
        annotation = pd.DataFrame({
            "gene_id": ["g1", "g2", "g3", "g4"],
            "symbol": ["MYB1", "DUP", "DUP", ""],
            "go_terms": ["", "", "", ""],
        })
        runtime.set_active_annotation(annotation)
        self.assertEqual(runtime.display_gene_label("g1"), "MYB1")
        self.assertEqual(runtime.display_gene_label("g2"), "DUP_g2")
        self.assertEqual(runtime.display_gene_label("g3"), "DUP_g3")
        self.assertEqual(runtime.display_gene_label("g4"), "g4")
        decorated = runtime.decorate_gene_columns(pd.DataFrame({"gene_id": ["g1"], "TF": ["g2"], "target_gene_id": ["g4"]}))
        self.assertEqual(decorated.loc[0, "gene_label"], "MYB1")
        self.assertEqual(decorated.loc[0, "TF_label"], "DUP_g2")
        self.assertEqual(decorated.loc[0, "target_gene_label"], "g4")

    def test_readable_track_layout_and_symbol_titles(self) -> None:
        import scpure_runtime as runtime
        from scpure_runtime import PromoterRecord, TranscriptRecord, render_tracks
        with tempfile.TemporaryDirectory() as td:
            root = Path(td)
            peak = root / "tf.narrowPeak"
            bw = root / "tf.bw"
            peak.write_text("chr1\t95\t115\n", encoding="utf-8")
            bw.write_bytes(b"bw")
            annotation = pd.DataFrame({"gene_id": ["TF1", "TG1", "TFH"], "symbol": ["MYB1", "SWEET4c", "MYB1H"], "go_terms": ["", "", ""]})
            runtime.set_active_annotation(annotation)
            supports = []
            for source, tf_id, rep, ident in [
                ("direct_same_tf", "TF1", "rep1", np.nan),
                ("direct_same_tf", "TF1", "rep2", np.nan),
                ("same_species_homolog", "TFH", "rep1", 72.0),
            ]:
                supports.append({
                    "source": source, "validated_tf_gene_id": tf_id, "validated_tf_symbol": "",
                    "peak_path": str(peak), "bigwig_path": str(bw), "assay": "DAP-seq",
                    "replicate": rep, "peak_count": 1, "homolog_identity": ident, "bigwig_q995": 3.0,
                })
            validation = pd.DataFrame([{
                "TF": "TF1", "target_gene_id": "TG1", "target_tf_rank": 1,
                "binding_validated": True, "direct_support_count": 2, "homolog_support_count": 1,
                "highest_homolog_identity": 72.0, "abs_shap": 2.0,
                "supporting_track_rows_json": json.dumps(supports),
            }])
            promoters = {"TG1": PromoterRecord("TG1", "tx1", "chr1", 90, 120, "+", 101, 100, 80, "rule")}
            transcripts = {"TG1": TranscriptRecord("TG1", "tx1", "chr1", "+", 80, 160, 81, 60, 81)}
            commands = []
            original = runtime.run_checked
            def fake_run(command, **kwargs):
                commands.append(list(command))
                out = Path(command[command.index("--outFileName") + 1])
                out.write_bytes(b"%PDF-1.4\n")
                class Result:
                    returncode = 0
                    stdout = ""
                    stderr = ""
                return Result()
            runtime.run_checked = fake_run
            try:
                inventory = render_tracks(validation, promoters, transcripts, {"enabled": True}, root / "tracks", annotation)
            finally:
                runtime.run_checked = original
            created = inventory[inventory["status"] == "created"]
            self.assertEqual(set(created["evidence_group"]), {"direct", "homolog"})
            self.assertTrue((created["signal_tracks"] <= 4).all())
            self.assertTrue(all("--plotWidth" in cmd and "--trackLabelFraction" in cmd for cmd in commands))
            ini_text = "\n".join(Path(x).read_text(encoding="utf-8") for x in created["ini"])
            self.assertIn("SWEET4c", ini_text)
            self.assertIn("MYB1", ini_text)
            self.assertNotIn("title = Peaks", ini_text)
            self.assertIn("labels = false", ini_text)
            self.assertTrue((root / "tracks" / "track_layout_audit.csv").is_file())

    def test_report_is_descriptive_symbol_first_and_hides_paths(self) -> None:
        from docx import Document
        from scpure_runtime import build_word_report
        with tempfile.TemporaryDirectory() as td:
            root = Path(td)
            for directory in ["00_manifest", "02_single_cell", "03_differential_expression/c1", "04_network", "05_model/c1", "06_shap/c1", "07_targets_pathways", "08_focus_tfs", "09_go_bp", "09_mapman", "10_homology", "11_binding_validation", "12_tracks", "13_cross_contrast", "14_report"]:
                (root / directory).mkdir(parents=True, exist_ok=True)
            pd.DataFrame({"gene_id": ["g1"], "symbol": ["MYB1"], "go_terms": [""]}).to_csv(root / "02_single_cell" / "gene_annotation_normalized.csv", index=False)
            pd.DataFrame({"gene_id": ["g1"], "direction": ["up"], "log2FoldChange": [2.0], "padj": [0.001], "pvalue": [0.0001], "baseMean": [20]}).to_csv(root / "03_differential_expression" / "c1" / "deseq2_full_results.csv", index=False)
            pd.DataFrame({"roles": ["single_cell.path"], "absolute_path": ["/secret/data/input.loom"], "size_bytes": [10], "sha256": ["a" * 64]}).to_csv(root / "00_manifest" / "input_hashes.csv", index=False)
            manifest = {
                "project": {"name": "smoke", "species": "Zea mays", "genome_build": "v1", "seed": 1},
                "report": {"title": "Smoke report", "preview_dpi": 120, "descriptive_only": True, "include_absolute_paths": False, "include_all_vector_figures": False},
                "contrasts": [{"id": "c1", "kind": "celltype_vs_rest", "focal_filter": "type == 'A'", "reference_filter": "type != 'A'", "focal_label": "A", "reference_label": "other"}],
                "single_cell": {"path": "/secret/data/input.loom"}, "network": {"path": "/secret/data/network.csv"},
                "annotation": {}, "genome": {}, "binding": {"enabled": False}, "de": {"backend": "pydeseq2"},
                "model": {"shap_keep_percent": 20, "per_target_tf_rank": 20}, "go": {}, "mapman": {}, "resources": {}, "homology": {}, "tracks": {},
            }
            out = root / "14_report" / "scPURE_report.docx"
            build_word_report(root, manifest, out)
            doc = Document(out)
            text = "\n".join([p.text for p in doc.paragraphs] + [cell.text for table in doc.tables for row in table.rows for cell in row.cells])
            headings = [p.text.strip().lower() for p in doc.paragraphs if p.style and p.style.name.startswith("Heading")]
            self.assertIn("MYB1", text)
            self.assertNotIn("/secret/data/", text)
            self.assertNotIn("executive summary", headings)
            self.assertNotIn("biological interpretation", headings)
            self.assertNotIn("conclusions", headings)
            policy = json.loads((root / "14_report" / "report_policy.json").read_text(encoding="utf-8"))
            self.assertTrue(policy["descriptive_only"])
            self.assertFalse(policy["conclusions_included"])
            self.assertEqual(policy["lint_violations"], [])

    def test_manifest_blocks_unreadable_report_and_track_overrides(self) -> None:
        from scpure_runtime import validate_manifest
        with tempfile.TemporaryDirectory() as td:
            root = Path(td)
            loom = root / "x.loom"; network = root / "network.csv"
            loom.write_bytes(b"x"); network.write_text("target,TF1\ng1,1\n", encoding="utf-8")
            manifest = {
                "project": {"name": "x", "output_dir": str(root / "out"), "genome_build": "v1"},
                "single_cell": {"path": str(loom), "sample_field": "sample"},
                "network": {"path": str(network)},
                "contrasts": [{"id": "c", "kind": "celltype_vs_rest", "focal_filter": "x == 1", "reference_filter": "x != 1", "focal_label": "x", "reference_label": "other"}],
                "binding": {"enabled": False},
                "tracks": {"max_signal_tracks_per_page": 12, "region_mode": "gene_span"},
                "report": {"descriptive_only": False, "include_absolute_paths": True, "include_all_vector_figures": True},
            }
            blockers = validate_manifest(manifest)
            joined = "\n".join(blockers)
            self.assertIn("max_signal_tracks_per_page", joined)
            self.assertIn("promoter_centered", joined)
            self.assertIn("descriptive_only", joined)
            self.assertIn("include_absolute_paths", joined)
            self.assertIn("include_all_vector_figures", joined)


class SingleEnvironmentContractTests(unittest.TestCase):
    def test_runtime_uses_single_environment(self) -> None:
        import scpure_runtime as runtime
        self.assertEqual(runtime.SKILL_VERSION, "0.3.1")
        source = (RUNTIME / "scpure_runtime.py").read_text(encoding="utf-8")
        self.assertNotIn("scPURE_agent" + "_r", source)
        self.assertNotIn("scPURE_agent" + "_go_legacy", source)
        self.assertIn('cfg.get("environment", "scPURE_agent")', source)

    def test_manifest_blocks_secondary_environment(self) -> None:
        from scpure_runtime import validate_manifest
        manifest = {
            "project": {"name": "x", "output_dir": "/tmp/x", "genome_build": "g"},
            "single_cell": {"path": "/tmp/x.loom", "sample_field": "sample", "r_environment": "other"},
            "network": {"path": "/tmp/network.csv"},
            "contrasts": [],
            "binding": {"enabled": False},
        }
        blockers = validate_manifest(manifest)
        self.assertTrue(any("exactly one environment" in item for item in blockers))

    def test_unified_environment_contains_python_and_r(self) -> None:
        env_text = (RUNTIME / "environment-main.yml").read_text(encoding="utf-8")
        for token in ("python=3.11.11", "r-base=4.4.3", "r-seurat=5.2.1", "bioconductor-deseq2=1.46.0"):
            self.assertIn(token, env_text)
        self.assertFalse((RUNTIME / ("environment" + "-r.yml")).exists())
        self.assertFalse((RUNTIME / ("environment" + "-go-legacy.yml")).exists())


class PureModelStageTests(unittest.TestCase):
    """v0.3.0: PURE-aligned defaults, edge-masked rankings and directional TF output."""

    def test_catboost_defaults_follow_pure(self) -> None:
        import scpure_runtime as runtime
        params = runtime.catboost_base_params({}, 2)
        self.assertEqual(params["iterations"], 1000)
        self.assertAlmostEqual(params["learning_rate"], 0.05)
        self.assertEqual(params["depth"], 6)
        self.assertEqual(params["auto_class_weights"], "Balanced")

    @unittest.skipUnless(__import__("importlib").util.find_spec("catboost") and __import__("importlib").util.find_spec("sklearn"), "catboost/scikit-learn not installed")
    def test_oof_model_outputs_directional_ranking(self) -> None:
        import scpure_runtime as runtime
        rng = np.random.default_rng(7)
        n_genes, n_tfs = 160, 12
        genes = [f"G{i:03d}" for i in range(n_genes)]
        tfs = [f"TF{j:02d}" for j in range(n_tfs)]
        y = np.array([1] * 80 + [0] * 80)
        X = (rng.random((n_genes, n_tfs)) < 0.35) * rng.random((n_genes, n_tfs))
        X[:80, 0] = rng.uniform(0.6, 1.0, 80); X[80:, 0] = 0.0          # TF00 supports focal genes
        X[80:, 1] = rng.uniform(0.6, 1.0, 80); X[:80, 1] = 0.0          # TF01 supports reference genes
        network = pd.DataFrame(X, index=genes, columns=tfs)
        with tempfile.TemporaryDirectory() as tmp:
            tmp = Path(tmp)
            labels = tmp / "labels.csv"
            pd.DataFrame({"GeneID": genes, "Label": y}).to_csv(labels, index=False)
            cfg = {"iterations": 60, "n_splits": 4, "repeats": 1, "tune": "off", "top_tfs": 5,
                   "_focal_label": "BETL", "_reference_label": "other"}
            out = runtime.fit_catboost_oof(network, labels, cfg, tmp, 11, 1)
            d = pd.read_csv(out["directional"]).set_index("TF")
            self.assertEqual(d["rank_toward_focal"].idxmin(), "TF00")
            self.assertEqual(d["rank_toward_reference"].idxmin(), "TF01")
            self.assertTrue((d["positive_shap_toward_focal"] >= 0).all() and (d["negative_shap_toward_reference"] >= 0).all())
            edge = pd.read_csv(out["edge"], index_col=0)
            self.assertTrue(((network.loc[edge.index, edge.columns].to_numpy() == 0) <= (edge.to_numpy() == 0)).all())
            summary = pd.read_csv(out["summary"]).set_index("TF")
            top = pd.read_csv(out["top"], index_col=0)
            expected = top.abs().where(top != 0).rank(axis=1, ascending=False).mean(axis=0)
            np.testing.assert_allclose(summary.loc[expected.index, "mean_abs_rank"].to_numpy(dtype=float), expected.to_numpy(dtype=float), equal_nan=True)
            pooled = json.loads((tmp / "pooled_out_of_fold_metrics.json").read_text())
            self.assertGreater(pooled["roc_auc"], 0.9)
            for pdf in ("ROC_curves.pdf", "PR_curves.pdf", "performance_metrics.pdf", "top_TFs_directional_SHAP.pdf"):
                self.assertTrue((tmp / pdf).stat().st_size > 1000, pdf)
                self.assertTrue((tmp / pdf.replace(".pdf", "_source.csv")).exists(), pdf)


if __name__ == "__main__":
    unittest.main()
~~~~
