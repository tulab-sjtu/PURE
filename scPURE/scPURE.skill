~~~~yaml
schema_version: 0.3.1
project:
  name: maize_kernel_scpure
  description: Regulatory-module discovery across maize kernel snRNA-seq contrasts.
  species: Zea mays
  genome_build: REQUIRED_EXACT_BUILD
  output_dir: /absolute/path/to/scPURE_output
  seed: 20260201

resources:
  threads: auto_half_idle       # omit/null/auto: sample current idle CPUs once and use floor(idle/2); or set a positive integer
  idle_cpu_threshold_percent: 20.0
  thread_sample_seconds: 0.5

single_cell:
  path: /absolute/path/to/maize_kernel_8_12_20DAP.loom  # or a Seurat .rds only
  sample_field: biological_sample
  raw_count_layer: null        # loom: null means the main matrix; otherwise exact layer name
  raw_count_assay: RNA         # Seurat RDS only
  gene_id_field: null          # loom only; infer when null
  cell_id_field: null          # loom only; infer when null

contrasts:
  - id: BETL_vs_other_kernel_cells
    kind: celltype_vs_rest
    subset: DAP in ['8DAP','12DAP','20DAP']
    focal_filter: cell_type == 'BETL'
    reference_filter: cell_type != 'BETL'  # "all cells" always means all OTHER cells
    focal_label: BETL
    reference_label: other_kernel_cells
    batch_fields: []
  - id: BETL_12DAP_vs_8DAP
    kind: within_celltype_group
    subset: cell_type == 'BETL'
    focal_filter: DAP == '12DAP'
    reference_filter: DAP == '8DAP'
    focal_label: 12DAP
    reference_label: 8DAP
    batch_fields: [batch]       # remove only after proving no valid non-confounded batch factor exists

de:
  backend: pydeseq2             # pydeseq2 or r_deseq2
  min_cells_per_sample_arm: 20
  repeated_subsamples: 10       # mandatory balancing; must be >=1
  lfc_threshold: 1.0
  qvalue_threshold: 0.05

network:
  path: /absolute/path/to/pyscenic_regulons.csv
  tf_column: null
  target_column: null
  weight_column: null
  duplicate_edge_rule: max_abs
  input_h5_key: /regulons
  output_h5_key: /regulons

model:
  n_splits: 5
  repeats: 1
  iterations: 1000
  learning_rate: 0.05
  depth: 6
  l2_leaf_reg: 3.0
  tune: auto
  optuna_trials: 30
  shap_keep_percent: 20
  top_tfs: 20
  per_target_tf_rank: 20

focus:
  target_or_pathway_file: /absolute/path/to/pathways.csv
  target_column: gene_id
  pathway_column: pathway
  target_genes: []
  tfs: [MYBR29, MYBR19]
  expression_table: null
  max_plot_targets: 25
  max_network_edges: 40

annotation:
  path: /absolute/path/to/gene_symbol_go.tsv
  gene_id_column: gene_id
  symbol_column: symbol
  go_column: go_terms
  go_separator: ';'

go:
  backend: auto                 # auto, local_ora_wang, or pyclusterprofiler_supplement
  environment: scPURE_agent     # fixed; no second environment is permitted
  taxid: 4577
  id_type: species_gene_id      # use ncbi_gene_id only when IDs truly are NCBI Gene IDs
  obo_path: /absolute/path/to/go-basic.obo
  qvalue_threshold: 0.05
  min_term_size: 5
  max_term_size: 500
  min_overlap: 3
  wang_similarity_threshold: 0.70
  wang_is_a_weight: 0.80
  wang_part_of_weight: 0.60

mapman:
  enabled: auto                 # auto runs when path is supplied; true requires path; false skips MapMan
  path: null                    # optional: /absolute/path/to/maize.mapman.txt
  bincode_column: BINCODE
  name_column: NAME
  gene_id_column: IDENTIFIER
  description_column: DESCRIPTION
  type_column: TYPE
  gene_type_value: T
  enrichment_level: 3           # default: first three dot-separated BINCODE components
  qvalue_threshold: 0.05
  min_bin_size: 5
  max_bin_size: 5000
  min_overlap: 3

genome:
  protein_fasta: /absolute/path/to/all_proteins.fa
  gff: /absolute/path/to/genome.gff3

homology:
  scope: within_species_only
  minimum_identity_percent: 60.0
  minimum_query_coverage: 0.60
  minimum_subject_coverage: 0.60
  max_homologs_per_query: 20
  fasta_gene_id_regex: null

binding:
  enabled: true
  peak_manifest: /absolute/path/to/tf_peak_bigwig_manifest.tsv
  promoter_upstream_bp: 2000
  promoter_downstream_bp: 500
  transcript_rule: longest_exon_length_then_CDS_then_span
  require_matching_genome_build: true

tracks:
  enabled: true
  region_mode: promoter_centered       # fixed readable mode
  region_upstream_bp: 5000
  region_downstream_bp: 3000
  max_region_bp: 50000
  max_signal_tracks_per_page: 4        # allowed range: 1-6
  max_pairs_per_contrast: 100
  direct_tf_first: true
  keep_replicates_separate: true
  include_homolog_tracks: true
  homolog_sort: identity_descending
  dpi: 300
  width_cm: 32
  plot_width_cm: 23
  track_label_fraction: 0.24
  base_height_cm: 4.5
  signal_height_cm: 1.7
  peak_height_cm: 0.45
  spacer_height_cm: 0.25
  font_size: 9
  max_track_title_chars: 30

report:
  title: scPURE Analysis Output Report
  language: English
  preview_dpi: 220
  descriptive_only: true               # fixed; cannot be disabled
  include_absolute_paths: false        # fixed; cannot be enabled
  max_table_rows: 10
  max_table_columns: 8
  max_summary_figures: 24
  max_track_figures_per_contrast: 6
  max_total_track_figures: 12
  include_all_vector_figures: false    # fixed; full PDFs remain in output folders
